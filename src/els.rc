/* els.rc -- PE resources for the native els.exe: application icon, manifest
 * (DPI / common-controls v6 / UTF-8 / long-path), and version info. Compiled by
 * windres and linked into the bare exe BEFORE the zipfs payload is appended.
 *
 * Keep FILEVERSION / "FileVersion" in sync with `variable version` in els.tcl.
 */

#include <windows.h>

/* Application icon (resource name "els" so Explorer shows the awl, not Tk's
 * feather). Generated from resources/icon.png by tools/mkico.tcl at build time. */
els ICON "els.ico"

/* Application manifest: CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24). */
1 24 "els.exe.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    0,30,0,0
  PRODUCTVERSION 0,30,0,0
  FILEFLAGSMASK  0x3fL
  FILEFLAGS      0x0L
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "anafalanx"
            VALUE "FileDescription",  "els"
            VALUE "FileVersion",      "0.30"
            VALUE "InternalName",     "els"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Vincent Vercauteren. MIT licensed."
            VALUE "OriginalFilename", "els.exe"
            VALUE "ProductName",      "els"
            VALUE "ProductVersion",   "0.30"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
