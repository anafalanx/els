# els builds against zmal's shared runtime (<zmal>/r); it has no project-local
# toolchain.  Ignore any locally-hydrated .toolchain (and moved-aside variants)
# so the multi-hundred-MB payload can never be committed by accident.
/.toolchain/
/.toolchain.*/

# Agent-local client config and Drenn's local memory store stay out of the repo.
# (The project's MCP server declaration in .mcp.json IS tracked; these are the
# per-developer client settings and the LMDB memory database behind them.)
/.claude/
/.codex/
/.drenn/

# scratch / test artifacts
*-selftest.txt
*-result.txt
*-shot.png
/smoke.tcl
/tests/_tmp/

# large generated sample files for manual testing (regenerate via tools/gen_sample.tcl)
/samples/

# BUILD LAYOUT (the convention, enforced by tools/tasks.tcl):
#   dist/els.exe  = THE final artifact: what you run, what gets released
#   build/        = compiler intermediates only (objects, .res, els-bare.exe,
#                   generated els.rc/manifest/ico, dev-built extension DLLs)
#   repo root     = no binaries
/build/
/dist/

# belt-and-suspenders: a root els.exe (pre-0.60 build layout, or an explicit
# `z build els.exe`) must never be committed either
/els.exe

# a "portable" config chosen during a dev run lands next to els.tcl (the repo
# root here); real builds write it next to els.exe instead
/els.conf
/config.tcl

# OS / editor cruft
*~
Thumbs.db
desktop.ini
