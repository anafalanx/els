# vendored toolchain: MSYS2 + Tcl/Tk 9 build/install + AutoIt — huge, machine-specific.
# Reproduced from source via scripts/ (the build recipe), not committed.
/.toolchain/

# Claude local settings
/.claude/

# scratch / test artifacts
*-selftest.txt
*-result.txt
*-shot.png
/smoke.tcl
/tests/_tmp/
# large generated sample files for manual testing (regenerate via tools/gen_sample.tcl)
/samples/

# compiled C extensions / build output (rebuilt via `x build-ext` / `x build`).
# The native build's generated PE resource inputs (els.rc, els.exe.manifest,
# els.ico — emitted from Tcl by tools/genres.tcl + tools/mkico.tcl) land here too.
/build/

# the fused single-file exe (rebuilt via `x build`; ship via releases)
/els.exe

# release staging dir: `x build` writes dist/els.exe here so a running els.exe
# is never disturbed; holds the exe + scratch shots, none of it committed
/dist/

# a "portable" config chosen during a dev run lands next to els.tcl (the repo
# root here); real builds write it next to els.exe instead
/els.conf
/config.tcl

# OS / editor cruft
*~
Thumbs.db
desktop.ini
