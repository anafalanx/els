# tests/els.test — behaviour tests for els, driven in-process against the real
# Tk widgets.  Run via `tests/run.tcl` (or directly with tclsh90).

source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::test

# ---- startup ------------------------------------------------------------
test start-1.1 {fresh els has exactly one untitled document} -setup {els_reset} -body {
    list [llength $::els::docs] [els::doc_name [lindex $::els::docs 0]] $::els::active
} -result {1 untitled d0}

# ---- tabs ---------------------------------------------------------------
test tab-1.1 {new_doc adds a tab and makes it active} -setup {els_reset} -body {
    set id [els::new_doc]
    list [llength $::els::docs] [expr {$::els::active eq $id}] [winfo exists [els::tabW $id]]
} -result {2 1 1}

test tab-1.2 {cycle steps through documents in order and wraps} -setup {els_reset} -body {
    els::new_doc ; els::new_doc   ;# d0 d1 d2, active d2
    set seen {}
    els::cycle 1  ; lappend seen $::els::active   ;# wrap -> d0
    els::cycle 1  ; lappend seen $::els::active   ;# d1
    els::cycle -1 ; lappend seen $::els::active   ;# d0
    set seen
} -result {d0 d1 d0}

test tab-1.3 {active tab shows the page colour, inactive shows grey} -setup {els_reset} -body {
    set a [lindex $::els::docs 0]
    set b [els::new_doc]   ;# active b
    list [[els::tabW $b].name cget -bg] [[els::tabW $a].name cget -bg]
} -result [list $::els::TABON $::els::TABOFF]

# ---- closing ------------------------------------------------------------
test close-1.1 {closing the active document switches to a neighbour} -setup {els_reset} -body {
    set b [els::new_doc]
    els::close_doc $b
    list [llength $::els::docs] $::els::active
} -result {1 d0}

test close-1.2 {closing the last document leaves a fresh untitled one} -setup {els_reset} -body {
    els::close_doc [lindex $::els::docs 0]
    list [llength $::els::docs] [els::pristine $::els::active]
} -result {1 1}

test close-1.3 {closing a non-active document leaves the active one untouched} -setup {els_reset} -body {
    set a [lindex $::els::docs 0]
    set b [els::new_doc]   ;# active b
    els::close_doc $a      ;# close the inactive one
    list [llength $::els::docs] $::els::active
} -result {1 d1}

# ---- open ---------------------------------------------------------------
test open-1.1 {open reuses a pristine untitled tab} -setup {els_reset} -body {
    set f [els_tmpfile open1.txt "alpha\nbeta\n"]
    set before [llength $::els::docs]
    els::open $f
    list $before [llength $::els::docs] [els::doc_name $::els::active] [[els::T] get 1.0 1.end]
} -result {1 1 open1.txt alpha}

test open-1.2 {open uses a new tab when the current document is not pristine} -setup {els_reset} -body {
    [els::T] insert end "dirty"
    set f [els_tmpfile open2.txt "zzz\n"]
    els::open $f
    list [llength $::els::docs] [els::doc_name $::els::active]
} -result {2 open2.txt}

test open-1.3 {open multiple files, one document each} -setup {els_reset} -body {
    set f1 [els_tmpfile multi1.txt "111\n"]
    set f2 [els_tmpfile multi2.txt "222\n"]
    els::open $f1
    els::open $f2
    list [llength $::els::docs] \
        [els::doc_name [lindex $::els::docs 0]] [els::doc_name [lindex $::els::docs 1]]
} -result {2 multi1.txt multi2.txt}

# ---- save ---------------------------------------------------------------
test save-1.1 {save writes the buffer and clears the dirty flag} -setup {els_reset} -body {
    set f [file join $::ELS_TMP saveme.txt]
    [els::T] insert end "save this"
    set ::els::docPath($::els::active) $f
    els::save
    set fh [::open $f r]; fconfigure $fh -encoding utf-8; set c [read $fh]; close $fh
    list [els::doc_dirty $::els::active] $c
} -result {0 {save this}}

# ---- dirty tracking -----------------------------------------------------
test dirty-1.1 {an edit marks the document dirty and bullets the tab} -setup {els_reset} -body {
    set clean [els::doc_dirty $::els::active]
    [els::T] insert end "x"
    list $clean [els::doc_dirty $::els::active] [els::tab_text $::els::active]
} -result {0 1 {• untitled 1}}

# ---- user-issues batch A ---------------------------------------------------

test issue-a.8 {new documents default to the platform EOL (CRLF on Windows)} -setup {els_reset} -body {
    set id [els::new_doc]
    set eol $::els::docEol($id)
    [els::W $id] insert end "one\ntwo"
    set ::els_test_savefile [file join $::ELS_TMP ia8.txt]
    els::switch_to $id ; els::save
    list $eol [string match "*one\r\ntwo*" [raw_read [file join $::ELS_TMP ia8.txt]]]
} -result {crlf 1}

test issue-a.9 {files opened from disk keep their detected EOL (no CRLF takeover)} -setup {els_reset} -body {
    set p [file join $::ELS_TMP ia9.txt] ; raw_write $p "a\nb\n"
    els::open $p
    [els::T] insert end "c"
    els::save
    list $::els::docEol($::els::active) [raw_read $p]
} -result [list lf "a\nb\nc"]

# ---- bug-hunt wave 4: numeric-looking names + failed-open behavior --------

test name-4.1 {numeric-looking file names are not canonicalized (007 stays 007, nan does not throw)} -setup {els_reset} -body {
    set d [els::new_doc]
    set ::els::docPath($d) [file join $::ELS_TMP 007]
    set a [els::doc_name $d]
    set ::els::docPath($d) [file join $::ELS_TMP nan]
    set b [els::doc_name $d]
    list $a $b
} -result {007 nan}

test name-4.2 {a doc named nan survives the full edit/update path (no bgerror storm)} -setup {els_reset} -body {
    set d [els::new_doc]
    set ::els::docPath($d) [file join $::ELS_TMP nan]
    [els::W $d] insert end "x"      ;# fires on_modified -> update_tab -> doc_name
    update
    list [els::tab_text $d] [llength $::els_test_bgerrors]
} -result {{• nan} 0}

test openfail-4.1 {a failed open keeps a pre-existing pristine tab} -setup {els_reset} -body {
    els::open [els_tmpfile of1.txt "data\n"]
    set d1 [els::new_doc]                        ;# the user's fresh empty tab
    set before $::els::docs
    els::open [file join $::ELS_TMP no_such_dir_xyz missing.txt] 1
    list [expr {$::els::docs eq $before}] [expr {$::els::active eq $d1}]
} -result {1 1}

test openfail-4.2 {a failed open closes only the doc it created and restores focus} -setup {els_reset} -body {
    els::open [els_tmpfile of2a.txt "A\n"] ; set da $::els::active
    els::open [els_tmpfile of2b.txt "B\n"]
    els::switch_to $da
    set before $::els::docs
    els::open [file join $::ELS_TMP no_such_dir_xyz missing.txt] 1
    list [expr {$::els::docs eq $before}] [expr {$::els::active eq $da}]
} -result {1 1}

# ---- per-document undo independence -------------------------------------
test undo-1.1 {undo in one document does not affect another} -setup {els_reset} -body {
    set d0 $::els::active
    [els::W $d0] insert end "AAA"
    set d1 [els::new_doc]
    [els::W $d1] insert end "BBB"
    [els::W $d1] edit undo
    list [els_text $d0] [els_text $d1]
} -result {AAA {}}

# ---- current-line + gutter ----------------------------------------------
test view-1.1 {current-line tag follows the cursor} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "one\ntwo\nthree\n"
    $w mark set insert 2.0
    els::refresh_view
    $w tag ranges currentLine
} -result {2.0 3.0}

test view-1.2 {gutter line count tracks the buffer} -setup {els_reset} -body {
    [els::T] insert end "a\nb\nc\n"
    els::refresh_view
    els::line_count
} -result 4

# ---- key bindings (driven through Tk's real event path) -----------------
test bind-1.1 {Ctrl+N opens a new tab} -setup {els_reset} -body {
    set before [llength $::els::docs]
    event generate [els::T] <Control-n>
    update
    expr {[llength $::els::docs] - $before}
} -result 1

test bind-1.2 {Ctrl+W closes the current (clean) tab} -setup {els_reset} -body {
    els::new_doc
    update   ;# realize the new widget before targeting it with a synthetic event
    set before [llength $::els::docs]
    event generate [els::T] <Control-w>
    update
    expr {$before - [llength $::els::docs]}
} -result 1

# ---- unicode round-trip -------------------------------------------------
test unicode-1.1 {utf-8 content survives an open} -setup {els_reset} -body {
    set f [els_tmpfile uni.txt "café ☕ 日本\n"]
    els::open $f
    [els::T] get 1.0 1.end
} -result {café ☕ 日本}

# ---- closing a DIRTY document (the yes/no/cancel prompt) -----------------
# close_doc prompts yesnocancel when the doc is dirty: cancel aborts, yes
# saves-then-closes, no discards-then-closes, and "yes" whose Save As is
# cancelled leaves the doc open and dirty.
test close-2.1 {closing a dirty doc, answering yes, saves it then closes} -setup {els_reset} -body {
    set f [file join $::ELS_TMP closeyes.txt]
    set d $::els::active
    [els::W $d] insert end "keep me"
    set ::els::docPath($d) $f
    set ::els_test_mbanswer yes
    els::close_doc $d
    set fh [::open $f r]; fconfigure $fh -encoding utf-8; set c [read $fh]; close $fh
    list [lsearch -exact $::els::docs $d] [string trim $c]
} -result {-1 {keep me}}

test close-2.2 {closing a dirty doc, answering no, discards and closes} -setup {els_reset} -body {
    set f [file join $::ELS_TMP closeno.txt]
    set d $::els::active
    [els::W $d] insert end "discard me"
    set ::els::docPath($d) $f
    set ::els_test_mbanswer no
    els::close_doc $d
    list [lsearch -exact $::els::docs $d] [file exists $f]
} -result {-1 0}

test close-2.3 {closing a dirty doc, answering cancel, keeps it open and dirty} -setup {els_reset} -body {
    set d $::els::active
    [els::W $d] insert end "unsaved"
    set ::els_test_mbanswer cancel
    els::close_doc $d
    list [expr {[lsearch -exact $::els::docs $d] >= 0}] [els::doc_dirty $d]
} -result {1 1}

test close-2.4 {dirty untitled, yes, but Save As cancelled -> stays open and dirty} -setup {els_reset} -body {
    set d $::els::active
    [els::W $d] insert end "no path yet"
    set ::els_test_mbanswer yes
    set ::els_test_savefile ""    ;# Save As dialog cancelled
    els::close_doc $d
    list [expr {[lsearch -exact $::els::docs $d] >= 0}] [els::doc_dirty $d]
} -result {1 1}

# ---- quit ----------------------------------------------------------------
# quit loops dirty docs (same prompt); a cancel aborts BEFORE save_geometry +
# exit, so it is safe to drive directly.  The paths that proceed end in `exit`,
# so those tests stub exit (restored in -cleanup) and assert it was reached.
test quit-1.1 {quit with a dirty doc, answering cancel, aborts and keeps everything} -setup {els_reset} -body {
    set d $::els::active
    [els::W $d] insert end "unsaved work"
    set ::els_test_mbanswer cancel
    els::quit
    list [expr {[lsearch -exact $::els::docs $d] >= 0}] [els::doc_dirty $d]
} -result {1 1}

test quit-1.2 {quit with clean docs saves geometry and exits} -setup {
    els_reset
    rename ::exit ::els_test_real_exit
    set ::els_test_exited 0
    proc ::exit {args} { set ::els_test_exited 1 }
} -body {
    els::quit
    set ::els_test_exited
} -cleanup {
    rename ::exit {} ; rename ::els_test_real_exit ::exit
} -result 1

test quit-1.3 {quit, dirty doc answered no, discards and still exits} -setup {
    els_reset
    rename ::exit ::els_test_real_exit
    set ::els_test_exited 0
    proc ::exit {args} { set ::els_test_exited 1 }
    set ::els_test_mbanswer no
} -body {
    [els::W $::els::active] insert end "discard on quit"
    els::quit
    set ::els_test_exited
} -cleanup {
    rename ::exit {} ; rename ::els_test_real_exit ::exit
} -result 1

# ---- Save As / save-with-encoding ---------------------------------------
test saveas-1.1 {Save As writes a new file, sets the path, clears dirty, records recent} -setup {els_reset} -body {
    set f [file join $::ELS_TMP saveas_new.txt]
    set d $::els::active
    [els::W $d] insert end "brand new"
    set ::els_test_savefile $f
    els::saveas
    set fh [::open $f r]; fconfigure $fh -encoding utf-8; set c [read $fh]; close $fh
    list [els::same_path $::els::docPath($d) $f] [els::doc_dirty $d] [string trim $c] \
         [els::same_path [lindex $::els::recent 0] $f]
} -result {1 0 {brand new} 1}

test saveas-1.2 {Save As cancelled writes nothing, leaves the doc untitled and dirty} -setup {els_reset} -body {
    set d $::els::active
    [els::W $d] insert end "still unsaved"
    set ::els_test_savefile ""
    els::saveas
    list $::els::docPath($d) [els::doc_dirty $d]
} -result {{} 1}

test saveas-1.3 {Save As write failure keeps the old path and does not add a recent} -setup {els_reset} -body {
    set old [els_tmpfile saveas_old.txt "old\n"]
    set d [els::open $old]
    set beforeRecent $::els::recent
    [els::W $d] insert end "edited"
    set bad [file join $::ELS_TMP missing_dir saveas_failed.txt]
    catch {file delete -force [file dirname $bad]}
    set ::els_test_savefile $bad
    set ok [els::saveas]
    list $ok [els::same_path $::els::docPath($d) $old] \
         [els::doc_dirty $d] [expr {$::els::recent eq $beforeRecent}] \
         [file exists $bad]
} -result {0 1 1 1 0}

test saveas-1.4 {Save As keeps the invoking document when nested dialog events switch tabs} -setup {
    els_reset
    rename ::tk_getSaveFile ::_els_real_getsave
} -cleanup {
    catch {rename ::tk_getSaveFile {}}
    if {[llength [info commands ::_els_real_getsave]]} { rename ::_els_real_getsave ::tk_getSaveFile }
} -body {
    set a $::els::active
    [els::W $a] insert end "CONTENT FROM A"
    set b [els::new_doc]
    [els::W $b] insert end "CONTENT FROM B"
    set target [file join $::ELS_TMP saveas_nested.txt]
    set ::_els_nested_b $b
    set ::_els_nested_target $target
    proc ::tk_getSaveFile {args} {
        set ::_els_nested_suspended $::els::swap_suspend
        els::switch_to $::_els_nested_b
        return $::_els_nested_target
    }
    els::switch_to $a
    set rc [els::saveas]
    list $rc [raw_read $target] \
         [els::same_path $::els::docPath($a) $target] [els::doc_dirty $a] \
         $::els::docPath($b) [els::doc_dirty $b] [els_text $b] $::_els_nested_suspended
} -result {1 {CONTENT FROM A} 1 0 {} 1 {CONTENT FROM B} 1}

test modal-1.1 {native message boxes suspend background work and restore prior state} -setup {
    els_reset
    rename ::tk_messageBox ::_els_modal_real_message_box
    set ::_els_modal_seen {}
    set ::_els_modal_throw 0
    proc ::tk_messageBox {args} {
        lappend ::_els_modal_seen $::els::swap_suspend
        if {$::_els_modal_throw} { error "injected message-box failure" }
        return yes
    }
} -cleanup {
    catch {rename ::tk_messageBox {}}
    if {[llength [info commands ::_els_modal_real_message_box]]} {
        rename ::_els_modal_real_message_box ::tk_messageBox
    }
    unset -nocomplain ::_els_modal_seen ::_els_modal_throw
    set ::els::swap_suspend_tokens {}
    set ::els::swap_suspend 0
} -body {
    set ::els::swap_suspend 0
    set answer [els::message_box -parent . -message test]
    set restored0 $::els::swap_suspend
    set ::els::swap_suspend 1
    set ::_els_modal_throw 1
    set code [catch {els::message_box -parent . -message test} err]
    list $answer $restored0 $code $err $::els::swap_suspend $::_els_modal_seen \
        [dict size $::els::swap_suspend_tokens]
} -result {yes 0 1 {injected message-box failure} 1 {1 1} 0}

test modal-1.2 {overlapping background guards remain suspended until the last guard leaves} \
        -setup {els_reset} -body {
    set outer [els::suspend_acquire]
    set inner [els::suspend_acquire]
    els::suspend_release $outer
    set between $::els::swap_suspend
    els::suspend_release $inner
    set after $::els::swap_suspend
    set ::els::swap_suspend 1
    set nested [els::suspend_acquire]
    els::suspend_release $nested
    list $between $after $::els::swap_suspend [dict size $::els::swap_suspend_tokens]
} -cleanup {
    set ::els::swap_suspend_tokens {}
    set ::els::swap_suspend 0
} -result {1 0 1 0}

test modal-1.3 {the native Open picker suspends callbacks and restores on cancel or error} \
        -setup {
    els_reset
    rename ::tk_getOpenFile ::_els_modal_real_getopen
    set ::_els_open_modal_seen {}
    set ::_els_open_modal_throw 0
    proc ::tk_getOpenFile {args} {
        lappend ::_els_open_modal_seen $::els::swap_suspend
        if {$::_els_open_modal_throw} { error "injected open-picker failure" }
        return ""
    }
} -cleanup {
    catch {rename ::tk_getOpenFile {}}
    if {[llength [info commands ::_els_modal_real_getopen]]} {
        rename ::_els_modal_real_getopen ::tk_getOpenFile
    }
    unset -nocomplain ::_els_open_modal_seen ::_els_open_modal_throw
    set ::els::swap_suspend_tokens {}
    set ::els::swap_suspend 0
} -body {
    set cancelled [els::open]
    set restored0 $::els::swap_suspend
    set ::els::swap_suspend 1
    set ::_els_open_modal_throw 1
    set code [catch {els::open} err]
    list $cancelled $restored0 $code $err $::els::swap_suspend $::_els_open_modal_seen \
        [dict size $::els::swap_suspend_tokens]
} -result {{} 0 1 {injected open-picker failure} 1 {1 1} 0}

test saveas-1.5 {failed Save As restores format and lossy-consent metadata} -setup {els_reset} -body {
    set old [els_tmpfile saveas_meta_old.txt "plain\n"]
    els::open $old ; set id $::els::active
    set ::els::docEnc($id) ascii
    [els::W $id] insert end "caf\u00E9"
    set ::els::docDecodeLossy($id) 1
    set ::els::docFormatPending($id) 1
    set ::els::docLossyPause($id) 1
    set ::els::docExtModPause($id) 1
    set fields {docEnc docBom docEol docRaw savedSig savedSigPath docExtModPause \
                docDecodeLossy docLossyOk docLossyPause docFormatPending}
    set before [lmap name $fields {
        set slot "::els::${name}($id)"
        if {[info exists $slot]} { list 1 [set $slot] } else { list 0 "" }
    }]
    set bad [file join $::ELS_TMP saveas-meta-missing out.txt]
    catch {file delete -force [file dirname $bad]}
    set ::els_test_savefile $bad
    set ::els_test_mbanswer yes
    set ::els_test_lossy_answer utf8
    set utf8rc [els::saveas]
    set afterUtf8 [lmap name $fields {
        set slot "::els::${name}($id)"
        if {[info exists $slot]} { list 1 [set $slot] } else { list 0 "" }
    }]
    set ::els_test_lossy_answer lossy
    set lossyrc [els::saveas]
    set afterLossy [lmap name $fields {
        set slot "::els::${name}($id)"
        if {[info exists $slot]} { list 1 [set $slot] } else { list 0 "" }
    }]
    list $utf8rc $lossyrc [expr {$before eq $afterUtf8}] [expr {$before eq $afterLossy}] \
         [els::same_path $::els::docPath($id) $old] [llength $::els_test_lossy_calls]
} -result {0 0 1 1 1 2}

test saveas-1.6 {a throwing save restores the complete Save As snapshot before rethrowing} -setup {
    els_reset
    rename ::els::save ::els::_saveas_real_save
} -cleanup {
    catch {rename ::els::save {}}
    if {[llength [info commands ::els::_saveas_real_save]]} {
        rename ::els::_saveas_real_save ::els::save
    }
} -body {
    set old [els_tmpfile saveas_throw_old.txt "old\n"]
    els::open $old ; set id $::els::active
    [els::W $id] insert end "dirty"
    set ::els::docLossyPause($id) 1
    set fields {docEnc docBom docEol docRaw savedSig savedSigPath \
                docExtModPause docDecodeLossy docLossyOk docLossyPause \
                docFormatPending}
    set before [lmap name $fields {
        set slot "::els::${name}($id)"
        if {[info exists $slot]} { list 1 [set $slot] } else { list 0 "" }
    }]
    set recentBefore $::els::recent
    set target [file join $::ELS_TMP saveas_throw_new.txt]
    set ::els_test_savefile $target
    proc ::els::save {id args} {
        foreach name {docEnc docBom docEol docRaw savedSig savedSigPath \
                      docExtModPause docDecodeLossy docLossyOk docLossyPause \
                      docFormatPending} {
            set ::els::${name}($id) CORRUPTED
        }
        [els::W $id] edit modified 0
        error "injected throwing save"
    }
    set code [catch {els::saveas} err]
    set after [lmap name $fields {
        set slot "::els::${name}($id)"
        if {[info exists $slot]} { list 1 [set $slot] } else { list 0 "" }
    }]
    list $code $err [els::same_path $::els::docPath($id) $old] \
         [expr {$before eq $after}] [els::doc_dirty $id] \
         [expr {$::els::recent eq $recentBefore}] $::els::swap_suspend \
         [file exists $target]
} -result {1 {injected throwing save} 1 1 1 1 0 0}

# save_with only changes the encoding + marks dirty; the next save writes the
# bytes.  Pick UTF-16LE+BOM on a utf-8 doc, then save, and check the file bytes.
test save-2.1 {save_with a new encoding, then save, writes that encoding's bytes} -setup {els_reset} -body {
    set f [file join $::ELS_TMP savewith.txt]
    set d $::els::active
    [els::W $d] insert end "hello"
    set ::els::docPath($d) $f
    els::save                      ;# first write as the default utf-8
    els::save_with utf-16le 1      ;# choose UTF-16LE + BOM -> marks dirty only
    set dirtyAfterPick [els::doc_dirty $d]
    els::save                      ;# now the bytes get rewritten in the new encoding
    set fh [::open $f rb]; set raw [read $fh]; close $fh
    binary scan $raw H4 bomhex
    set body [encoding convertfrom utf-16le [string range $raw 2 end]]
    list $dirtyAfterPick $bomhex $body [els::doc_dirty $d]
} -result {1 fffe hello 0}

# ---- auto-save (opt-in) ------------------------------------------------------

# Scaffold: a saved file whose buffer then gains an edit, with auto-save on.
proc as_doc {name} {
    set p [els_tmpfile $name "base\n"]
    set id [els::open $p]
    set ::els::autosave 1
    [els::W $id] insert end "edit"
    return $id
}

test as-1.1 {auto-save is OFF by default and lives in the File menu} -setup {els_reset} -body {
    set found 0
    for {set i 0} {$i <= [.menu.file index end]} {incr i} {
        if {[.menu.file type $i] eq "checkbutton" &&
            [.menu.file entrycget $i -label] eq "Auto-save"} { set found 1 }
    }
    list $::els::autosave $found
} -result {0 1}

test as-1.2 {an edit schedules a debounced flush that saves the file} -setup {els_reset} -body {
    set id [as_doc as12.txt]
    [els::W $id] edit modified 1 ; update      ;# fire <<Modified>> -> autosave_soon
    set scheduled [expr {$::els::autosave_after ne ""}]
    els::autosave_flush_pending                 ;# what the timer runs
    list $scheduled [els::doc_dirty $id] [raw_read $::els::docPath($id)]
} -result [list 1 0 "base\nedit"]

test as-1.3 {untitled documents are never auto-saved (no dialog, no file)} -setup {els_reset} -body {
    set id [els::new_doc]
    set ::els::autosave 1
    [els::W $id] insert end "note"
    els::autosave_flush_doc $id
    list [els::doc_dirty $id] $::els_test_save_args
} -result {1 {}}

test as-1.4 {switching tabs flushes the document being left} -setup {els_reset} -body {
    set id [as_doc as14.txt]
    set other [els::new_doc]
    els::switch_to $other
    list [els::doc_dirty $id] [raw_read $::els::docPath($id)]
} -result [list 0 "base\nedit"]

test as-1.5 {losing the app window focus flushes everything} -setup {els_reset} -body {
    set id [as_doc as15.txt]
    event generate . <Deactivate>
    update
    list [els::doc_dirty $id] [raw_read $::els::docPath($id)]
} -result [list 0 "base\nedit"]

test as-1.6 {closing a pathed doc with auto-save on saves it without a prompt} -setup {els_reset} -body {
    set id [as_doc as16.txt]
    set p $::els::docPath($id)
    els::close_doc $id
    list $::els_test_mbcount [expr {$id in $::els::docs}] [raw_read $p]
} -result [list 0 0 "base\nedit"]

test as-1.7 {a failing auto-save stays quiet: statusbar note, no dialog, still dirty} -setup {els_reset} -body {
    set id [as_doc as17.txt]
    # an unopenable target: the parent directory does not exist
    set ::els::docPath($id) [file join $::ELS_TMP no-such-dir as17.txt]
    els::autosave_flush_doc $id
    list $::els_test_mbcount [els::doc_dirty $id] \
        [string match "auto-save failed:*" [.sb.name cget -text]]
} -result {0 1 1}

test as-1.8 {an unencodable char pauses auto-save until a manual save settles it} -setup {els_reset} -body {
    set id [as_doc as18.txt]
    set ::els::docEnc($id) ascii
    [els::W $id] insert end "é"
    els::autosave_flush_doc $id
    set paused [info exists ::els::docLossyPause($id)]
    set untouched [raw_read $::els::docPath($id)]
    els::autosave_flush_doc $id                 ;# paused: silently skipped
    set ::els_test_lossy_answer utf8
    set ok [els::save]                          ;# the manual save settles it
    els::autosave_flush_doc $id
    list $paused $untouched $ok [info exists ::els::docLossyPause($id)] [els::doc_dirty $id]
} -result [list 1 "base\n" 1 0 0]

test as-1.9 {the auto-save choice persists through the config round-trip} -setup {els_reset} -body {
    set ::els::autosave 1
    els::save_geometry
    set ::els::autosave 0
    els::load_geometry
    set v $::els::autosave
    catch {file delete -force $::els::config_path}
    set v
} -result 1

test as-1.10 {turning auto-save ON saves dirty pathed documents immediately} -setup {els_reset} -body {
    set p [els_tmpfile as110.txt "base\n"]
    set id [els::open $p]
    [els::W $id] insert end "now"
    set ::els::autosave 1                       ;# what the menu checkbutton does...
    els::set_autosave 0                         ;# ...then its -command (no persist)
    list [els::doc_dirty $id] [raw_read $p]
} -result [list 0 "base\nnow"]

test as-1.11 {auto-save defers writes for the full lifetime of a modal guard} \
        -setup {els_reset} -body {
    set id [as_doc as111.txt]
    set p $::els::docPath($id)
    set ::els::swap_suspend 1
    els::autosave_all
    set guarded [list [els::doc_dirty $id] [raw_read $p] \
        [dict exists $::els::autosave_pending $id] \
        [expr {$::els::autosave_after ne ""}]]
    catch {after cancel $::els::autosave_after}
    set ::els::autosave_after ""
    els::autosave_flush_pending
    set stillGuarded [list [els::doc_dirty $id] [raw_read $p] \
        [dict exists $::els::autosave_pending $id] \
        [expr {$::els::autosave_after ne ""}]]
    set ::els::swap_suspend 0
    catch {after cancel $::els::autosave_after}
    set ::els::autosave_after ""
    els::autosave_flush_pending
    list $guarded $stillGuarded [els::doc_dirty $id] [raw_read $p] \
        [dict exists $::els::autosave_pending $id]
} -cleanup {
    catch {after cancel $::els::autosave_after}
    set ::els::autosave_after ""
    set ::els::autosave_pending {}
    set ::els::swap_suspend 0
} -result [list [list 1 "base\n" 1 1] [list 1 "base\n" 1 1] \
    0 "base\nedit" 0]

# ---- backups: previous versions ---------------------------------------------

proc bk_dir {} { return [file join [file dirname $::els::config_path] backups] }
proc bk_ring {p} { lsort [glob -nocomplain -directory [bk_dir] "[els::backup_stem $p].*.bak"] }

test bk-1.1 {an overwriting save preserves the previous version} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0
    set p [els_tmpfile bk11.txt "version one\n"]
    set id [els::open $p]
    [els::W $id] insert end "and two"
    els::save
    set ring [bk_ring $p]
    list [llength $ring] [raw_read [lindex $ring 0]] [string match "*and two*" [raw_read $p]]
} -result [list 1 "version one\n" 1]

test bk-1.2 {the first save of a new file makes no backup (nothing to preserve)} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0
    set id [els::new_doc]
    [els::W $id] insert end "fresh"
    set p [file join $::ELS_TMP bk12.txt]
    catch {file delete -force $p}      ;# truly new: not left over from a prior run
    set ::els_test_savefile $p
    els::save
    list [file exists $p] [llength [bk_ring $p]]
} -result {1 0}

test bk-1.3 {the ring keeps only the newest BK_RING versions} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0 ; set ::els::BK_RING 3
    set p [els_tmpfile bk13.txt "v0\n"]
    set id [els::open $p]
    for {set i 1} {$i <= 6} {incr i} {
        [els::W $id] insert end "v$i\n"
        els::save
    }
    set ring [bk_ring $p]
    # not just the COUNT: the ring must keep the newest three, so its lsort-newest
    # entry is the last backup taken (whose pre-save content ended with v5).  Under
    # the old same-second suffix ordering the unsuffixed name sorted last, so the
    # "newest" was actually the very first (pre-v0) backup — pruning kept the wrong end.
    list [llength $ring] [string match "*v5\n" [raw_read [lindex $ring end]]]
} -result {3 1}

test bk-1.4 {a fresh newest backup suppresses churn (min spacing)} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 3600
    set p [els_tmpfile bk14.txt "original\n"]
    set id [els::open $p]
    [els::W $id] insert end "a" ; els::save
    [els::W $id] insert end "b" ; els::save
    [els::W $id] insert end "c" ; els::save
    set ring [bk_ring $p]
    # one backup only, and it is the PRE-burst version
    list [llength $ring] [raw_read [lindex $ring 0]]
} -result [list 1 "original\n"]

test bk-1.5 {auto-save also produces backups} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0 ; set ::els::autosave 1
    set p [els_tmpfile bk15.txt "base\n"]
    set id [els::open $p]
    [els::W $id] insert end "auto"
    els::autosave_flush_doc $id
    list [llength [bk_ring $p]] [raw_read [lindex [bk_ring $p] 0]]
} -result [list 1 "base\n"]

test bk-1.6 {backups off means no backup} -setup {els_reset} -body {
    set ::els::backups 0
    set p [els_tmpfile bk16.txt "one\n"]
    set id [els::open $p]
    [els::W $id] insert end "two" ; els::save
    list [llength [bk_ring $p]] [string match "*two*" [raw_read $p]]
} -result {0 1}

test bk-1.7 {a failing backup is a quiet note, the save still succeeds} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0
    # make the backups DIR path unusable: a plain file sits where the dir goes
    raw_write [bk_dir] "not a directory"
    set p [els_tmpfile bk17.txt "one\n"]
    set id [els::open $p]
    [els::W $id] insert end "two"
    set ok [els::save]
    set note [string match "backup failed:*" [.sb.name cget -text]]
    file delete -force [bk_dir]
    list $ok [string match "*two*" [raw_read $p]] $note $::els_test_mbcount
} -result {1 1 1 0}

test bk-1.8 {old backups age out via the sweep} -setup {els_reset} -body {
    set ::els::backups 1
    file mkdir [bk_dir]
    set old [file join [bk_dir] "old.txt.00000000.20250101-000000.bak"]
    raw_write $old "ancient"
    file mtime $old [expr {[clock seconds] - $::els::BK_MAXAGE - 100}]
    set fresh [file join [bk_dir] "new.txt.00000000.20990101-000000.bak"]
    raw_write $fresh "recent"
    els::maintenance_sweep
    list [file exists $old] [file exists $fresh]
} -result {0 1}

test bk-1.9 {the Keep Backups choice persists through the config round-trip} -setup {els_reset} -body {
    set ::els::backups 0
    els::save_geometry
    set ::els::backups 1
    els::load_geometry
    set v $::els::backups
    catch {file delete -force $::els::config_path}
    set v
} -result 0

test bk-1.10 {the ring orders by mtime, not the local-time name stamp (DST-safe, F14)} -setup {els_reset} -body {
    file mkdir [bk_dir]
    # three backups whose NAME order is the REVERSE of their mtime order, as if
    # the wall-clock stepped backward between writes
    set a [file join [bk_dir] "d.txt.00000000.20990101-000000.bak"] ;# name LAST
    set b [file join [bk_dir] "d.txt.00000000.20500101-000000.bak"] ;# name MID
    set c [file join [bk_dir] "d.txt.00000000.20200101-000000.bak"] ;# name FIRST
    raw_write $a "A" ; file mtime $a [expr {[clock seconds] - 300}]  ;# OLDEST mtime
    raw_write $b "B" ; file mtime $b [expr {[clock seconds] - 200}]
    raw_write $c "C" ; file mtime $c [expr {[clock seconds] - 100}]  ;# NEWEST mtime
    set ring [els::backup_ring [bk_dir] "d.txt.*.bak"]
    file delete -force $a $b $c
    # mtime order = a,b,c (oldest->newest); a plain name sort gives c,b,a
    list [file tail [lindex $ring 0]] [file tail [lindex $ring end]]
} -result {d.txt.00000000.20990101-000000.bak d.txt.00000000.20200101-000000.bak}

test bk-1.11 {prune keeps the newest-mtime backup even when a stale one's name sorts later (F14)} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0 ; set ::els::BK_RING 1
    set p [els_tmpfile bk111.txt "orig\n"]
    set id [els::open $p]
    file mkdir [bk_dir]
    # a pre-existing backup whose NAME sorts LATE (year 2099) but whose MTIME is
    # OLD: a name-ordered prune keeps it and drops the real newest
    set stale [file join [bk_dir] "[els::backup_stem $p].20990101-000000.bak"]
    raw_write $stale "stale"
    file mtime $stale [expr {[clock seconds] - 10000}]
    [els::W $id] insert end "edit" ; els::save    ;# writes a fresh backup of "orig\n"
    set ring [bk_ring $p]
    list [file exists $stale] [llength $ring] [raw_read [lindex $ring 0]]
} -result [list 0 1 "orig\n"]

test bk-1.12 {a newest backup dated in the FUTURE does not suppress a real backup (F14)} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 60
    set p [els_tmpfile bk112.txt "orig\n"]
    set id [els::open $p]
    file mkdir [bk_dir]
    # newest backup mtime is in the FUTURE (clock was stepped back): a raw
    # "[now] - mtime < BK_MININT" reads the negative age as "fresh" and skips
    set future [file join [bk_dir] "[els::backup_stem $p].20990101-000000.bak"]
    raw_write $future "future"
    file mtime $future [expr {[clock seconds] + 10000}]
    [els::W $id] insert end "edit" ; els::save
    set found 0
    foreach f [bk_ring $p] { if {[raw_read $f] eq "orig\n"} { set found 1 } }
    set found
} -result 1

test bk-1.13 {els ships with backups ON by default (the previous-versions safety net)} -body {
    # captured at helpers load, before els_reset forces it OFF for suite hygiene (F62)
    set ::els_shipped_backups
} -result 1

test bk-1.14 {menu carries Keep Backups and Open Backups Folder} -setup {els_reset} -body {
    set cb 0 ; set cmd 0
    for {set i 0} {$i <= [.menu.file index end]} {incr i} {
        set t [.menu.file type $i]
        if {$t in {command checkbutton}} {
            switch -- [.menu.file entrycget $i -label] {
                "Keep Backups"        { set cb 1 }
                "Open Backups Folder" { set cmd 1 }
            }
        }
    }
    list $cb $cmd
} -result {1 1}

test bk-1.15 {same-named files in different folders keep separate rings} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0
    file mkdir [file join $::ELS_TMP bkA] [file join $::ELS_TMP bkB]
    set pa [file join $::ELS_TMP bkA same.txt] ; raw_write $pa "AAA\n"
    set pb [file join $::ELS_TMP bkB same.txt] ; raw_write $pb "BBB\n"
    set ia [els::open $pa] ; [els::W $ia] insert end "a" ; els::save
    set ib [els::open $pb] ; els::switch_to $ib ; [els::W $ib] insert end "b" ; els::save
    list [raw_read [lindex [bk_ring $pa] 0]] [raw_read [lindex [bk_ring $pb] 0]]
} -result [list "AAA\n" "BBB\n"]

# ---- R3: external-change (lost-update) guard ------------------------------
# Another program rewrites the open file on disk; saving must not silently
# clobber that change.  raw_write with different-length content guarantees the
# file signature (size:mtime:crc) differs regardless of mtime granularity.

test extmod-1.1 {a manual save over an externally-changed file PROMPTS} -setup {els_reset} -body {
    set p [els_tmpfile em1.txt "original content\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "my local edit"
    raw_write $p "EXTERNALLY REWRITTEN BY ANOTHER PROGRAM\n"
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer cancel
    set rc [els::save]
    list $rc $::els_test_mbcount
} -result {0 1}

test extmod-1.2 {Cancel preserves the external bytes on disk (no clobber)} -setup {els_reset} -body {
    set p [els_tmpfile em2.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local"
    raw_write $p "EXTERNAL VERSION\n"
    set ::els_test_mbanswer cancel
    els::save
    expr {[raw_read $p] eq "EXTERNAL VERSION\n"}
} -result 1

test extmod-1.3 {Overwrite (Yes) clobbers the disk version with our buffer} -setup {els_reset} -body {
    set p [els_tmpfile em3.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] delete 1.0 end ; [els::W $id] insert end "our content"
    raw_write $p "EXTERNAL\n"
    set ::els_test_mbanswer yes
    set rc [els::save]
    list $rc [string match "*our content*" [raw_read $p]]
} -result {1 1}

test extmod-1.4 {Reload (No) discards our edits and re-reads disk} -setup {els_reset} -body {
    set p [els_tmpfile em4.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local junk"
    raw_write $p "THE REAL DISK CONTENT"
    set ::els_test_mbanswer no
    els::save
    list [els::doc_dirty $id] [[els::W $id] get 1.0 "end - 1 char"]
} -result {0 {THE REAL DISK CONTENT}}

test extmod-1.5 {autosave (quiet) NEVER prompts on external change; it pauses instead} -setup {els_reset} -body {
    set p [els_tmpfile em5.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local"
    raw_write $p "EXTERNAL\n"
    set ::els_test_mbcount 0
    set rc [els::save $id 1]
    list $rc $::els_test_mbcount [info exists ::els::docExtModPause($id)] \
         [expr {[raw_read $p] eq "EXTERNAL\n"}]
} -result {0 0 1 1}

test extmod-1.6 {a normal save does NOT prompt: our own prior save must not false-positive} -setup {els_reset} -body {
    set p [els_tmpfile em6.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "edit one"
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer yes
    set r1 [els::save]
    [els::W $id] insert end " edit two"
    set r2 [els::save]
    list $r1 $r2 $::els_test_mbcount
} -result {1 1 0}

test extmod-1.7 {Save As onto a different existing file does not trigger the external-change prompt} -setup {els_reset} -body {
    set p [els_tmpfile em7a.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "content"
    set other [els_tmpfile em7b.txt "different existing file\n"]
    set ::els_test_savefile $other
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer yes
    els::saveas
    set ::els_test_mbcount
} -result 0

test extmod-1.8 {reload_from_disk re-reads FRESH bytes from disk, not the cached docRaw} -setup {els_reset} -body {
    set p [els_tmpfile em8.txt "original disk content"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "X"
    raw_write $p "BRAND NEW DISK CONTENT"
    els::reload_from_disk $id
    list [els::doc_dirty $id] [[els::W $id] get 1.0 "end - 1 char"]
} -result {0 {BRAND NEW DISK CONTENT}}

test extmod-1.9 {a byte-identical external rewrite (mtime-only bump) does NOT prompt or pause} -setup {els_reset} -body {
    set p [els_tmpfile em9.txt "identical bytes\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local edit"
    # rewrite the SAME bytes (OneDrive/AV/backup touch) then bump mtime past open
    raw_write $p "identical bytes\n"
    file mtime $p [expr {[file mtime $p] + 5}]
    set ::els_test_mbcount 0
    set rc [els::save $id]
    list $rc $::els_test_mbcount [info exists ::els::docExtModPause($id)]
} -result {1 0 0}

test extstate-1.1 {a removed target pauses autosave and requires an explicit manual recreate} -setup {els_reset} -body {
    set p [els_tmpfile removed-target.txt "disk version\n"]
    els::open $p ; set id $::els::active
    [els::W $id] delete 1.0 end ; [els::W $id] insert end "buffer version"
    file delete -force $p
    set ::els_test_mbcount 0
    set quiet [els::save $id 1]
    set paused [info exists ::els::docExtModPause($id)]
    set ::els_test_mbanswer no
    set declined [els::save $id]
    set safe [expr {![file exists $p] && [els::doc_dirty $id]}]
    set ::els_test_mbanswer yes
    set accepted [els::save $id]
    list $quiet $paused $declined $safe $accepted [raw_read $p] \
         [els::doc_dirty $id] $::els_test_mbcount
} -result {0 1 0 1 1 {buffer version} 0 2}

test extstate-1.2 {an unreadable target pauses quiet save and needs explicit manual overwrite} -setup {
    els_reset
    rename els::file_sig_probe _els_real_file_sig_probe
    proc els::file_sig_probe {path} { return [dict create state unreadable error "sharing violation"] }
} -cleanup {
    catch {rename els::file_sig_probe {}}
    if {[llength [info commands _els_real_file_sig_probe]]} { rename _els_real_file_sig_probe els::file_sig_probe }
} -body {
    set p [els_tmpfile unreadable-target.txt "disk version\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local"
    set ::els_test_mbcount 0
    set quiet [els::save $id 1]
    set paused [info exists ::els::docExtModPause($id)]
    set ::els_test_mbanswer no
    set declined [els::save $id]
    set unchanged [expr {[raw_read $p] eq "disk version\n"}]
    set ::els_test_mbanswer yes
    set accepted [els::save $id]
    list $quiet $paused $declined $unchanged $accepted [raw_read $p] \
         [els::doc_dirty $id] $::els_test_mbcount
} -result [list 0 1 0 1 1 "disk version\nlocal" 0 2]

# ---- full-content external-change signatures -----------------------------
# Authoritative signatures hash every byte at every size.  Their content key
# therefore always drops volatile mtime without a middle-write blind spot.

test extmod-1.10 {sig_content drops mtime at every size now that every CRC is full-content} -body {
    set cap 16777216
    list [els::sig_content "1000:111:222"] \
         [els::sig_content "[expr {$cap + 1}]:111:222"] \
         [expr {[els::sig_content "[expr {$cap+1}]:111:222"] ne \
                [els::sig_content "[expr {$cap+1}]:999:222"]}] \
         [expr {[els::sig_content "1000:111:222"] eq [els::sig_content "1000:999:222"]}]
} -result {1000:222 16777217:222 0 1}

test extmod-1.11 {a same-size middle rewrite with restored mtime PROMPTS (no silent clobber)} \
        -setup {els_reset} -cleanup {set ::els::SWAP_FILE_CRC_CAP 16777216} -body {
    # Keep the old cap low to prove it no longer changes authoritative hashing.
    set ::els::SWAP_FILE_CRC_CAP 100000
    set base [string repeat A 200000]
    set p [els_tmpfile big_mid.txt $base]
    els::open $p ; set id $::els::active
    set originalMtime [file mtime $p]
    [els::W $id] insert end "local edit"
    # external program rewrites 20 bytes at the true middle, size preserved
    set external [string replace $base 100000 100019 [string repeat B 20]]
    raw_write $p $external
    file mtime $p $originalMtime
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer cancel
    set rc [els::save $id]
    list $rc $::els_test_mbcount [expr {[raw_read $p] eq $external}]
} -result {0 1 1}

test extmod-1.13 {quiet save pauses on a same-size same-mtime middle rewrite} \
        -setup {els_reset} -body {
    set base [string repeat A 200000]
    set p [els_tmpfile big_mid_quiet.txt $base]
    els::open $p ; set id $::els::active ; set mt [file mtime $p]
    [els::W $id] insert end "local edit"
    set external [string replace $base 99990 100009 [string repeat Z 20]]
    raw_write $p $external ; file mtime $p $mt
    set ::els_test_mbcount 0
    set rc [els::save $id 1]
    list $rc [info exists ::els::docExtModPause($id)] \
         [expr {[raw_read $p] eq $external}] $::els_test_mbcount [els::doc_dirty $id]
} -result {0 1 1 0 1}

test extmod-1.12 {a head-window rewrite of a >cap file still PROMPTS (control: crc-visible)} \
        -setup {els_reset} -cleanup {set ::els::SWAP_FILE_CRC_CAP 16777216} -body {
    set ::els::SWAP_FILE_CRC_CAP 100000
    set base [string repeat A 200000]
    set p [els_tmpfile big_head.txt $base]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local edit"
    raw_write $p [string replace $base 100 119 [string repeat B 20]]   ;# inside head 64 KiB
    file mtime $p [expr {[file mtime $p] + 5}]
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer cancel
    els::save $id
    set ::els_test_mbcount
} -result 1

# ---- active-document disk-state visibility ------------------------------

test diskstate-1.1 {disk observer distinguishes untitled, normal, changed, missing, and unavailable without reload/modal} \
        -setup {els_reset} -cleanup {
            catch {rename ::els::disk_stat_probe {}}
            if {[llength [info commands ::els::disk_stat_probe_real]]} {
                rename ::els::disk_stat_probe_real ::els::disk_stat_probe
            }
        } -body {
    set untitled [els::disk_probe]
    set p [els_tmpfile diskstate_transitions.txt "alpha\n"]
    set id [els::open $p]
    set normal $::els::docDiskState($id)
    set before [[els::W $id] get 1.0 "end - 1 char"]
    raw_write $p "omega\n"
    file mtime $p [expr {[file mtime $p] + 5}]
    set ::els_test_mbcount 0
    set changed [els::disk_probe $id]
    set after [[els::W $id] get 1.0 "end - 1 char"]
    file delete -force $p
    set missing [els::disk_probe $id]
    rename ::els::disk_stat_probe ::els::disk_stat_probe_real
    proc ::els::disk_stat_probe {path} {
        return [dict create state unavailable error "injected sharing denial"]
    }
    set unavailable [els::disk_probe $id]
    list $untitled $normal $changed $missing $unavailable \
         [expr {$before eq $after}] $::els_test_mbcount \
         [info exists ::els::docExtModPause($id)]
} -result {untitled normal changed missing unavailable 1 0 0}

test diskstate-1.2 {read-only changes are reflected conservatively without content reads} \
        -setup {els_reset} -cleanup {
            if {[info exists p] && [file exists $p]} { catch {file attributes $p -readonly 0} }
        } -body {
    set p [els_tmpfile diskstate_readonly.txt "read me\n"]
    set id [els::open $p]
    file attributes $p -readonly 1
    set ro [els::disk_probe $id]
    file attributes $p -readonly 0
    set normal [els::disk_probe $id]
    list $ro $normal
} -result {readonly normal}

test diskstate-1.3 {forced checks hash each new metadata observation and back off repeats} \
        -setup {
            els_reset
            set p [els_tmpfile diskstate_cache.txt "alpha\n"]
            set id [els::open $p]
            rename ::els::file_sig_probe ::els::file_sig_probe_real
            set ::disk_deep_calls 0
            proc ::els::file_sig_probe {path} {
                incr ::disk_deep_calls
                tailcall ::els::file_sig_probe_real $path
            }
        } -cleanup {
            catch {rename ::els::file_sig_probe {}}
            if {[llength [info commands ::els::file_sig_probe_real]]} {
                rename ::els::file_sig_probe_real ::els::file_sig_probe
            }
            unset -nocomplain ::disk_deep_calls
        } -body {
    els::disk_probe $id
    els::disk_probe $id
    set unchangedCalls $::disk_deep_calls
    file mtime $p [expr {[file mtime $p] + 5}]
    set same1 [els::disk_probe $id]
    set sameCalls1 $::disk_deep_calls
    set same2 [els::disk_probe $id]
    set sameCalls2 $::disk_deep_calls
    set priorMtime [file mtime $p]
    raw_write $p "omega\n"
    file mtime $p [expr {$priorMtime + 5}]
    set changed1 [els::disk_probe $id]
    set changedCalls1 $::disk_deep_calls
    set changed2 [els::disk_probe $id]
    list $unchangedCalls $same1 $sameCalls1 $same2 $sameCalls2 \
         $changed1 $changedCalls1 $changed2 $::disk_deep_calls
} -result {1 normal 2 normal 2 changed 3 changed 3}

test diskstate-1.4 {a metadata-changed large file takes the cheap observer path and is never deep-read} \
        -setup {
            els_reset
            set ::els::DISK_DEEP_PROBE_CAP 32
            set p [els_tmpfile diskstate_large.txt [string repeat A 200]]
            set id [els::open $p]
            rename ::els::file_sig_probe ::els::file_sig_probe_real
            set ::disk_deep_calls 0
            proc ::els::file_sig_probe {path} {
                incr ::disk_deep_calls
                error "large-file observer must not read a signature"
            }
        } -cleanup {
            set ::els::DISK_DEEP_PROBE_CAP 16777216
            catch {rename ::els::file_sig_probe {}}
            if {[llength [info commands ::els::file_sig_probe_real]]} {
                rename ::els::file_sig_probe_real ::els::file_sig_probe
            }
            unset -nocomplain ::disk_deep_calls
        } -body {
    raw_write $p "[string repeat A 99]B[string repeat A 100]"
    file mtime $p [expr {[file mtime $p] + 5}]
    set a [els::disk_probe $id]
    set b [els::disk_probe $id]
    list $a $b $::disk_deep_calls
} -result {changed changed 0}

test diskstate-1.8 {forced activation detects a same-size same-mtime small-file rewrite} \
        -setup {els_reset} -body {
    set p [els_tmpfile diskstate_same_meta.txt "alpha\n"]
    set id [els::open $p] ; set mt [file mtime $p]
    raw_write $p "omega\n" ; file mtime $p $mt
    list [els::disk_probe $id forced] $::els::docDiskState($id)
} -result {changed changed}

test diskstate-1.9 {repeated forced checks back off deep I/O and timer polling never deep-reads} \
        -setup {
            els_reset
            set p [els_tmpfile diskstate_backoff.txt "alpha\n"]
            set id [els::open $p]
            rename ::els::file_sig_probe ::els::file_sig_probe_real
            set ::disk_deep_calls 0
            proc ::els::file_sig_probe {path} {
                incr ::disk_deep_calls
                tailcall ::els::file_sig_probe_real $path
            }
            set ::els::DISK_DEEP_BACKOFF_MS 60000
        } -cleanup {
            els::disk_watch_deactivate
            catch {rename ::els::file_sig_probe {}}
            if {[llength [info commands ::els::file_sig_probe_real]]} {
                rename ::els::file_sig_probe_real ::els::file_sig_probe
            }
            unset -nocomplain ::disk_deep_calls ::disk_timer_fired
        } -body {
    els::disk_probe $id forced
    els::disk_probe $id forced
    set forcedCalls $::disk_deep_calls
    set ::disk_timer_fired 0 ; after 0 {set ::disk_timer_fired 1}
    set ::els::disk_watch_active 1
    els::disk_watch_tick
    update
    list $forcedCalls $::disk_deep_calls $::disk_timer_fired
} -result {1 1 1}

test diskstate-1.10 {all automatic observer modes skip obvious UNC paths without stat or hash I/O} \
        -setup {
            els_reset
            rename ::els::disk_stat_probe ::els::disk_stat_probe_real
            set ::disk_stat_calls 0
            proc ::els::disk_stat_probe {path} { incr ::disk_stat_calls ; error "must not poll UNC" }
            rename ::els::file_sig_probe ::els::file_sig_probe_real
            set ::disk_hash_calls 0
            proc ::els::file_sig_probe {path} { incr ::disk_hash_calls ; error "must not hash UNC" }
        } -cleanup {
            catch {rename ::els::disk_stat_probe {}}
            if {[llength [info commands ::els::disk_stat_probe_real]]} {
                rename ::els::disk_stat_probe_real ::els::disk_stat_probe
            }
            catch {rename ::els::file_sig_probe {}}
            if {[llength [info commands ::els::file_sig_probe_real]]} {
                rename ::els::file_sig_probe_real ::els::file_sig_probe
            }
            unset -nocomplain ::disk_stat_calls ::disk_hash_calls
        } -body {
    set id $::els::active
    set ::els::docPath($id) {//offline/share/file.txt}
    set forced [els::disk_probe $id forced]
    set timer [els::disk_probe $id timer]
    list $forced $timer $::disk_stat_calls $::disk_hash_calls
} -result {remote remote 0 0}

test diskstate-1.11 {remote detector distinguishes ordinary and extended UNC from local device paths} \
        -setup {els_reset} -body {
    list [els::remote_path {//server/share/file.txt}] \
         [els::remote_path {\\server\share\file.txt}] \
         [els::remote_path {//?/UNC/server/share/file.txt}] \
         [els::remote_path {\\?\UNC\server\share\file.txt}] \
         [els::remote_path {//?/C:/local/file.txt}] \
         [els::remote_path {\\?\C:\local\file.txt}] \
         [els::remote_path {//./pipe/name}] \
         [els::remote_path {\\.\pipe\name}]
} -result {1 1 1 1 0 0 0 0}

test diskstate-1.12 {a mapped network drive (DRIVE_REMOTE) is a network path; fixed/removable drives stay local} \
        -setup {
            els_reset
            rename ::els::drive_type ::els::drive_type_real
            # classify by drive letter so the result is independent of this machine's
            # real drive map: Z: acts as a mapped share, E: as a USB stick, else fixed.
            proc ::els::drive_type {path} {
                switch -glob -nocase -- $path {
                    z:* { return remote }
                    e:* { return removable }
                    default { return fixed }
                }
            }
        } -cleanup {
            catch {rename ::els::drive_type {}}
            if {[llength [info commands ::els::drive_type_real]]} {
                rename ::els::drive_type_real ::els::drive_type
            }
        } -body {
    list [els::remote_path {Z:/share/file.txt}] \
         [els::remote_path {Z:\share\file.txt}] \
         [els::remote_path {C:/local/file.txt}] \
         [els::remote_path {E:/usb/file.txt}] \
         [els::remote_path {//server/share/file.txt}]
} -result {1 1 0 0 1}

test diskstate-1.13 {a mapped-drive document is polled like a UNC path: no synchronous stat or hash on the event thread} \
        -setup {
            els_reset
            rename ::els::drive_type ::els::drive_type_real
            proc ::els::drive_type {path} { return remote }
            rename ::els::disk_stat_probe ::els::disk_stat_probe_real
            set ::disk_stat_calls 0
            proc ::els::disk_stat_probe {path} { incr ::disk_stat_calls ; error "must not poll a mapped drive" }
            rename ::els::file_sig_probe ::els::file_sig_probe_real
            set ::disk_hash_calls 0
            proc ::els::file_sig_probe {path} { incr ::disk_hash_calls ; error "must not hash a mapped drive" }
        } -cleanup {
            catch {rename ::els::drive_type {}}
            if {[llength [info commands ::els::drive_type_real]]} { rename ::els::drive_type_real ::els::drive_type }
            catch {rename ::els::disk_stat_probe {}}
            if {[llength [info commands ::els::disk_stat_probe_real]]} { rename ::els::disk_stat_probe_real ::els::disk_stat_probe }
            catch {rename ::els::file_sig_probe {}}
            if {[llength [info commands ::els::file_sig_probe_real]]} { rename ::els::file_sig_probe_real ::els::file_sig_probe }
            unset -nocomplain ::disk_stat_calls ::disk_hash_calls
        } -body {
    set id $::els::active
    set ::els::docPath($id) {Z:/share/file.txt}
    set forced [els::disk_probe $id forced]
    set timer [els::disk_probe $id timer]
    list $forced $timer $::disk_stat_calls $::disk_hash_calls
} -result {remote remote 0 0}

test diskstate-1.5 {tab switches probe immediately; the timer runs only while the app is active} \
        -setup {
            els_reset
            set p1 [els_tmpfile diskstate_watch1.txt "one\n"]
            set p2 [els_tmpfile diskstate_watch2.txt "two\n"]
            set id1 [els::open $p1]
            set id2 [els::open $p2]
            els::disk_watch_deactivate
            rename ::els::disk_stat_probe ::els::disk_stat_probe_real
            set ::disk_stat_calls 0
            proc ::els::disk_stat_probe {path} {
                incr ::disk_stat_calls
                tailcall ::els::disk_stat_probe_real $path
            }
            set ::els::DISK_WATCH_MS 15
        } -cleanup {
            els::disk_watch_deactivate
            set ::els::DISK_WATCH_MS 5000
            catch {rename ::els::disk_stat_probe {}}
            if {[llength [info commands ::els::disk_stat_probe_real]]} {
                rename ::els::disk_stat_probe_real ::els::disk_stat_probe
            }
            unset -nocomplain ::disk_stat_calls ::disk_wait
        } -body {
    els::switch_to $id1
    els::switch_to $id2
    set switchCalls $::disk_stat_calls
    set ::disk_wait 0 ; after 45 {set ::disk_wait 1} ; vwait ::disk_wait
    set inactiveCalls $::disk_stat_calls
    els::disk_watch_activate
    set activationCalls $::disk_stat_calls
    set ::disk_wait 0 ; after 55 {set ::disk_wait 1} ; vwait ::disk_wait
    set activeCalls $::disk_stat_calls
    els::disk_watch_deactivate
    set stoppedAt $::disk_stat_calls
    set ::disk_wait 0 ; after 40 {set ::disk_wait 1} ; vwait ::disk_wait
    list $switchCalls $inactiveCalls [expr {$activationCalls == $inactiveCalls + 1}] \
         [expr {$activeCalls > $activationCalls}] \
         [expr {$::disk_stat_calls == $stoppedAt}] \
         $::els::disk_watch_after
} -result {2 2 1 1 1 {}}

test diskstate-1.6 {successful save and reload immediately rebase the visible disk state} \
        -setup {els_reset} -body {
    set p [els_tmpfile diskstate_save_reload.txt "one\n"]
    set id [els::open $p]
    raw_write $p "two\n"
    file mtime $p [expr {[file mtime $p] + 5}]
    set changed1 [els::disk_probe $id]
    set w [els::W $id]
    $w delete 1.0 end ; $w insert end "mine\n"
    set ::els_test_mbanswer yes ; set ::els_test_mbcount 0
    set saved [els::save $id]
    set afterSave $::els::docDiskState($id)
    raw_write $p "disk\n"
    file mtime $p [expr {[file mtime $p] + 5}]
    set changed2 [els::disk_probe $id]
    set reloaded [els::reload_from_disk $id]
    list $changed1 $saved $afterSave $::els_test_mbcount $changed2 $reloaded \
         $::els::docDiskState($id) [$w get 1.0 1.end]
} -result {changed 1 normal 1 changed 1 normal disk}

test diskstate-1.7 {Save As moves an untitled document to the normal on-disk state} \
        -setup {els_reset} -body {
    set id $::els::active
    [els::W $id] insert end "first save"
    set before [els::disk_probe $id]
    set ::els_test_savefile [file join $::ELS_TMP diskstate_saveas.txt]
    set saved [els::saveas]
    list $before $saved $::els::docDiskState($id) \
         [els::same_path $::els::docPath($id) $::els_test_savefile] \
         [.sb.disk cget -text]
} -result {untitled 1 normal 1 {}}

# ---- P2-c: large-file open guard + bounded undo (Wave 2) -------------------
# The threshold is lowered per-test (a real 25 MB fixture would be slow + litter);
# -cleanup restores a large threshold so later tests never spuriously prompt.

test bigfile-1.1 {a large-file open PROMPTS interactively; declining creates no tab} -setup {els_reset} \
        -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile big1.txt "0123456789 — more than five bytes\n"]
    set ::els::OPEN_WARN_SIZE 5
    set before [llength $::els::docs]
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer no
    set rc [els::open $p]
    list $rc $::els_test_mbcount [expr {[llength $::els::docs] == $before}]
} -result {{} 1 1}

test bigfile-1.2 {accepting the large-file prompt opens the file} -setup {els_reset} \
        -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile big2.txt "large content here\n"]
    set ::els::OPEN_WARN_SIZE 5 ; set ::els_test_mbanswer yes
    els::deferred_add $p
    set id [els::open $p]
    list [expr {$id ne ""}] [els::same_path $::els::docPath($id) $p] \
         [llength $::els::deferred_files]
} -result {1 1 0}

test bigfile-1.3 {a quiet large-file open is persisted and deduplicated without prompting or loading} -setup {els_reset} \
        -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile big3.txt "restored large file\n"]
    set ::els::OPEN_WARN_SIZE 5 ; set ::els_test_mbcount 0
    set before [llength $::els::docs]
    set id1 [els::open $p 1]
    set id2 [els::open $p 1]
    set stored [raw_read [els::deferred_path]]
    set ::els::deferred_files {}
    els::deferred_load
    list $id1 $id2 $::els_test_mbcount \
         [expr {[llength $::els::docs] == $before}] \
         [llength $::els::deferred_files] \
         [els::same_path [lindex $::els::deferred_files 0] $p] \
         [dict get $stored schema]
} -result {{} {} 0 1 1 1 1}

test bigfile-1.4 {a normal (under-threshold) open never prompts} -setup {els_reset} -body {
    set p [els_tmpfile smallish.txt "small\n"]
    set ::els_test_mbcount 0
    els::open $p
    set ::els_test_mbcount
} -result 0

test bigfile-1.5 {documents are created with a bounded undo stack (-maxundo)} -setup {els_reset} -body {
    expr {[[els::T] cget -maxundo] == $::els::MAXUNDO && $::els::MAXUNDO > 0}
} -result 1

test bigfile-1.6 {a throw during decode/insert (e.g. OOM) restores the busy cursor, never strands it} -setup {els_reset} -body {
    set p [els_tmpfile big6.txt "content\n"]
    rename els::decode _els_decode_real
    proc els::decode {args} { error "simulated OOM in decode" }
    catch {. configure -cursor ""}          ;# baseline
    set rc [els::open $p]                     ;# decode throws inside the read/insert block
    list $rc [. cget -cursor]                 ;# "" = open failed cleanly, cursor NOT stuck on "watch"
} -cleanup {
    if {[llength [info commands _els_decode_real]]} { catch {rename els::decode {}} ; rename _els_decode_real els::decode }
    catch {. configure -cursor ""}
} -result {{} {}}

test bigfile-1.7 {explicit deferred-open consent has no second prompt or absolute ceiling} \
        -setup {els_reset} -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile big7.txt [string repeat x 5000]]
    set ::els::OPEN_WARN_SIZE 1
    els::deferred_add $p
    set ::els_test_mbcount 0
    set id [els::open $p 0 0 1]
    list [expr {$id ne ""}] $::els_test_mbcount \
         [llength $::els::deferred_files] \
         [[els::W $id] count -chars 1.0 "end - 1 char"]
} -result {1 0 0 5000}

test bigfile-1.8 {session restore defers a large file AND keeps it in the session so the tab never silently vanishes (R05)} \
        -setup {els_reset} -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile big8.txt "large restored body\n"]
    set ::els::OPEN_WARN_SIZE 5
    set ::els::session_files [list $p]
    set ::els_test_mbcount 0
    set restored [els::session_restore]
    # deferred (in the durable queue) AND retained in session_pending, so
    # save_geometry keeps it in session_files instead of dropping it (R05).
    list $restored $::els_test_mbcount [llength $::els::session_pending] \
         [llength $::els::deferred_files] [els::deferred_contains $p]
} -result {0 0 1 1 1}

test bigfile-1.10 {a deferred-add write failure rolls memory back and reports failure} -setup {
    els_reset
    set p1 [els_tmpfile defer_txn_keep.txt "keep\n"]
    set p2 [els_tmpfile defer_txn_add.txt "add\n"]
    els::deferred_add $p1
    set ::els::OPEN_WARN_SIZE 1
    set beforeDisk [raw_read [els::deferred_path]]
    rename ::els::write_atomic ::els::write_atomic_real
    set ::deferred_write_calls 0
    proc ::els::write_atomic {args} { incr ::deferred_write_calls ; return "injected queue write failure" }
} -cleanup {
    set ::els::OPEN_WARN_SIZE 26214400
    catch {rename ::els::write_atomic {}}
    if {[llength [info commands ::els::write_atomic_real]]} {
        rename ::els::write_atomic_real ::els::write_atomic
    }
    unset -nocomplain ::deferred_write_calls
} -body {
    set rc [els::deferred_add $p2]
    set beforeDocs [llength $::els::docs]
    set quietRc [els::open $p2 1]
    list $rc $quietRc $::deferred_write_calls [llength $::els::deferred_files] \
         [els::deferred_contains $p1] [els::deferred_contains $p2] \
         [expr {[raw_read [els::deferred_path]] eq $beforeDisk}] \
         [expr {[llength $::els::docs] == $beforeDocs}] \
         [string match "*not opened*" [.sb.name cget -text]]
} -result {0 {} 2 1 1 0 1 1 1}

test bigfile-1.11 {a deferred-remove write failure retains the durable entry even after a successful open} -setup {
    els_reset
    set p [els_tmpfile defer_txn_remove.txt "large queued body\n"]
    set ::els::OPEN_WARN_SIZE 1
    els::deferred_add $p
    rename ::els::write_atomic ::els::write_atomic_real
    set ::deferred_write_calls 0
    proc ::els::write_atomic {args} { incr ::deferred_write_calls ; return "injected queue write failure" }
} -cleanup {
    set ::els::OPEN_WARN_SIZE 26214400
    catch {rename ::els::write_atomic {}}
    if {[llength [info commands ::els::write_atomic_real]]} {
        rename ::els::write_atomic_real ::els::write_atomic
    }
    unset -nocomplain ::deferred_write_calls
} -body {
    set removeRc [els::deferred_remove_many [list $p]]
    set id [els::open $p 0 0 1]
    set disk [raw_read [els::deferred_path]]
    list $removeRc [expr {$id ne ""}] $::deferred_write_calls \
         [els::deferred_contains $p] \
         [els::same_path [lindex [dict get $disk files] 0] $p]
} -result {0 1 2 1 1}

test bigfile-1.14 {multi-entry deferred removal rolls memory and disk back on write failure} -setup {
    els_reset
    set p1 [els_tmpfile defer_many_1.txt "one\n"]
    set p2 [els_tmpfile defer_many_2.txt "two\n"]
    set p3 [els_tmpfile defer_many_3.txt "three\n"]
    foreach p [list $p1 $p2 $p3] { els::deferred_add $p }
    set beforeMem $::els::deferred_files
    set beforeDisk [raw_read [els::deferred_path]]
    rename ::els::write_atomic ::els::write_atomic_real
    proc ::els::write_atomic {args} { return "injected multi-remove failure" }
} -cleanup {
    catch {rename ::els::write_atomic {}}
    if {[llength [info commands ::els::write_atomic_real]]} {
        rename ::els::write_atomic_real ::els::write_atomic
    }
} -body {
    set rc [els::deferred_remove_many [list $p1 $p2]]
    list $rc [expr {$::els::deferred_files eq $beforeMem}] \
         [expr {[raw_read [els::deferred_path]] eq $beforeDisk}] \
         [lmap p [list $p1 $p2 $p3] {els::deferred_contains $p}]
} -result {0 1 1 {1 1 1}}

test deferred-state-1.1 {invalid UTF-8, schema, and exact parse are quarantined and reported} \
        -setup {els_reset} -body {
    set path [els::deferred_path]
    set outcomes {}
    foreach payload [list "\xff" \
            [encoding convertto utf-8 [dict create schema 2 files {}]] \
            [encoding convertto utf-8 [dict create schema 1 files {} extra x]] \
            [encoding convertto utf-8 {schema 1 files \{}]] {
        raw_write $path $payload
        els::deferred_load
        lappend outcomes [list [file exists $path] $::els::deferred_blocked \
            [llength $::els::deferred_files] [expr {$::els::deferred_notice ne ""}]]
    }
    list $outcomes [llength [glob -nocomplain "$path.corrupt-*"]]
} -result {{{0 0 0 1} {0 0 0 1} {0 0 0 1} {0 0 0 1}} 4}

test deferred-state-1.2 {failed corruption quarantine blocks every overwrite of the evidence} \
        -setup {
            els_reset
            set path [els::deferred_path]
            raw_write $path "\xffbroken"
            set before [raw_read $path]
            rename ::els::deferred_quarantine ::els::deferred_quarantine_real
            proc ::els::deferred_quarantine {path} { error "injected rename denial" }
        } -cleanup {
            catch {rename ::els::deferred_quarantine {}}
            if {[llength [info commands ::els::deferred_quarantine_real]]} {
                rename ::els::deferred_quarantine_real ::els::deferred_quarantine
            }
        } -body {
    els::deferred_load
    set add [els::deferred_add [els_tmpfile blocked_deferred.txt "body\n"]]
    list $::els::deferred_blocked $add [expr {[raw_read $path] eq $before}] \
         [llength $::els::deferred_files]
} -result {1 0 1 0}

test deferred-state-1.3 {a directory at the state-file path is corrupt state and is quarantined intact} \
        -setup {els_reset} -body {
    set path [els::deferred_path]
    file mkdir $path
    raw_write [file join $path evidence.txt] "preserve me"
    els::deferred_load
    set quarantined [glob -nocomplain "$path.corrupt-*"]
    list [file exists $path] $::els::deferred_blocked \
         [expr {$::els::deferred_notice ne ""}] [llength $quarantined] \
         [expr {[llength $quarantined] == 1 &&
                [file isdirectory [lindex $quarantined 0]] &&
                [raw_read [file join [lindex $quarantined 0] evidence.txt]] eq "preserve me"}]
} -result {0 0 1 1 1}

test deferred-state-1.4 {an unpaired surrogate cannot be lossy-encoded and add rolls memory and disk back} \
        -setup {els_reset} -body {
    set keep [els_tmpfile deferred_encoding_keep.txt "keep\n"]
    els::deferred_add $keep
    set beforeMem $::els::deferred_files
    set beforeDisk [raw_read [els::deferred_path]]
    # A lexical UNC spelling keeps this deliberately malformed Tcl string away
    # from filesystem normalization; strict UTF-8 must reject it, never replace it.
    set malformed "//offline/share/[format %c 0xD800].txt"
    set added [els::deferred_add $malformed]
    list $added [expr {$::els::deferred_files eq $beforeMem}] \
         [expr {[raw_read [els::deferred_path]] eq $beforeDisk}] \
         [els::deferred_contains $keep]
} -result {0 1 1 1}

test quiet-open-1.1 {quiet startup-style open failure is logged, nonmodal, and not counted as opened} \
        -setup {els_reset} -body {
    set missing [file join $::ELS_TMP definitely-missing-open.txt]
    catch {file delete -force $missing}
    # els.log is a shared, append-only file that els_reset never clears, and an
    # earlier same-file test (bigfile-1.10) already writes "quiet open failed" into
    # it -- so clear it here to attribute the phrase to THIS open, not a leftover (R31).
    set log [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $log}
    set ::els_test_mbcount 0
    set rc [els::open $missing 1]
    list $rc $::els::last_open_outcome $::els_test_mbcount \
         [string match "*not opened*" [.sb.name cget -text]] \
         [expr {[file exists $log] && [string match "*quiet open failed*" [raw_read $log]]}]
} -result {{} failed 0 1 1}

test quiet-open-1.2 {quiet extended-UNC open defers durably before every document stat or read seam} \
        -setup {
            els_reset
            rename ::els::read_preflight_size ::els::read_preflight_size_real
            rename ::els::_read_binary_prefix ::els::_read_binary_prefix_real
            set ::unc_preflight_calls 0
            set ::unc_read_calls 0
            proc ::els::read_preflight_size {path} { incr ::unc_preflight_calls ; error "must not stat UNC" }
            proc ::els::_read_binary_prefix {fh limit} { incr ::unc_read_calls ; error "must not read UNC" }
        } -cleanup {
            catch {rename ::els::read_preflight_size {}}
            if {[llength [info commands ::els::read_preflight_size_real]]} {
                rename ::els::read_preflight_size_real ::els::read_preflight_size
            }
            catch {rename ::els::_read_binary_prefix {}}
            if {[llength [info commands ::els::_read_binary_prefix_real]]} {
                rename ::els::_read_binary_prefix_real ::els::_read_binary_prefix
            }
            unset -nocomplain ::unc_preflight_calls ::unc_read_calls
        } -body {
    set p {\\?\UNC\offline\share\quiet.txt}
    set rc [els::open $p 1]
    list $rc $::els::last_open_outcome [els::deferred_contains $p] \
         [file exists [els::deferred_path]] $::unc_preflight_calls $::unc_read_calls \
         $::els_test_mbcount
} -result {{} deferred 1 1 0 0 0}

test quiet-open-1.3 {session restore routes UNC paths to the zero-probe durable queue} \
        -setup {
            els_reset
            rename ::els::read_preflight_size ::els::read_preflight_size_real
            rename ::els::_read_binary_prefix ::els::_read_binary_prefix_real
            set ::unc_preflight_calls 0
            set ::unc_read_calls 0
            proc ::els::read_preflight_size {path} { incr ::unc_preflight_calls ; error "must not stat UNC" }
            proc ::els::_read_binary_prefix {fh limit} { incr ::unc_read_calls ; error "must not read UNC" }
        } -cleanup {
            catch {rename ::els::read_preflight_size {}}
            if {[llength [info commands ::els::read_preflight_size_real]]} {
                rename ::els::read_preflight_size_real ::els::read_preflight_size
            }
            catch {rename ::els::_read_binary_prefix {}}
            if {[llength [info commands ::els::_read_binary_prefix_real]]} {
                rename ::els::_read_binary_prefix_real ::els::_read_binary_prefix
            }
            unset -nocomplain ::unc_preflight_calls ::unc_read_calls
        } -body {
    set fromSession {//offline/share/session.txt}
    set ::els::session_files [list $fromSession]
    set ::els::restore_session 1
    set restored [els::session_restore]
    list $restored [els::deferred_contains $fromSession] \
         $::unc_preflight_calls $::unc_read_calls $::els_test_mbcount
} -result {0 1 0 0 0}

test bounded-read-1.1 {post-stat growth is caught by threshold+1 and durably deferred when quiet} \
        -setup {
            els_reset
            set ::els::OPEN_WARN_SIZE 5
            set p [els_tmpfile bounded_growth.txt "0123456789abcdef"]
            rename ::els::read_preflight_size ::els::read_preflight_size_real
            proc ::els::read_preflight_size {path} { return 0 }
        } -cleanup {
            set ::els::OPEN_WARN_SIZE 26214400
            catch {rename ::els::read_preflight_size {}}
            if {[llength [info commands ::els::read_preflight_size_real]]} {
                rename ::els::read_preflight_size_real ::els::read_preflight_size
            }
        } -body {
    set ::els_test_mbcount 0
    set rc [els::open $p 1]
    list $rc $::els::last_open_outcome [els::deferred_contains $p] \
         $::els_test_mbcount [expr {[llength $::els::docs] == 1 && $::els::docPath($::els::active) eq ""}]
} -result {{} deferred 1 0 1}

test bounded-read-1.2 {foreground post-stat growth prompts once, then consent has no second cap} \
        -setup {
            els_reset
            set ::els::OPEN_WARN_SIZE 5 ; set ::els::IO_CHUNK 4
            set p [els_tmpfile bounded_accept.txt "0123456789abcdef"]
            rename ::els::read_preflight_size ::els::read_preflight_size_real
            proc ::els::read_preflight_size {path} { return 0 }
        } -cleanup {
            set ::els::OPEN_WARN_SIZE 26214400 ; set ::els::IO_CHUNK 1048576
            catch {rename ::els::read_preflight_size {}}
            if {[llength [info commands ::els::read_preflight_size_real]]} {
                rename ::els::read_preflight_size_real ::els::read_preflight_size
            }
        } -body {
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer yes
    set id [els::open $p]
    list [expr {$id ne ""}] $::els_test_mbcount [els_text $id] $::els::last_open_outcome
} -result {1 1 0123456789abcdef opened}

test bounded-read-1.3 {all physical document reads are chunk-bounded even after unlimited consent} \
        -setup {
            els_reset
            set ::els::OPEN_WARN_SIZE 5 ; set ::els::IO_CHUNK 4
            set p [els_tmpfile bounded_chunks.txt "0123456789abcdef"]
            rename ::els::read_preflight_size ::els::read_preflight_size_real
            proc ::els::read_preflight_size {path} { return 0 }
            rename ::read ::_els_real_read
            set ::bounded_read_sizes {}
            proc ::read {fh args} {
                lappend ::bounded_read_sizes $args
                tailcall ::_els_real_read $fh {*}$args
            }
        } -cleanup {
            catch {rename ::read {}}
            if {[llength [info commands ::_els_real_read]]} { rename ::_els_real_read ::read }
            catch {rename ::els::read_preflight_size {}}
            if {[llength [info commands ::els::read_preflight_size_real]]} {
                rename ::els::read_preflight_size_real ::els::read_preflight_size
            }
            set ::els::OPEN_WARN_SIZE 26214400 ; set ::els::IO_CHUNK 1048576
            unset -nocomplain ::bounded_read_sizes
        } -body {
    set ::els_test_mbanswer yes
    set id [els::open $p]
    set bounded 1
    foreach args $::bounded_read_sizes {
        if {[llength $args] != 1 || [lindex $args 0] > 4} { set bounded 0 }
    }
    list [expr {$id ne ""}] $bounded [expr {[llength $::bounded_read_sizes] > 1}]
} -result {1 1 1}

test bounded-read-1.4 {large reload decline preserves buffer, raw bytes, signature, and dirty state; accept is uncapped} \
        -setup {els_reset} -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile bounded_reload.txt "small"]
    set id [els::open $p] ; set w [els::W $id]
    $w insert end " local"
    set before [list [els_text $id] $::els::docRaw($id) $::els::savedSig($id) [els::doc_dirty $id]]
    raw_write $p "a much larger external replacement"
    set ::els::OPEN_WARN_SIZE 5 ; set ::els_test_mbcount 0 ; set ::els_test_mbanswer no
    set declined [els::reload_from_disk $id]
    set afterDecline [list [els_text $id] $::els::docRaw($id) $::els::savedSig($id) [els::doc_dirty $id]]
    set ::els_test_mbanswer yes
    set accepted [els::reload_from_disk $id]
    list $declined [expr {$before eq $afterDecline}] $accepted \
         [els_text $id] $::els_test_mbcount [els::doc_dirty $id]
} -result {0 1 1 {a much larger external replacement} 2 0}

test bounded-read-1.5 {queued duplicate only activates an open dirty document and never discards edits} \
        -setup {els_reset} -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile bounded_reload_deferred.txt "old"]
    set id [els::open $p] ; [els::W $id] insert end " local edits"
    raw_write $p "a much larger replacement"
    set ::els::OPEN_WARN_SIZE 5 ; set ::els_test_mbcount 0
    set quiet [els::reload_from_disk $id 1]
    set queued [els::deferred_contains $p]
    set before [els_text $id]
    set opened [els::open $p 0 0 1]
    list $quiet $queued [expr {$opened eq $id}] [expr {[els_text $id] eq $before}] \
         [els::doc_dirty $id] [els::deferred_contains $p] $::els_test_mbcount
} -result {0 1 1 1 1 0 0}

test channel-close-1.1 {open closes its channel when binary configuration/read throws} -setup {
    els_reset
    rename ::els::_read_binary_prefix ::els::_read_binary_prefix_real
    proc ::els::_read_binary_prefix {fh limit} {
        set ::_els_injected_channel $fh
        error "injected document read failure"
    }
} -cleanup {
    catch {rename ::els::_read_binary_prefix {}}
    if {[llength [info commands ::els::_read_binary_prefix_real]]} {
        rename ::els::_read_binary_prefix_real ::els::_read_binary_prefix
    }
    unset -nocomplain ::_els_injected_channel
} -body {
    set p [els_tmpfile channel_open.txt "content\n"]
    set rc [els::open $p]
    list $rc [expr {$::_els_injected_channel ni [chan names]}] \
         [string match "*injected document read failure*" \
              [dict get $::els_test_mbargs -message]]
} -result {{} 1 1}

test channel-close-1.2 {reload closes its channel on a read failure and leaves the buffer intact} -setup {
    els_reset
    set ::_els_reload_path [els_tmpfile channel_reload.txt "original\n"]
    set ::_els_reload_id [els::open $::_els_reload_path]
    rename ::els::_read_binary_prefix ::els::_read_binary_prefix_real
    proc ::els::_read_binary_prefix {fh limit} {
        set ::_els_injected_channel $fh
        error "injected reload read failure"
    }
} -cleanup {
    catch {rename ::els::_read_binary_prefix {}}
    if {[llength [info commands ::els::_read_binary_prefix_real]]} {
        rename ::els::_read_binary_prefix_real ::els::_read_binary_prefix
    }
    unset -nocomplain ::_els_injected_channel ::_els_reload_path ::_els_reload_id
} -body {
    set before [els_text $::_els_reload_id]
    set rc [els::reload_from_disk $::_els_reload_id]
    list $rc [expr {$::_els_injected_channel ni [chan names]}] \
         [expr {[els_text $::_els_reload_id] eq $before}]
} -result {0 1 1}

test channel-close-1.3 {backup_keep closes its source channel when the read throws} -setup {
    els_reset
    set ::els::backups 1 ; set ::els::BK_MININT 0
    set ::_els_backup_path [els_tmpfile channel_backup.txt "original\n"]
    rename ::els::_read_binary_channel ::els::_read_binary_channel_real
    proc ::els::_read_binary_channel {fh} {
        set ::_els_injected_channel $fh
        error "injected backup read failure"
    }
} -cleanup {
    set ::els::backups 0 ; set ::els::BK_MININT 60
    catch {rename ::els::_read_binary_channel {}}
    if {[llength [info commands ::els::_read_binary_channel_real]]} {
        rename ::els::_read_binary_channel_real ::els::_read_binary_channel
    }
    unset -nocomplain ::_els_injected_channel ::_els_backup_path
} -body {
    els::backup_keep $::_els_backup_path
    set backups [glob -nocomplain -directory [els::backup_dir] *.bak]
    list [expr {$::_els_injected_channel ni [chan names]}] [llength $backups]
} -result {1 0}

# ---- Wave 2: atomic-save-chain hardening (backup-ring glob escape) ---------
# (the temp-rescue-on-fallback-failure path needs a locked target -> winfs.test)

test bkglob-1.1 {glob_escape backslash-escapes glob metacharacters} -body {
    els::glob_escape {report[1]{a}*?.txt}
} -result {report\[1\]\{a\}\*\?.txt}

test bkglob-1.2 {a glob-metachar filename's backup ring is FOUND (freshness-skip works, no per-save churn)} -setup {els_reset} \
        -cleanup {set ::els::backups 0 ; set ::els::BK_MININT 60} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 3600
    set p [els_tmpfile {weird[1].txt} "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "e1" ; els::save     ;# backup #1 (ring was empty)
    [els::W $id] insert end "e2" ; els::save     ;# within BK_MININT: ring found -> SKIP (not churn)
    set dir [els::backup_dir]
    llength [glob -nocomplain -directory $dir "[els::glob_escape [els::backup_stem $p]].*.bak"]
} -result 1

test atomic-1.1 {failed atomic operations retain the complete temp and never call the TRUNC fallback} -setup {
    els_reset
    rename els::_write_inplace _els_real_write_inplace
    rename els::_atomic_rename _els_real_atomic_rename
    proc els::_atomic_rename {args} { error "simulated atomic rename failure" }
    if {[llength [info commands els::win_replace_file]]} { rename els::win_replace_file _els_real_win_replace }
    set ::_els_inplace_calls 0
    proc els::_write_inplace {args} { incr ::_els_inplace_calls ; return "must not run" }
} -cleanup {
    catch {rename els::_write_inplace {}}
    if {[llength [info commands _els_real_write_inplace]]} { rename _els_real_write_inplace els::_write_inplace }
    catch {rename els::_atomic_rename {}}
    if {[llength [info commands _els_real_atomic_rename]]} { rename _els_real_atomic_rename els::_atomic_rename }
    if {[llength [info commands _els_real_win_replace]]} { rename _els_real_win_replace els::win_replace_file }
    catch {file delete -force [file join $::ELS_TMP atomic-target.txt]}
    catch {file delete -force [file join $::ELS_TMP .atomic-rescue.tmp]}
} -body {
    set target [file join $::ELS_TMP atomic-target.txt]
    raw_write $target "original survives"
    set tmp [file join $::ELS_TMP .atomic-rescue.tmp]
    file delete -force $tmp
    set err [els::write_atomic $target "complete new bytes" [file tail $tmp]]
    list $::_els_inplace_calls [raw_read $target] [file exists $tmp] \
         [raw_read $tmp] [expr {[string first $tmp $err] >= 0}]
} -result {0 {original survives} 1 {complete new bytes} 1}

test atomic-1.2 {write_atomic rejects an existing directory for durable and nondurable writes} -setup {
    els_reset
} -body {
    set target [file join $::ELS_TMP atomic-directory-target]
    catch {file delete -force $target}
    file mkdir $target
    set e0 [els::write_atomic $target "payload zero" .dir-target-0.tmp 0]
    set e1 [els::write_atomic $target "payload one"  .dir-target-1.tmp 1]
    list [file isdirectory $target] \
         [string match "*directory*" $e0] [string match "*directory*" $e1] \
         [file exists [file join $target .dir-target-0.tmp]] \
         [file exists [file join $target .dir-target-1.tmp]] \
         [file exists [file join $::ELS_TMP .dir-target-0.tmp]] \
         [file exists [file join $::ELS_TMP .dir-target-1.tmp]]
} -result {1 1 1 0 0 0 0}

# ---- 0.95 hardening regressions (bug-hunt findings) ----------------------
test bk-1.16 {a backward clock step does not delete the just-written newest backup (BK audit)} -setup {els_reset} -cleanup {set ::els::BK_RING 8 ; set ::els::BK_MININT 60} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0 ; set ::els::BK_RING 3
    file mkdir [bk_dir]
    set p [els_tmpfile bkclock.txt "orig\n"]
    set stem [els::backup_stem $p]
    # a full ring whose backups all carry FUTURE mtimes, as after an NTP/VM backward step
    for {set i 1} {$i <= 3} {incr i} {
        set f [file join [bk_dir] "$stem.2099010$i-000000-00000$i.bak"]
        raw_write $f "future$i"
        file mtime $f [expr {[clock seconds] + 100000 + $i}]
    }
    set id [els::open $p]
    [els::W $id] insert end "edit" ; els::save
    # the pre-save "orig" snapshot has a current-time (lowest) mtime; it must survive
    set kept 0
    foreach f [bk_ring $p] { if {[raw_read $f] eq "orig\n"} { set kept 1 } }
    set kept
} -result 1

test bigfile-1.12 {a deferred read tags remote vs oversize so the note is not wrongly "large" (R11)} -setup {els_reset} -cleanup {set ::els::OPEN_WARN_SIZE 26214400 ; catch {file delete -force [els::deferred_path]}} -body {
    set r [els::read_binary_guarded {//server/share/tiny.txt} 1 0]
    set big [els_tmpfile big12.txt [string repeat x 5000]]
    set ::els::OPEN_WARN_SIZE 5
    set l [els::read_binary_guarded $big 1 0]
    list [dict get $r state] [dict get $r reason] [dict get $l state] [dict get $l reason]
} -result {deferred remote deferred large}

test deferred-state-1.5 {a transient read fault preserves the queue instead of quarantining it (R10)} -setup {els_reset} -cleanup {
    # only if the body threw before its own finally restored ::open
    if {[llength [info commands ::_defer_real_open]]} { catch {rename ::open {}} ; rename ::_defer_real_open ::open }
    unset -nocomplain ::_defer_fail
    catch {file delete -force [els::deferred_path]}
    foreach c [glob -nocomplain "[els::deferred_path].corrupt-*"] { catch {file delete -force $c} }
} -body {
    set keep [els_tmpfile deferred-keep.txt "hello"]
    els::deferred_add $keep
    set p [els::deferred_path]
    set before [raw_read $p]
    set ::_defer_fail [file normalize $p]
    rename ::open ::_defer_real_open
    proc ::open {args} {
        if {[file normalize [lindex $args 0]] eq $::_defer_fail} { error "simulated sharing violation" }
        return [uplevel 1 [list ::_defer_real_open {*}$args]]
    }
    set blocked "" ; set exists "" ; set nocorrupt "" ; set noticed ""
    try {
        els::deferred_load
        set blocked $::els::deferred_blocked
        set exists [file exists $p]
        set nocorrupt [expr {[llength [glob -nocomplain "$p.corrupt-*"]] == 0}]
        set noticed [expr {$::els::deferred_notice ne ""}]
    } finally {
        rename ::open {} ; rename ::_defer_real_open ::open
    }
    # raw_read below uses the RESTORED real open
    list $blocked $exists $nocorrupt [expr {[raw_read $p] eq $before}] $noticed
} -result {1 1 1 1 1}

test session-r05-1 {a deferred (network) session file stays in session_pending instead of vanishing (R05)} -setup {els_reset} -cleanup {
    set ::els::session_files {} ; set ::els::session_pending {} ; set ::els::session_active ""
    catch {file delete -force [els::deferred_path]}
} -body {
    set ::els::restore_session 1
    set ::els::session_files [list {//server/share/remote-doc.txt}]
    set ::els::session_active ""
    els::session_restore
    list [llength $::els::session_pending] [string match {*remote-doc.txt} [lindex $::els::session_pending 0]]
} -result {1 1}

test session-r05-2 {a saved session file on a mapped network drive is deferred, never synchronously probed at startup} -setup {
            els_reset
            rename ::els::drive_type ::els::drive_type_real
            proc ::els::drive_type {path} { return remote }
        } -cleanup {
            catch {rename ::els::drive_type {}}
            if {[llength [info commands ::els::drive_type_real]]} { rename ::els::drive_type_real ::els::drive_type }
            set ::els::session_files {} ; set ::els::session_pending {} ; set ::els::session_active ""
            catch {file delete -force [els::deferred_path]}
        } -body {
    set ::els::restore_session 1
    set ::els::session_files [list {Z:/share/mapped-doc.txt}]
    set ::els::session_active ""
    els::session_restore
    list [llength $::els::session_pending] [string match {*mapped-doc.txt} [lindex $::els::session_pending 0]]
} -result {1 1}

test launchfail-1.1 {a failed launch-file open is collected and reported after the UI is up (R12)} -setup {els_reset} -cleanup {
    if {[llength [info commands ::_lf_real_mb]]} { catch {rename ::els::message_box {}} ; rename ::_lf_real_mb ::els::message_box }
    unset -nocomplain ::_lf_msg
} -body {
    set bad [file join $::ELS_TMP does-not-exist-[pid].txt]
    catch {file delete -force $bad}
    els::open $bad 1
    set outcome $::els::last_open_outcome
    rename ::els::message_box ::_lf_real_mb
    set ::_lf_msg ""
    proc ::els::message_box {args} { set ::_lf_msg $args }
    els::report_launch_failures [list $bad]
    rename ::els::message_box {} ; rename ::_lf_real_mb ::els::message_box
    list $outcome [string match {*Could not open*} $::_lf_msg] [string match "*[file tail $bad]*" $::_lf_msg]
} -result {failed 1 1}

test session-end-1.1 {WM_SAVE_YOURSELF (OS logout/shutdown) persists session + autosaves, with no modal or exit} -setup {els_reset} -cleanup {
    if {[llength [info commands ::_se_sg_real]]} { catch {rename ::els::save_geometry {}} ; rename ::_se_sg_real ::els::save_geometry }
    if {[llength [info commands ::_se_aa_real]]} { catch {rename ::els::autosave_all {}} ; rename ::_se_aa_real ::els::autosave_all }
    unset -nocomplain ::_se_sg ::_se_aa
} -body {
    set registered [wm protocol . WM_SAVE_YOURSELF]
    rename ::els::save_geometry ::_se_sg_real ; set ::_se_sg 0
    proc ::els::save_geometry {} { incr ::_se_sg }
    rename ::els::autosave_all ::_se_aa_real ; set ::_se_aa 0
    proc ::els::autosave_all {} { incr ::_se_aa }
    els::session_end                                    ;# must not prompt or exit
    rename ::els::save_geometry {} ; rename ::_se_sg_real ::els::save_geometry
    rename ::els::autosave_all {} ; rename ::_se_aa_real ::els::autosave_all
    list $registered $::_se_sg $::_se_aa
} -result {els::session_end 1 1}

test bk-1.17 {a file over BK_MAXSIZE is not backed up and the user is told once, not on every save} -setup {els_reset} -cleanup {set ::els::BK_MAXSIZE 20971520 ; set ::els::backup_size_noted {}} -body {
    set ::els::backups 1 ; set ::els::BK_MAXSIZE 4 ; set ::els::backup_size_noted {}
    file mkdir [bk_dir]
    set p [els_tmpfile bkbig.txt "0123456789"]          ;# 10 bytes > the 4-byte cap
    .sb.name configure -text ""
    els::backup_keep $p
    set noBackup [expr {[llength [bk_ring $p]] == 0}]
    set noted [string match "*too large*" [.sb.name cget -text]]
    catch {after cancel $::els::status_note_after} ; set ::els::status_note_after ""
    .sb.name configure -text "quiet"
    els::backup_keep $p                                 ;# same file again: no re-nag
    set silent2 [expr {[.sb.name cget -text] eq "quiet"}]
    list $noBackup $noted $silent2
} -result {1 1 1}

test deferred-state-1.6 {oversized deferred-open state is quarantined like other corruption} -setup {els_reset} -cleanup {
    catch {file delete -force [els::deferred_path]}
    foreach c [glob -nocomplain "[els::deferred_path].corrupt-*"] { catch {file delete -force $c} }
} -body {
    set p [els::deferred_path]
    set fh [open $p wb] ; puts -nonewline $fh [string repeat a [expr {$::els::DEFERRED_MAX_BYTES + 1}]] ; close $fh
    els::deferred_load
    list $::els::deferred_blocked [file exists $p] \
         [expr {[llength [glob -nocomplain "$p.corrupt-*"]] > 0}] \
         [llength $::els::deferred_files] [expr {$::els::deferred_notice ne ""}]
} -result {0 0 1 0 1}
