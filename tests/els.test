# tests/els.test — behaviour tests for els, driven in-process against the real
# Tk widgets.  Run via `tests/run.tcl` (or directly with tclsh90).

source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::test

# ---- startup ------------------------------------------------------------
test start-1.1 {fresh els has exactly one untitled document} -setup {els_reset} -body {
    list [llength $::els::docs] [els::doc_name [lindex $::els::docs 0]] $::els::active
} -result {1 untitled d0}

# ---- tabs ---------------------------------------------------------------
test tab-1.1 {new_doc adds a tab and makes it active} -setup {els_reset} -body {
    set id [els::new_doc]
    list [llength $::els::docs] [expr {$::els::active eq $id}] [winfo exists [els::tabW $id]]
} -result {2 1 1}

test tab-1.2 {cycle steps through documents in order and wraps} -setup {els_reset} -body {
    els::new_doc ; els::new_doc   ;# d0 d1 d2, active d2
    set seen {}
    els::cycle 1  ; lappend seen $::els::active   ;# wrap -> d0
    els::cycle 1  ; lappend seen $::els::active   ;# d1
    els::cycle -1 ; lappend seen $::els::active   ;# d0
    set seen
} -result {d0 d1 d0}

test tab-1.3 {active tab shows the page colour, inactive shows grey} -setup {els_reset} -body {
    set a [lindex $::els::docs 0]
    set b [els::new_doc]   ;# active b
    list [[els::tabW $b].name cget -bg] [[els::tabW $a].name cget -bg]
} -result [list $::els::TABON $::els::TABOFF]

# ---- closing ------------------------------------------------------------
test close-1.1 {closing the active document switches to a neighbour} -setup {els_reset} -body {
    set b [els::new_doc]
    els::close_doc $b
    list [llength $::els::docs] $::els::active
} -result {1 d0}

test close-1.2 {closing the last document leaves a fresh untitled one} -setup {els_reset} -body {
    els::close_doc [lindex $::els::docs 0]
    list [llength $::els::docs] [els::pristine $::els::active]
} -result {1 1}

test close-1.3 {closing a non-active document leaves the active one untouched} -setup {els_reset} -body {
    set a [lindex $::els::docs 0]
    set b [els::new_doc]   ;# active b
    els::close_doc $a      ;# close the inactive one
    list [llength $::els::docs] $::els::active
} -result {1 d1}

# ---- open ---------------------------------------------------------------
test open-1.1 {open reuses a pristine untitled tab} -setup {els_reset} -body {
    set f [els_tmpfile open1.txt "alpha\nbeta\n"]
    set before [llength $::els::docs]
    els::open $f
    list $before [llength $::els::docs] [els::doc_name $::els::active] [[els::T] get 1.0 1.end]
} -result {1 1 open1.txt alpha}

test open-1.2 {open uses a new tab when the current document is not pristine} -setup {els_reset} -body {
    [els::T] insert end "dirty"
    set f [els_tmpfile open2.txt "zzz\n"]
    els::open $f
    list [llength $::els::docs] [els::doc_name $::els::active]
} -result {2 open2.txt}

test open-1.3 {open multiple files, one document each} -setup {els_reset} -body {
    set f1 [els_tmpfile multi1.txt "111\n"]
    set f2 [els_tmpfile multi2.txt "222\n"]
    els::open $f1
    els::open $f2
    list [llength $::els::docs] \
        [els::doc_name [lindex $::els::docs 0]] [els::doc_name [lindex $::els::docs 1]]
} -result {2 multi1.txt multi2.txt}

# ---- save ---------------------------------------------------------------
test save-1.1 {save writes the buffer and clears the dirty flag} -setup {els_reset} -body {
    set f [file join $::ELS_TMP saveme.txt]
    [els::T] insert end "save this"
    set ::els::docPath($::els::active) $f
    els::save
    set fh [::open $f r]; fconfigure $fh -encoding utf-8; set c [read $fh]; close $fh
    list [els::doc_dirty $::els::active] $c
} -result {0 {save this}}

# ---- dirty tracking -----------------------------------------------------
test dirty-1.1 {an edit marks the document dirty and bullets the tab} -setup {els_reset} -body {
    set clean [els::doc_dirty $::els::active]
    [els::T] insert end "x"
    list $clean [els::doc_dirty $::els::active] [els::tab_text $::els::active]
} -result {0 1 {• untitled}}

# ---- user-issues batch A ---------------------------------------------------

test issue-a.8 {new documents default to the platform EOL (CRLF on Windows)} -setup {els_reset} -body {
    set id [els::new_doc]
    set eol $::els::docEol($id)
    [els::W $id] insert end "one\ntwo"
    set ::els_test_savefile [file join $::ELS_TMP ia8.txt]
    els::switch_to $id ; els::save
    list $eol [string match "*one\r\ntwo*" [raw_read [file join $::ELS_TMP ia8.txt]]]
} -result {crlf 1}

test issue-a.9 {files opened from disk keep their detected EOL (no CRLF takeover)} -setup {els_reset} -body {
    set p [file join $::ELS_TMP ia9.txt] ; raw_write $p "a\nb\n"
    els::open $p
    [els::T] insert end "c"
    els::save
    list $::els::docEol($::els::active) [raw_read $p]
} -result [list lf "a\nb\nc"]

# ---- bug-hunt wave 4: numeric-looking names + failed-open behavior --------

test name-4.1 {numeric-looking file names are not canonicalized (007 stays 007, nan does not throw)} -setup {els_reset} -body {
    set d [els::new_doc]
    set ::els::docPath($d) [file join $::ELS_TMP 007]
    set a [els::doc_name $d]
    set ::els::docPath($d) [file join $::ELS_TMP nan]
    set b [els::doc_name $d]
    list $a $b
} -result {007 nan}

test name-4.2 {a doc named nan survives the full edit/update path (no bgerror storm)} -setup {els_reset} -body {
    set d [els::new_doc]
    set ::els::docPath($d) [file join $::ELS_TMP nan]
    [els::W $d] insert end "x"      ;# fires on_modified -> update_tab -> doc_name
    update
    list [els::tab_text $d] [llength $::els_test_bgerrors]
} -result {{• nan} 0}

test openfail-4.1 {a failed open keeps a pre-existing pristine tab} -setup {els_reset} -body {
    els::open [els_tmpfile of1.txt "data\n"]
    set d1 [els::new_doc]                        ;# the user's fresh empty tab
    set before $::els::docs
    els::open [file join $::ELS_TMP no_such_dir_xyz missing.txt] 1
    list [expr {$::els::docs eq $before}] [expr {$::els::active eq $d1}]
} -result {1 1}

test openfail-4.2 {a failed open closes only the doc it created and restores focus} -setup {els_reset} -body {
    els::open [els_tmpfile of2a.txt "A\n"] ; set da $::els::active
    els::open [els_tmpfile of2b.txt "B\n"]
    els::switch_to $da
    set before $::els::docs
    els::open [file join $::ELS_TMP no_such_dir_xyz missing.txt] 1
    list [expr {$::els::docs eq $before}] [expr {$::els::active eq $da}]
} -result {1 1}

# ---- per-document undo independence -------------------------------------
test undo-1.1 {undo in one document does not affect another} -setup {els_reset} -body {
    set d0 $::els::active
    [els::W $d0] insert end "AAA"
    set d1 [els::new_doc]
    [els::W $d1] insert end "BBB"
    [els::W $d1] edit undo
    list [els_text $d0] [els_text $d1]
} -result {AAA {}}

# ---- current-line + gutter ----------------------------------------------
test view-1.1 {current-line tag follows the cursor} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "one\ntwo\nthree\n"
    $w mark set insert 2.0
    els::refresh_view
    $w tag ranges currentLine
} -result {2.0 3.0}

test view-1.2 {gutter line count tracks the buffer} -setup {els_reset} -body {
    [els::T] insert end "a\nb\nc\n"
    els::refresh_view
    els::line_count
} -result 4

# ---- key bindings (driven through Tk's real event path) -----------------
test bind-1.1 {Ctrl+N opens a new tab} -setup {els_reset} -body {
    set before [llength $::els::docs]
    event generate [els::T] <Control-n>
    update
    expr {[llength $::els::docs] - $before}
} -result 1

test bind-1.2 {Ctrl+W closes the current (clean) tab} -setup {els_reset} -body {
    els::new_doc
    update   ;# realize the new widget before targeting it with a synthetic event
    set before [llength $::els::docs]
    event generate [els::T] <Control-w>
    update
    expr {$before - [llength $::els::docs]}
} -result 1

# ---- unicode round-trip -------------------------------------------------
test unicode-1.1 {utf-8 content survives an open} -setup {els_reset} -body {
    set f [els_tmpfile uni.txt "café ☕ 日本\n"]
    els::open $f
    [els::T] get 1.0 1.end
} -result {café ☕ 日本}

# ---- closing a DIRTY document (the yes/no/cancel prompt) -----------------
# close_doc prompts yesnocancel when the doc is dirty: cancel aborts, yes
# saves-then-closes, no discards-then-closes, and "yes" whose Save As is
# cancelled leaves the doc open and dirty.
test close-2.1 {closing a dirty doc, answering yes, saves it then closes} -setup {els_reset} -body {
    set f [file join $::ELS_TMP closeyes.txt]
    set d $::els::active
    [els::W $d] insert end "keep me"
    set ::els::docPath($d) $f
    set ::els_test_mbanswer yes
    els::close_doc $d
    set fh [::open $f r]; fconfigure $fh -encoding utf-8; set c [read $fh]; close $fh
    list [lsearch -exact $::els::docs $d] [string trim $c]
} -result {-1 {keep me}}

test close-2.2 {closing a dirty doc, answering no, discards and closes} -setup {els_reset} -body {
    set f [file join $::ELS_TMP closeno.txt]
    set d $::els::active
    [els::W $d] insert end "discard me"
    set ::els::docPath($d) $f
    set ::els_test_mbanswer no
    els::close_doc $d
    list [lsearch -exact $::els::docs $d] [file exists $f]
} -result {-1 0}

test close-2.3 {closing a dirty doc, answering cancel, keeps it open and dirty} -setup {els_reset} -body {
    set d $::els::active
    [els::W $d] insert end "unsaved"
    set ::els_test_mbanswer cancel
    els::close_doc $d
    list [expr {[lsearch -exact $::els::docs $d] >= 0}] [els::doc_dirty $d]
} -result {1 1}

test close-2.4 {dirty untitled, yes, but Save As cancelled -> stays open and dirty} -setup {els_reset} -body {
    set d $::els::active
    [els::W $d] insert end "no path yet"
    set ::els_test_mbanswer yes
    set ::els_test_savefile ""    ;# Save As dialog cancelled
    els::close_doc $d
    list [expr {[lsearch -exact $::els::docs $d] >= 0}] [els::doc_dirty $d]
} -result {1 1}

# ---- quit ----------------------------------------------------------------
# quit loops dirty docs (same prompt); a cancel aborts BEFORE save_geometry +
# exit, so it is safe to drive directly.  The paths that proceed end in `exit`,
# so those tests stub exit (restored in -cleanup) and assert it was reached.
test quit-1.1 {quit with a dirty doc, answering cancel, aborts and keeps everything} -setup {els_reset} -body {
    set d $::els::active
    [els::W $d] insert end "unsaved work"
    set ::els_test_mbanswer cancel
    els::quit
    list [expr {[lsearch -exact $::els::docs $d] >= 0}] [els::doc_dirty $d]
} -result {1 1}

test quit-1.2 {quit with clean docs saves geometry and exits} -setup {
    els_reset
    rename ::exit ::els_test_real_exit
    set ::els_test_exited 0
    proc ::exit {args} { set ::els_test_exited 1 }
} -body {
    els::quit
    set ::els_test_exited
} -cleanup {
    rename ::exit {} ; rename ::els_test_real_exit ::exit
} -result 1

test quit-1.3 {quit, dirty doc answered no, discards and still exits} -setup {
    els_reset
    rename ::exit ::els_test_real_exit
    set ::els_test_exited 0
    proc ::exit {args} { set ::els_test_exited 1 }
    set ::els_test_mbanswer no
} -body {
    [els::W $::els::active] insert end "discard on quit"
    els::quit
    set ::els_test_exited
} -cleanup {
    rename ::exit {} ; rename ::els_test_real_exit ::exit
} -result 1

# ---- Save As / save-with-encoding ---------------------------------------
test saveas-1.1 {Save As writes a new file, sets the path, clears dirty, records recent} -setup {els_reset} -body {
    set f [file join $::ELS_TMP saveas_new.txt]
    set d $::els::active
    [els::W $d] insert end "brand new"
    set ::els_test_savefile $f
    els::saveas
    set fh [::open $f r]; fconfigure $fh -encoding utf-8; set c [read $fh]; close $fh
    list [els::same_path $::els::docPath($d) $f] [els::doc_dirty $d] [string trim $c] \
         [els::same_path [lindex $::els::recent 0] $f]
} -result {1 0 {brand new} 1}

test saveas-1.2 {Save As cancelled writes nothing, leaves the doc untitled and dirty} -setup {els_reset} -body {
    set d $::els::active
    [els::W $d] insert end "still unsaved"
    set ::els_test_savefile ""
    els::saveas
    list $::els::docPath($d) [els::doc_dirty $d]
} -result {{} 1}

test saveas-1.3 {Save As write failure keeps the old path and does not add a recent} -setup {els_reset} -body {
    set old [els_tmpfile saveas_old.txt "old\n"]
    set d [els::open $old]
    set beforeRecent $::els::recent
    [els::W $d] insert end "edited"
    set bad [file join $::ELS_TMP missing_dir saveas_failed.txt]
    catch {file delete -force [file dirname $bad]}
    set ::els_test_savefile $bad
    set ok [els::saveas]
    list $ok [els::same_path $::els::docPath($d) $old] \
         [els::doc_dirty $d] [expr {$::els::recent eq $beforeRecent}] \
         [file exists $bad]
} -result {0 1 1 1 0}

# save_with only changes the encoding + marks dirty; the next save writes the
# bytes.  Pick UTF-16LE+BOM on a utf-8 doc, then save, and check the file bytes.
test save-2.1 {save_with a new encoding, then save, writes that encoding's bytes} -setup {els_reset} -body {
    set f [file join $::ELS_TMP savewith.txt]
    set d $::els::active
    [els::W $d] insert end "hello"
    set ::els::docPath($d) $f
    els::save                      ;# first write as the default utf-8
    els::save_with utf-16le 1      ;# choose UTF-16LE + BOM -> marks dirty only
    set dirtyAfterPick [els::doc_dirty $d]
    els::save                      ;# now the bytes get rewritten in the new encoding
    set fh [::open $f rb]; set raw [read $fh]; close $fh
    binary scan $raw H4 bomhex
    set body [encoding convertfrom utf-16le [string range $raw 2 end]]
    list $dirtyAfterPick $bomhex $body [els::doc_dirty $d]
} -result {1 fffe hello 0}

# ---- auto-save (opt-in) ------------------------------------------------------

# Scaffold: a saved file whose buffer then gains an edit, with auto-save on.
proc as_doc {name} {
    set p [els_tmpfile $name "base\n"]
    set id [els::open $p]
    set ::els::autosave 1
    [els::W $id] insert end "edit"
    return $id
}

test as-1.1 {auto-save is OFF by default and lives in the File menu} -setup {els_reset} -body {
    set found 0
    for {set i 0} {$i <= [.menu.file index end]} {incr i} {
        if {[.menu.file type $i] eq "checkbutton" &&
            [.menu.file entrycget $i -label] eq "Auto-save"} { set found 1 }
    }
    list $::els::autosave $found
} -result {0 1}

test as-1.2 {an edit schedules a debounced flush that saves the file} -setup {els_reset} -body {
    set id [as_doc as12.txt]
    [els::W $id] edit modified 1 ; update      ;# fire <<Modified>> -> autosave_soon
    set scheduled [expr {$::els::autosave_after ne ""}]
    els::autosave_flush_pending                 ;# what the timer runs
    list $scheduled [els::doc_dirty $id] [raw_read $::els::docPath($id)]
} -result [list 1 0 "base\nedit"]

test as-1.3 {untitled documents are never auto-saved (no dialog, no file)} -setup {els_reset} -body {
    set id [els::new_doc]
    set ::els::autosave 1
    [els::W $id] insert end "note"
    els::autosave_flush_doc $id
    list [els::doc_dirty $id] $::els_test_save_args
} -result {1 {}}

test as-1.4 {switching tabs flushes the document being left} -setup {els_reset} -body {
    set id [as_doc as14.txt]
    set other [els::new_doc]
    els::switch_to $other
    list [els::doc_dirty $id] [raw_read $::els::docPath($id)]
} -result [list 0 "base\nedit"]

test as-1.5 {losing the app window focus flushes everything} -setup {els_reset} -body {
    set id [as_doc as15.txt]
    event generate . <Deactivate>
    update
    list [els::doc_dirty $id] [raw_read $::els::docPath($id)]
} -result [list 0 "base\nedit"]

test as-1.6 {closing a pathed doc with auto-save on saves it without a prompt} -setup {els_reset} -body {
    set id [as_doc as16.txt]
    set p $::els::docPath($id)
    els::close_doc $id
    list $::els_test_mbcount [expr {$id in $::els::docs}] [raw_read $p]
} -result [list 0 0 "base\nedit"]

test as-1.7 {a failing auto-save stays quiet: statusbar note, no dialog, still dirty} -setup {els_reset} -body {
    set id [as_doc as17.txt]
    # an unopenable target: the parent directory does not exist
    set ::els::docPath($id) [file join $::ELS_TMP no-such-dir as17.txt]
    els::autosave_flush_doc $id
    list $::els_test_mbcount [els::doc_dirty $id] \
        [string match "auto-save failed:*" [.sb.name cget -text]]
} -result {0 1 1}

test as-1.8 {an unencodable char pauses auto-save until a manual save settles it} -setup {els_reset} -body {
    set id [as_doc as18.txt]
    set ::els::docEnc($id) ascii
    [els::W $id] insert end "é"
    els::autosave_flush_doc $id
    set paused [info exists ::els::docLossyPause($id)]
    set untouched [raw_read $::els::docPath($id)]
    els::autosave_flush_doc $id                 ;# paused: silently skipped
    set ::els_test_lossy_answer utf8
    set ok [els::save]                          ;# the manual save settles it
    els::autosave_flush_doc $id
    list $paused $untouched $ok [info exists ::els::docLossyPause($id)] [els::doc_dirty $id]
} -result [list 1 "base\n" 1 0 0]

test as-1.9 {the auto-save choice persists through the config round-trip} -setup {els_reset} -body {
    set ::els::autosave 1
    els::save_geometry
    set ::els::autosave 0
    els::load_geometry
    set v $::els::autosave
    catch {file delete -force $::els::config_path}
    set v
} -result 1

test as-1.10 {turning auto-save ON saves dirty pathed documents immediately} -setup {els_reset} -body {
    set p [els_tmpfile as110.txt "base\n"]
    set id [els::open $p]
    [els::W $id] insert end "now"
    set ::els::autosave 1                       ;# what the menu checkbutton does...
    els::set_autosave 0                         ;# ...then its -command (no persist)
    list [els::doc_dirty $id] [raw_read $p]
} -result [list 0 "base\nnow"]

# ---- backups: previous versions ---------------------------------------------

proc bk_dir {} { return [file join [file dirname $::els::config_path] backups] }
proc bk_ring {p} { lsort [glob -nocomplain -directory [bk_dir] "[els::backup_stem $p].*.bak"] }

test bk-1.1 {an overwriting save preserves the previous version} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0
    set p [els_tmpfile bk11.txt "version one\n"]
    set id [els::open $p]
    [els::W $id] insert end "and two"
    els::save
    set ring [bk_ring $p]
    list [llength $ring] [raw_read [lindex $ring 0]] [string match "*and two*" [raw_read $p]]
} -result [list 1 "version one\n" 1]

test bk-1.2 {the first save of a new file makes no backup (nothing to preserve)} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0
    set id [els::new_doc]
    [els::W $id] insert end "fresh"
    set p [file join $::ELS_TMP bk12.txt]
    catch {file delete -force $p}      ;# truly new: not left over from a prior run
    set ::els_test_savefile $p
    els::save
    list [file exists $p] [llength [bk_ring $p]]
} -result {1 0}

test bk-1.3 {the ring keeps only the newest BK_RING versions} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0 ; set ::els::BK_RING 3
    set p [els_tmpfile bk13.txt "v0\n"]
    set id [els::open $p]
    for {set i 1} {$i <= 6} {incr i} {
        [els::W $id] insert end "v$i\n"
        els::save
    }
    set ring [bk_ring $p]
    # not just the COUNT: the ring must keep the newest three, so its lsort-newest
    # entry is the last backup taken (whose pre-save content ended with v5).  Under
    # the old same-second suffix ordering the unsuffixed name sorted last, so the
    # "newest" was actually the very first (pre-v0) backup — pruning kept the wrong end.
    list [llength $ring] [string match "*v5\n" [raw_read [lindex $ring end]]]
} -result {3 1}

test bk-1.4 {a fresh newest backup suppresses churn (min spacing)} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 3600
    set p [els_tmpfile bk14.txt "original\n"]
    set id [els::open $p]
    [els::W $id] insert end "a" ; els::save
    [els::W $id] insert end "b" ; els::save
    [els::W $id] insert end "c" ; els::save
    set ring [bk_ring $p]
    # one backup only, and it is the PRE-burst version
    list [llength $ring] [raw_read [lindex $ring 0]]
} -result [list 1 "original\n"]

test bk-1.5 {auto-save also produces backups} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0 ; set ::els::autosave 1
    set p [els_tmpfile bk15.txt "base\n"]
    set id [els::open $p]
    [els::W $id] insert end "auto"
    els::autosave_flush_doc $id
    list [llength [bk_ring $p]] [raw_read [lindex [bk_ring $p] 0]]
} -result [list 1 "base\n"]

test bk-1.6 {backups off means no backup} -setup {els_reset} -body {
    set ::els::backups 0
    set p [els_tmpfile bk16.txt "one\n"]
    set id [els::open $p]
    [els::W $id] insert end "two" ; els::save
    list [llength [bk_ring $p]] [string match "*two*" [raw_read $p]]
} -result {0 1}

test bk-1.7 {a failing backup is a quiet note, the save still succeeds} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0
    # make the backups DIR path unusable: a plain file sits where the dir goes
    raw_write [bk_dir] "not a directory"
    set p [els_tmpfile bk17.txt "one\n"]
    set id [els::open $p]
    [els::W $id] insert end "two"
    set ok [els::save]
    set note [string match "backup failed:*" [.sb.name cget -text]]
    file delete -force [bk_dir]
    list $ok [string match "*two*" [raw_read $p]] $note $::els_test_mbcount
} -result {1 1 1 0}

test bk-1.8 {old backups age out via the sweep} -setup {els_reset} -body {
    set ::els::backups 1
    file mkdir [bk_dir]
    set old [file join [bk_dir] "old.txt.00000000.20250101-000000.bak"]
    raw_write $old "ancient"
    file mtime $old [expr {[clock seconds] - $::els::BK_MAXAGE - 100}]
    set fresh [file join [bk_dir] "new.txt.00000000.20990101-000000.bak"]
    raw_write $fresh "recent"
    set ::els::swap_enabled 1
    els::swap_sweep
    set ::els::swap_enabled 0
    list [file exists $old] [file exists $fresh]
} -result {0 1}

test bk-1.9 {the Keep Backups choice persists through the config round-trip} -setup {els_reset} -body {
    set ::els::backups 0
    els::save_geometry
    set ::els::backups 1
    els::load_geometry
    set v $::els::backups
    catch {file delete -force $::els::config_path}
    set v
} -result 0

test bk-1.10 {menu carries Keep Backups and Open Backups Folder} -setup {els_reset} -body {
    set cb 0 ; set cmd 0
    for {set i 0} {$i <= [.menu.file index end]} {incr i} {
        set t [.menu.file type $i]
        if {$t in {command checkbutton}} {
            switch -- [.menu.file entrycget $i -label] {
                "Keep Backups"        { set cb 1 }
                "Open Backups Folder" { set cmd 1 }
            }
        }
    }
    list $cb $cmd
} -result {1 1}

test bk-1.11 {same-named files in different folders keep separate rings} -setup {els_reset} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 0
    file mkdir [file join $::ELS_TMP bkA] [file join $::ELS_TMP bkB]
    set pa [file join $::ELS_TMP bkA same.txt] ; raw_write $pa "AAA\n"
    set pb [file join $::ELS_TMP bkB same.txt] ; raw_write $pb "BBB\n"
    set ia [els::open $pa] ; [els::W $ia] insert end "a" ; els::save
    set ib [els::open $pb] ; els::switch_to $ib ; [els::W $ib] insert end "b" ; els::save
    list [raw_read [lindex [bk_ring $pa] 0]] [raw_read [lindex [bk_ring $pb] 0]]
} -result [list "AAA\n" "BBB\n"]

# ---- R3: external-change (lost-update) guard ------------------------------
# Another program rewrites the open file on disk; saving must not silently
# clobber that change.  raw_write with different-length content guarantees the
# file signature (size:mtime:crc) differs regardless of mtime granularity.

test extmod-1.1 {a manual save over an externally-changed file PROMPTS} -setup {els_reset} -body {
    set p [els_tmpfile em1.txt "original content\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "my local edit"
    raw_write $p "EXTERNALLY REWRITTEN BY ANOTHER PROGRAM\n"
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer cancel
    set rc [els::save]
    list $rc $::els_test_mbcount
} -result {0 1}

test extmod-1.2 {Cancel preserves the external bytes on disk (no clobber)} -setup {els_reset} -body {
    set p [els_tmpfile em2.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local"
    raw_write $p "EXTERNAL VERSION\n"
    set ::els_test_mbanswer cancel
    els::save
    expr {[raw_read $p] eq "EXTERNAL VERSION\n"}
} -result 1

test extmod-1.3 {Overwrite (Yes) clobbers the disk version with our buffer} -setup {els_reset} -body {
    set p [els_tmpfile em3.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] delete 1.0 end ; [els::W $id] insert end "our content"
    raw_write $p "EXTERNAL\n"
    set ::els_test_mbanswer yes
    set rc [els::save]
    list $rc [string match "*our content*" [raw_read $p]]
} -result {1 1}

test extmod-1.4 {Reload (No) discards our edits and re-reads disk} -setup {els_reset} -body {
    set p [els_tmpfile em4.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local junk"
    raw_write $p "THE REAL DISK CONTENT"
    set ::els_test_mbanswer no
    els::save
    list [els::doc_dirty $id] [[els::W $id] get 1.0 "end - 1 char"]
} -result {0 {THE REAL DISK CONTENT}}

test extmod-1.5 {autosave (quiet) NEVER prompts on external change; it pauses instead} -setup {els_reset} -body {
    set p [els_tmpfile em5.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local"
    raw_write $p "EXTERNAL\n"
    set ::els_test_mbcount 0
    set rc [els::save $id 1]
    list $rc $::els_test_mbcount [info exists ::els::docExtModPause($id)] \
         [expr {[raw_read $p] eq "EXTERNAL\n"}]
} -result {0 0 1 1}

test extmod-1.6 {a normal save does NOT prompt: our own prior save must not false-positive} -setup {els_reset} -body {
    set p [els_tmpfile em6.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "edit one"
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer yes
    set r1 [els::save]
    [els::W $id] insert end " edit two"
    set r2 [els::save]
    list $r1 $r2 $::els_test_mbcount
} -result {1 1 0}

test extmod-1.7 {Save As onto a different existing file does not trigger the external-change prompt} -setup {els_reset} -body {
    set p [els_tmpfile em7a.txt "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "content"
    set other [els_tmpfile em7b.txt "different existing file\n"]
    set ::els_test_savefile $other
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer yes
    els::saveas
    set ::els_test_mbcount
} -result 0

test extmod-1.8 {reload_from_disk re-reads FRESH bytes from disk, not the cached docRaw} -setup {els_reset} -body {
    set p [els_tmpfile em8.txt "original disk content"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "X"
    raw_write $p "BRAND NEW DISK CONTENT"
    els::reload_from_disk $id
    list [els::doc_dirty $id] [[els::W $id] get 1.0 "end - 1 char"]
} -result {0 {BRAND NEW DISK CONTENT}}

test extmod-1.9 {a byte-identical external rewrite (mtime-only bump) does NOT prompt or pause} -setup {els_reset} -body {
    set p [els_tmpfile em9.txt "identical bytes\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local edit"
    # rewrite the SAME bytes (OneDrive/AV/backup touch) then bump mtime past open
    raw_write $p "identical bytes\n"
    file mtime $p [expr {[file mtime $p] + 5}]
    set ::els_test_mbcount 0
    set rc [els::save $id]
    list $rc $::els_test_mbcount [info exists ::els::docExtModPause($id)]
} -result {1 0 0}

# ---- bug-hunt wave 2: the >CRC-cap external-change blind spot (F05) ---------
# Above SWAP_FILE_CRC_CAP a file signature's crc is SAMPLED (first + last 64 KiB),
# so a size-preserving rewrite of the MIDDLE leaves size+crc identical.  mtime,
# dropped from the content key for exact (<=cap) sigs to avoid byte-identical
# false positives, is the only remaining signal there — sig_content must keep it
# above the cap, or a manual save silently clobbers the external change.

test extmod-1.10 {sig_content keeps mtime above the cap, drops it at/under (unit)} -body {
    set cap $::els::SWAP_FILE_CRC_CAP
    list [els::sig_content "1000:111:222"] \
         [els::sig_content "[expr {$cap + 1}]:111:222"] \
         [expr {[els::sig_content "[expr {$cap+1}]:111:222"] ne \
                [els::sig_content "[expr {$cap+1}]:999:222"]}] \
         [expr {[els::sig_content "1000:111:222"] eq [els::sig_content "1000:999:222"]}]
} -result {1000:222 16777217:111:222 1 1}

test extmod-1.11 {a same-size middle rewrite of a >cap file PROMPTS (no silent clobber)} \
        -setup {els_reset} -cleanup {set ::els::SWAP_FILE_CRC_CAP 16777216} -body {
    # 200 KB file so head[0:64K]+tail[end-64K:] leave a genuine unsampled middle;
    # lower the cap so this modest fixture takes the sampled path.
    set ::els::SWAP_FILE_CRC_CAP 100000
    set base [string repeat A 200000]
    set p [els_tmpfile big_mid.txt $base]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local edit"
    # external program rewrites 20 bytes at the true middle, size preserved
    raw_write $p [string replace $base 100000 100019 [string repeat B 20]]
    file mtime $p [expr {[file mtime $p] + 5}]
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer cancel
    set rc [els::save $id]
    list $rc $::els_test_mbcount
} -result {0 1}

test extmod-1.12 {a head-window rewrite of a >cap file still PROMPTS (control: crc-visible)} \
        -setup {els_reset} -cleanup {set ::els::SWAP_FILE_CRC_CAP 16777216} -body {
    set ::els::SWAP_FILE_CRC_CAP 100000
    set base [string repeat A 200000]
    set p [els_tmpfile big_head.txt $base]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "local edit"
    raw_write $p [string replace $base 100 119 [string repeat B 20]]   ;# inside head 64 KiB
    file mtime $p [expr {[file mtime $p] + 5}]
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer cancel
    els::save $id
    set ::els_test_mbcount
} -result 1

# ---- P2-c: large-file open guard + bounded undo (Wave 2) -------------------
# The threshold is lowered per-test (a real 25 MB fixture would be slow + litter);
# -cleanup restores a large threshold so later tests never spuriously prompt.

test bigfile-1.1 {a large-file open PROMPTS interactively; declining creates no tab} -setup {els_reset} \
        -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile big1.txt "0123456789 — more than five bytes\n"]
    set ::els::OPEN_WARN_SIZE 5
    set before [llength $::els::docs]
    set ::els_test_mbcount 0 ; set ::els_test_mbanswer no
    set rc [els::open $p]
    list $rc $::els_test_mbcount [expr {[llength $::els::docs] == $before}]
} -result {{} 1 1}

test bigfile-1.2 {accepting the large-file prompt opens the file} -setup {els_reset} \
        -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile big2.txt "large content here\n"]
    set ::els::OPEN_WARN_SIZE 5 ; set ::els_test_mbanswer yes
    set id [els::open $p]
    list [expr {$id ne ""}] [els::same_path $::els::docPath($id) $p]
} -result {1 1}

test bigfile-1.3 {the quiet path (session restore / recovery) opens a large file WITHOUT prompting} -setup {els_reset} \
        -cleanup {set ::els::OPEN_WARN_SIZE 26214400} -body {
    set p [els_tmpfile big3.txt "restored large file\n"]
    set ::els::OPEN_WARN_SIZE 5 ; set ::els_test_mbcount 0
    set id [els::open $p 1]                 ;# quiet=1
    list [expr {$id ne ""}] $::els_test_mbcount
} -result {1 0}

test bigfile-1.4 {a normal (under-threshold) open never prompts} -setup {els_reset} -body {
    set p [els_tmpfile smallish.txt "small\n"]
    set ::els_test_mbcount 0
    els::open $p
    set ::els_test_mbcount
} -result 0

test bigfile-1.5 {documents are created with a bounded undo stack (-maxundo)} -setup {els_reset} -body {
    expr {[[els::T] cget -maxundo] == $::els::MAXUNDO && $::els::MAXUNDO > 0}
} -result 1

test bigfile-1.6 {a throw during decode/insert (e.g. OOM) restores the busy cursor, never strands it} -setup {els_reset} -body {
    set p [els_tmpfile big6.txt "content\n"]
    rename els::decode _els_decode_real
    proc els::decode {args} { error "simulated OOM in decode" }
    catch {. configure -cursor ""}          ;# baseline
    set rc [els::open $p]                     ;# decode throws inside the read/insert block
    list $rc [. cget -cursor]                 ;# "" = open failed cleanly, cursor NOT stuck on "watch"
} -cleanup {
    if {[llength [info commands _els_decode_real]]} { catch {rename els::decode {}} ; rename _els_decode_real els::decode }
    catch {. configure -cursor ""}
} -result {{} {}}

# ---- Wave 2: atomic-save-chain hardening (backup-ring glob escape) ---------
# (the temp-rescue-on-fallback-failure path needs a locked target -> winfs.test)

test bkglob-1.1 {glob_escape backslash-escapes glob metacharacters} -body {
    els::glob_escape {report[1]{a}*?.txt}
} -result {report\[1\]\{a\}\*\?.txt}

test bkglob-1.2 {a glob-metachar filename's backup ring is FOUND (freshness-skip works, no per-save churn)} -setup {els_reset} \
        -cleanup {set ::els::backups 0 ; set ::els::BK_MININT 60} -body {
    set ::els::backups 1 ; set ::els::BK_MININT 3600
    set p [els_tmpfile {weird[1].txt} "original\n"]
    els::open $p ; set id $::els::active
    [els::W $id] insert end "e1" ; els::save     ;# backup #1 (ring was empty)
    [els::W $id] insert end "e2" ; els::save     ;# within BK_MININT: ring found -> SKIP (not churn)
    set dir [els::backup_dir]
    llength [glob -nocomplain -directory $dir "[els::glob_escape [els::backup_stem $p]].*.bak"]
} -result 1
