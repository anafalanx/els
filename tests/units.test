# tests/units.test — direct unit tests of the pure helper procs (no UI needed
# beyond sourcing the library), complementing the integration-style suites.
source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::test

# ---- EOL detection ------------------------------------------------------
test unit-eol-1 {CRLF wins when present} -body { els::detect_eol "a\r\nb\r\n" } -result crlf
test unit-eol-2 {LF}                      -body { els::detect_eol "a\nb\n" }     -result lf
test unit-eol-3 {lone CR}                 -body { els::detect_eol "a\rb\r" }     -result cr
test unit-eol-4 {no newline defaults LF}  -body { els::detect_eol "abc" }        -result lf

# ---- labels -------------------------------------------------------------
test unit-enclabel-1 {plain utf-8}     -body { els::enc_label utf-8 0 }    -result {UTF-8}
test unit-enclabel-2 {utf-8 with BOM}  -body { els::enc_label utf-8 1 }    -result {UTF-8 BOM}
test unit-enclabel-3 {utf-16le + BOM}  -body { els::enc_label utf-16le 1 } -result {UTF-16 LE BOM}
test unit-enclabel-4 {utf-32be}        -body { els::enc_label utf-32be 0 } -result {UTF-32 BE}
test unit-enclabel-5 {legacy upcased}  -body { els::enc_label cp1251 0 }   -result {CP1251}
test unit-eollabel-1 {eol labels} -body {
    list [els::eol_label lf] [els::eol_label crlf] [els::eol_label cr]
} -result {LF CRLF CR}

# ---- regex escaping -----------------------------------------------------
test unit-reesc-1 {ARE metacharacters are escaped} -body {
    els::re_escape {a.b*c+(d)[e]}
} -result {a\.b\*c\+\(d\)\[e\]}
test unit-reesc-2 {escaped pattern matches literally in the Text widget} -setup {els_reset} -body {
    set w [els::T] ; $w insert end "a.c axc a.c"
    set pat [els::re_escape "a.c"]      ;# the dot must be literal
    llength [$w search -all -regexp -- $pat 1.0 end]
} -result 2

# ---- ICU name -> Tcl encoding mapping -----------------------------------
test unit-icu-1 {windows codepage} -body { els::icu_to_tcl windows-1252 } -result cp1252
test unit-icu-2 {Shift_JIS}        -body { els::icu_to_tcl Shift_JIS }    -result cp932
test unit-icu-3 {GB18030 -> GBK}   -body { els::icu_to_tcl GB18030 }      -result cp936
test unit-icu-4 {UTF-16LE}         -body { els::icu_to_tcl UTF-16LE }     -result utf-16le
test unit-icu-5 {ISO-8859-2}       -body { els::icu_to_tcl ISO-8859-2 }   -result iso8859-2
test unit-icu-6 {EUC-KR}           -body { els::icu_to_tcl EUC-KR }       -result euc-kr
test unit-icu-7 {US-ASCII}         -body { els::icu_to_tcl US-ASCII }     -result ascii
test unit-icu-8 {unknown -> empty} -body { els::icu_to_tcl Klingon-1 }    -result {}
test unit-icu-9 {normalization is case/punct-insensitive} -body {
    list [els::icu_to_tcl "koi8-r"] [els::icu_to_tcl "KOI8R"] [els::icu_to_tcl "koi8_r"]
} -result {koi8-r koi8-r koi8-r}

# ---- adapt-case (replacement case template) -----------------------------
test unit-adapt-off {disabled -> replacement unchanged} -setup {els_reset} -body {
    set ::els::find_adapt 0 ; els::adapt_case FOO bar
} -result bar
test unit-adapt-on {maps lower/upper/title, leaves mixed} -setup {els_reset} -body {
    set ::els::find_adapt 1
    list [els::adapt_case foo bar] [els::adapt_case FOO bar] \
         [els::adapt_case Foo bar] [els::adapt_case fOo bar] [els::adapt_case 123 bar]
} -result {bar BAR Bar bar bar}

# ---- decode round-trips a chosen encoding -------------------------------
test unit-decode-1 {decode strips a utf-8 BOM} -body {
    els::decode "\xEF\xBB\xBF[encoding convertto utf-8 hi]" utf-8 1
} -result hi
test unit-decode-2 {decode strips a 4-byte utf-32 BOM} -body {
    els::decode "\xFF\xFE\x00\x00[encoding convertto utf-32le hi]" utf-32le 1
} -result hi
test unit-decode-3 {legacy bytes decode without error (replace profile)} -body {
    els::decode "\xE9\xE8" iso8859-1 0
} -result "éè"

# ---- document helpers ---------------------------------------------------
test unit-doc-1 {line_count counts lines} -setup {els_reset} -body {
    [els::T] insert end "a\nb\nc\nd" ; els::line_count
} -result 4
test unit-doc-2 {a fresh doc is pristine; editing dirties it} -setup {els_reset} -body {
    set id $::els::active
    set a [els::pristine $id]
    [els::T] insert end "x" ; update
    list $a [els::pristine $id]
} -result {1 0}
test unit-doc-3 {untitled name; path name is the basename} -setup {els_reset} -body {
    set id $::els::active
    set u [els::doc_name $id]
    set ::els::docPath($id) [file join $::ELS_TMP hello.txt]
    list $u [els::doc_name $id]
} -result {untitled hello.txt}

# ---- icu_to_tcl mapping (beyond unit-icu-1..9) --------------------------
test unit-icu-10 {icu_to_tcl maps many charset names to Tcl encodings} -body {
    set out {}
    foreach name {windows-1251 ISO-8859-15 KOI8-R Big5 windows-874 TIS-620 EUC-JP ISO-2022-JP} {
        lappend out [els::icu_to_tcl $name]
    }
    set out
} -result {cp1251 iso8859-15 koi8-r big5 cp874 tis-620 euc-jp iso2022-jp}

test unit-icu-11 {icu_to_tcl falls back to encoding names for an unlisted alias} -body {
    list [els::icu_to_tcl cp1252] [els::icu_to_tcl ascii] [els::icu_to_tcl bogus-charset-xyz]
} -result {cp1252 ascii {}}

# ---- bytes_ascii_only (guards the [string is ascii] implementation) -----
# Note: an embedded NUL counts as ASCII (it is < 0x80) — which is exactly why
# detect_encoding checks for NUL bytes BEFORE consulting bytes_ascii_only.
test unit-ascii-1 {bytes_ascii_only: ASCII (incl. NUL) true; high/utf-8 bytes false} -body {
    list \
        [els::bytes_ascii_only "plain text 123"] \
        [els::bytes_ascii_only [binary format c* {72 73 0}]] \
        [els::bytes_ascii_only [binary format c* {72 233 73}]] \
        [els::bytes_ascii_only [encoding convertto utf-8 "café"]]
} -result {1 1 0 0}

# ---- detect_wide gate (parity + NUL-ratio) ------------------------------
test unit-wide-1 {detect_wide: plain ASCII text is not wide} -body {
    els::detect_wide "hello world" "hello world"
} -result {}
test unit-wide-2 {detect_wide: a couple of stray NULs split across parities are not wide} -body {
    set s "[string repeat ab 19]\x00\x00"   ;# 38 ASCII bytes + one even + one odd NUL
    els::detect_wide $s $s
} -result {}
test unit-wide-3 {detect_wide: a strong NUL-in-odd-bytes signature is UTF-16LE} -body {
    set s [encoding convertto utf-16le "hello world this is wide text"]
    els::detect_wide $s $s
} -result utf-16le

# ---- decode (BOM stripping per encoding) --------------------------------
test unit-decode-4 {decode strips a utf-16le BOM then decodes the body} -body {
    els::decode "\xFF\xFE[encoding convertto utf-16le ok]" utf-16le 1
} -result ok
test unit-decode-5 {decode without a BOM strips nothing} -body {
    els::decode [encoding convertto utf-8 "héllo"] utf-8 0
} -result héllo

# ---- title bar: only 'els' + version (no filename) ----------------------
test unit-title-1 {title bar shows only els + version, even with a file open} -setup {els_reset} -body {
    els::open [els_tmpfile titled.txt "hi\n"]
    els::settitle
    wm title .
} -result "els $::els::version"

# ---- path helpers -------------------------------------------------------
test unit-samepath-1 {same_path is case-insensitive on Windows and rejects empties} -body {
    list \
        [els::same_path "C:/Foo/Bar.txt" "c:/foo/BAR.TXT"] \
        [els::same_path "C:/Foo/Bar.txt" "C:/Foo/Baz.txt"] \
        [els::same_path "" "C:/x.txt"]
} -result {1 0 0}

test unit-sessionsan-1 {session_sanitize drops blanks and normalized duplicates} -body {
    els::session_sanitize [list "C:/x/y.txt" "" "C:/x/y.txt" "C:/x/z.txt"]
} -result [list [els::session_path "C:/x/y.txt"] [els::session_path "C:/x/z.txt"]]

# ---- elide_path (status-bar name elision) -------------------------------
test unit-elide-1 {elide_path returns the path unchanged when it fits} -setup {els_reset} -body {
    els::elide_path "C:/a/b/file.txt" 100000
} -result {C:/a/b/file.txt}
test unit-elide-2 {elide_path fits the result in the budget and marks the elision} -setup {els_reset} -body {
    set p "C:/very/deeply/nested/directory/document.txt"
    set out [els::elide_path $p 80]
    list [expr {[font measure elsUI $out] <= 80}] [string match …* $out] \
         [expr {[string length $out] < [string length $p]}]
} -result {1 1 1}

# ---- selftest report path resolution ------------------------------------
test unit-selftest-path-1 {selftest_report_path honours an explicit request} -body {
    els::selftest_report_path "C:/tmp/my-report.txt"
} -result {C:/tmp/my-report.txt}
test unit-selftest-path-2 {selftest_report_path falls back to a default file name} -body {
    string match *els-selftest.txt [els::selftest_report_path ""]
} -result 1
