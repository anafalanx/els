# ---- show whitespace (menu toggle) --------------------------------------
test ui-6.1 {Show Whitespace tags spaces, tabs and trailing distinctly} -setup {ui_reset} -body {
    set w [els::T] ; $w insert end "a b\tindented   \nclean" ; update
    .menu.view invoke "Show Whitespace" ; update     ;# toggle on
    list $::els::show_ws \
         [expr {[llength [$w tag ranges wsSpace]] > 0}] \
         [expr {[llength [$w tag ranges wsTab]]   > 0}] \
         [expr {[llength [$w tag ranges wsTrail]] > 0}]
} -result {1 1 1 1}

test ui-6.2 {toggling Show Whitespace off clears the tags} -setup {ui_reset} -body {
    set w [els::T] ; $w insert end "a b\tx   " ; update
    .menu.view invoke "Show Whitespace" ; update     ;# on
    .menu.view invoke "Show Whitespace" ; update     ;# off
    list $::els::show_ws [llength [$w tag ranges wsSpace]] \
         [llength [$w tag ranges wsTab]] [llength [$w tag ranges wsTrail]]
} -result {0 0 0 0}

# ---- scrollbar auto-hide ------------------------------------------------
test ui-7.1 {the scrollbar hides for a short doc, shows for a long one} -setup {ui_reset} -body {
    [els::T] insert end "one\ntwo\nthree"
    els::refresh_view ; ui_settle
    set fits $::els::vs_shown
    [els::T] insert end [string repeat "\nline" 200]
