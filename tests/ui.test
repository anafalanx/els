} -result {1 1 1 1 1}

test ui-10.1 {status name tooltip: native path + length while the label is eliding} -setup {ui_reset} -body {
    set p "C:/some/dir/notes.txt" ; set fn [file nativename $p]
    set ::els::docPath($::els::active) $p
    # the label's real non-elided rendering carries the length suffix
    .sb.name configure -text "$p  \[[string length $fn]\]"   ;# fits — no tip
    set a [els::name_tip]
    .sb.name configure -text "…/notes.txt  \[[string length $fn]\]"  ;# elided
    set b [els::name_tip]
    list [expr {$a eq ""}] [expr {$b eq "$fn \[[string length $fn]\]"}]
} -result {1 1}

test ui-10.2 {tab tooltip is the native full path + length, empty for an untitled tab} -setup {ui_reset} -body {
    set id $::els::active
    set u [els::tab_tip $id]
    set ::els::docPath($id) "C:/x/y.txt" ; set fn [file nativename "C:/x/y.txt"]
    set delayed [expr {[string first " $::els::tab_tip_delay" [bind [els::tabW $id] <Enter>]] >= 0}]
    list [expr {$u eq ""}] [expr {[els::tab_tip $id] eq "$fn \[[string length $fn]\]"}] $delayed
} -result {1 1 1}

test ui-10.3 {find bar sits above the text (row 1); text + gutter at row 2} -setup {ui_reset} -body {
    els::find_show find
    set fr [dict get [grid info .find]   -row]
    set tr [dict get [grid info [els::T]] -row]
    set gr [dict get [grid info .ln]      -row]
    els::find_hide
    list $fr $tr $gr [expr {$fr < $tr}]
} -result {1 2 2 1}

# ---- recent files -------------------------------------------------------
test recent-1.1 {recent_add prepends newest-first and de-duplicates} -setup {ui_reset} -body {
    set ::els::recent {}
    els::recent_add "C:/a/one.txt"
    els::recent_add "C:/a/two.txt"
    els::recent_add "C:/a/one.txt"
    list [llength $::els::recent] [lmap p $::els::recent {file tail $p}]
} -result {2 {one.txt two.txt}}

test recent-1.2 {recent_remove drops one entry; recent_clear empties the list} -setup {ui_reset} -body {
    set ::els::recent {}
    els::recent_add "C:/a/one.txt" ; els::recent_add "C:/a/two.txt"
    els::recent_remove [file normalize "C:/a/two.txt"]
    set kept [lmap p $::els::recent {file tail $p}]
    els::recent_clear
    list $kept [llength $::els::recent]
} -result {one.txt 0}

test recent-1.3 {the recent list is capped at recent_cap} -setup {ui_reset} -body {
    set ::els::recent {}
    for {set i 0} {$i < 20} {incr i} { els::recent_add "C:/d/f$i.txt" }
    expr {[llength $::els::recent] == $::els::recent_cap}
} -result 1

test recent-1.4 {opening a file records it and fills the Open Recent menu} -setup {ui_reset} -body {
    set ::els::recent {}
    set p [els_tmpfile recent_hit.txt "hi\n"]
    els::open $p
    list [expr {[file normalize $p] in $::els::recent}] \
         [expr {[.menu.file.recent index end] ne "none"}]
} -result {1 1}

test recent-1.5 {recent survives a config save / load round-trip} -setup {ui_reset} -body {
    set ::els::recent {}
    els::recent_add "C:/keep/a.txt" ; els::recent_add "C:/keep/b.txt"
    els::save_geometry
    set ::els::recent {}
    els::load_geometry
    lmap p $::els::recent {file tail $p}
} -result {b.txt a.txt}

test recent-1.6 {Open Recent menu exposes a maintain-list window, not a removal submenu} -setup {ui_reset} -body {
    set ::els::recent {}
    els::recent_add "C:/keep/a.txt"
    set labels {}
    for {set i 0} {$i <= [.menu.file.recent index end]} {incr i} {
        if {[.menu.file.recent type $i] ne "separator"} {
            lappend labels [.menu.file.recent entrycget $i -label]
        }
    }
    .menu.file.recent invoke "Maintain List..."
    set exists [winfo exists .recent]
    set min [wm minsize .recent]
    set buttonStyle [.recent.f.buttons.open cget -style]
    set req [winfo reqwidth .recent]
    catch {destroy .recent}
    list [expr {"Maintain List..." in $labels}] \
         [expr {"Remove from List" ni $labels}] $exists \
         [expr {[lindex $min 0] >= $req}] $buttonStyle
} -result {1 1 1 1 Dialog.TButton}

test recent-1.7 {recent manager removes selected and missing entries} -setup {ui_reset} -body {
    set ::els::recent {}
    set keep [els_tmpfile recent_keep.txt "keep\n"]
    set miss [file join $::ELS_TMP recent_missing.txt]
    catch {file delete -force $miss}
    els::recent_add $keep
    els::recent_add $miss
    els::recent_manage
    catch {wm withdraw .recent}
    .recent.f.list selection clear 0 end
    .recent.f.list selection set 0
    els::recent_manage_remove
    set afterRemove [lmap p $::els::recent {file tail $p}]
    els::recent_manage_remove_missing
    set afterMissing [lmap p $::els::recent {file tail $p}]
    catch {destroy .recent}
    list $afterRemove $afterMissing
} -result {recent_keep.txt recent_keep.txt}

test recent-1.8 {recent manager clear asks once and empties the list} -setup {ui_reset} -body {
    set ::els::recent {}
    els::recent_add "C:/keep/a.txt"
    els::recent_manage
    catch {wm withdraw .recent}
    els::recent_manage_clear
    set n [llength $::els::recent]
    catch {destroy .recent}
    set n
} -result 0

# A too-long path is elided the same way as the status bar (keep the filename,
# drop leading dirs behind "…/"); a short path shows in full.  The window is
# pinned narrow (and made transparent) so elision triggers regardless of DPI.
test recent-2.1 {recent manager elides long paths but keeps the filename} -setup {ui_reset} -body {
    set ::els::recent {
        C:/short.txt
        C:/Users/anafa/dev/els/a/very/deeply/nested/folder/structure/with/many/segments/notes.txt
    }
    els::recent_manage
    catch {wm attributes .recent -alpha 0.0}
    wm minsize .recent 1 1 ; wm geometry .recent 400x300
    update ; update idletasks
    els::recent_manage_refresh
    set short [.recent.f.list get 0]
    set long  [.recent.f.list get 1]
    set fits  [expr {[font measure elsUI $long] <= [els::recent_manage_avail]}]
    catch {destroy .recent}
    list [expr {$short eq "C:/short.txt"}] [string match "…/*notes.txt" $long] $fits
} -result {1 1 1}

# Eliding is cosmetic: the detail label elides (keeps the filename) so it can't
# stretch the dialog, the full native path is carried by the hover tooltip, and
# the row index still maps to the real (unabridged) path.
test recent-2.2 {recent index maps to the full path; the tooltip carries it in full} -setup {ui_reset} -body {
    set full C:/Users/anafa/dev/els/a/very/deeply/nested/folder/with/segments/notes.txt
    set ::els::recent [list $full]
    els::recent_manage
    catch {wm attributes .recent -alpha 0.0}
    wm minsize .recent 1 1 ; wm geometry .recent 360x300
    update ; update idletasks
    els::recent_manage_refresh
    .recent.f.list selection clear 0 end
    .recent.f.list selection set 0
    els::recent_manage_select
    set label [.recent.f.path cget -text]
    set tip   [els::recent_detail_tip]
    set path  [els::recent_manage_path]
    set fn    [file nativename $full]
    catch {destroy .recent}
    list [string match "…/*notes.txt" $label] \
         [expr {$tip eq "$fn \[[string length $fn]\]"}] \
         [expr {$path eq $full}]
} -result {1 1 1}

# The recent window's scrollbar is a ttk TScrollbar (the same traditional family
# as the main editor bars), not the classic widget.
test recent-2.3 {recent window uses the shared ttk scrollbar style} -setup {ui_reset} -body {
    set ::els::recent {C:/a.txt C:/b.txt}
    els::recent_manage
    catch {wm attributes .recent -alpha 0.0}
    update idletasks
    set cls [winfo class .recent.f.vs]
    catch {destroy .recent}
    set cls
} -result TScrollbar

# Regression: selecting a very long path must NOT balloon the dialog wide (the
# detail label used to request the full path's width and geometry-propagate it to
# the toplevel, which then stretched the listbox so its rows never had to elide).
# The width must hold, and both the row and the detail label must stay elided.
test recent-2.4 {a long selected path neither widens the dialog nor un-elides the list} -setup {ui_reset} -body {
    set long "C:/a/very/deeply/nested/folder/structure/with/many/segments/that/keeps/going/and/going/until/it/is/extremely/long/notes.txt"
    set ::els::recent [list "C:/short.txt" $long]
    els::recent_manage
    catch {wm attributes .recent -alpha 0.0}
    update ; update idletasks
    set w0 [winfo width .recent]
    .recent.f.list selection clear 0 end
    .recent.f.list selection set 1     ;# click the long path
    els::recent_manage_select
    update ; update idletasks
    set w1     [winfo width .recent]
    set row1   [.recent.f.list get 1]
    set detail [.recent.f.path cget -text]
    set davail [els::recent_detail_avail]
    catch {destroy .recent}
    list [expr {$w1 <= $w0 + 4}] \
         [string match "…/*notes.txt" $row1] \
         [string match "…/*notes.txt" $detail] \
         [expr {[font measure elsUI $detail] <= $davail}]
} -result {1 1 1 1}

# The Open-Recent MENU label must use the shared elision style (filename kept,
# leading dirs dropped behind a *leading* "…/"), not the old middle-trim.
test recent-3.1 {Open Recent menu label elides like the status bar, not mid-path} -setup {ui_reset} -body {
    set long "C:/a/very/deeply/nested/folder/structure/with/many/segments/that/keeps/going/and/going/until/it/is/very/long/notes.txt"
    set lbl [els::recent_label $long]
    list [expr {[string length $lbl] <= 64}] \
         [string match "…/*notes.txt" $lbl] \
         [expr {[string first "…" $lbl] == 0}]
} -result {1 1 1}

# Short paths that fit are shown in full (no ellipsis).
test recent-3.1a {Open Recent menu label leaves a short path intact} -setup {ui_reset} -body {
    els::recent_label "C:/proj/notes.txt"
} -result "C:/proj/notes.txt"

# Hovering a recent-list ROW that is elided schedules a full-path tooltip; a row
# that fits does not.  (The tip widget itself is exercised by tip_pop_at.)
test recent-3.2 {an elided recent row schedules a hover tooltip; a short one does not} -setup {ui_reset} -body {
    set long "C:/a/very/deeply/nested/folder/structure/with/many/segments/that/keeps/going/until/very/long/notes.txt"
    set ::els::recent [list "C:/short.txt" $long]
    els::recent_manage
    catch {wm attributes .recent -alpha 0.0}
    wm minsize .recent 1 1 ; wm geometry .recent 360x300
    update ; update idletasks
    els::recent_manage_refresh
    # elided long row -> a tip is scheduled
    els::tip_cancel ; set ::els::recent_row_tip -1
    lassign [.recent.f.list bbox 1] bx by
    els::recent_row_motion [expr {$bx+5}] [expr {$by+2}] 400 400
    set schedLong [info exists ::els::tip_after]
    # short row that fits -> no tip
    els::tip_cancel ; set ::els::recent_row_tip -1
    lassign [.recent.f.list bbox 0] bx0 by0
    els::recent_row_motion [expr {$bx0+5}] [expr {$by0+2}] 400 400
    set schedShort [info exists ::els::tip_after]
    els::tip_cancel
    catch {destroy .recent}
    list $schedLong $schedShort
} -result {1 0}

# tip_pop_at renders a tooltip with the given text at the requested anchor.
test recent-3.3 {tip_pop_at creates a tooltip carrying the full text} -setup {ui_reset} -body {
    els::tip_pop_at "C:\\a\\b\\c.txt" 200 200
    set ok [expr {[winfo exists .tip] && [.tip.l cget -text] eq "C:\\a\\b\\c.txt"}]
    els::tip_cancel ; catch {destroy .tip}
    set ok
} -result 1

# ---- long Windows paths (> MAX_PATH 260) -------------------------------
# Tcl 9 + els already handle paths past the legacy 260-char limit: open/read/
# write go through APIs that accept the \\?\ extended form (which `file normalize`
# adds automatically), and document save writes directly rather than via the
# `file rename -force` that breaks at >260.  These tests lock that in and ensure
# the extended-length prefix never leaks into anything shown to the user.

# pure-unit: extended-length prefix handling (no filesystem needed)
test lp-1.1 {strip_ext_prefix removes \\?\ and //?/ prefixes, incl. UNC} -body {
    list [els::strip_ext_prefix {//?/C:/a/b.txt}] \
         [els::strip_ext_prefix "\\\\?\\C:\\a\\b.txt"] \
         [els::strip_ext_prefix {//?/UNC/srv/share/x.txt}] \
         [els::strip_ext_prefix {C:/a/b.txt}]
} -result {C:/a/b.txt {C:\a\b.txt} //srv/share/x.txt C:/a/b.txt}

test lp-1.2 {elide_path drops the extended-length prefix} -body {
    els::elide_path {//?/C:/very/deep/folder/leaf.txt} 99999
} -result {C:/very/deep/folder/leaf.txt}

test lp-1.3 {display_path is native and prefix-free} -body {
    els::display_path {//?/C:/a/b/c.txt}
} -result {C:\a\b\c.txt}

# can THIS environment create + stat a path over 260 chars?  (Tcl 9 + NTFS can.)
::tcltest::testConstraint winlong [expr {![catch {
    set _d [file join $::ELS_TMP lpcap]
    catch {file delete -force $_d}
    set _deep $_d
    while {[string length $_deep] < 300} { set _deep [file join $_deep seg_grow_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa] }
    file mkdir $_deep
    set _f [file join $_deep p.txt] ; set _h [open $_f w] ; close $_h
    set _ok [expr {[file exists $_f] && [string length $_f] > 260}]
    catch {file delete -force $_d}
    if {!$_ok} { error notlong }
}]}]

proc lp_deep_file {sub name content} {
    set dir [file join $::ELS_TMP $sub]
    catch {file delete -force $dir}
    set deep $dir
    while {[string length $deep] < 300} { set deep [file join $deep seg_grow_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa] }
    file mkdir $deep
    set p [file join $deep $name]
    set h [open $p w] ; fconfigure $h -encoding utf-8 -translation lf
    puts -nonewline $h $content ; close $h
    return [list $p $dir]
}

test lp-2.1 {open, edit and save a document whose path exceeds 260 chars} -constraints winlong -setup {ui_reset} -body {
    lassign [lp_deep_file lp_open deepdoc.txt "hello deep"] p dir
    set id [els::open $p]
    set loaded [els_text $id]
    [els::W $id] insert end " EDIT"
    set saved [els::save]
    set h [open $::els::docPath($id) r] ; set disk [read $h] ; close $h
    catch {file delete -force $dir}
    list [expr {[string length $p] > 260}] $loaded $saved [string match "*hello deep EDIT*" $disk]
} -result {1 {hello deep} 1 1}

test lp-2.2 {a >260 document shows a clean, prefix-free name and tooltip} -constraints winlong -setup {ui_reset} -body {
    lassign [lp_deep_file lp_disp leaf.txt body] p dir
    set id [els::open $p]
    els::refresh_view ; update
    set name [els::doc_name $id]
    set sb   [.sb.name cget -text]
    set nt   [els::name_tip]
    catch {file delete -force $dir}
    list [expr {$name eq "leaf.txt"}] \
         [string match {*//?/*} $sb] \
         [expr {[string match {[A-Za-z]:\\*} $nt]}]
} -result {1 0 1}

# Tooltips wrap long (separator-only) paths so they can't run off the screen.
test tip-1.1 {tip_wrap leaves short text alone and wraps long paths losslessly} -body {
    set short C:/a/b.txt
    set long "[string repeat deeply-nested-path-segment-00/ 8]leaf.txt"
    set lines [split [els::tip_wrap $long] \n]
    set maxlen 0
    foreach l $lines { if {[string length $l] > $maxlen} { set maxlen [string length $l] } }
    list [els::tip_wrap $short] \
         [expr {[llength $lines] > 1}] \
         [expr {$maxlen <= 96}] \
         [expr {[join $lines {}] eq $long}]
} -result {C:/a/b.txt 1 1 1}

# Path tooltips append the path's character length in [brackets]; the extended
# prefix is stripped first so the count is of the real path; "" stays "".
test tip-1.2 {path_tip appends the path length and strips the extended prefix} -body {
    list [els::path_tip C:/Users/me/notes.txt] \
         [els::path_tip {//?/C:/a/b/leaf.txt}] \
         [els::path_tip {}]
} -result {{C:\Users\me\notes.txt [21]} {C:\a\b\leaf.txt [15]} {}}

# ---- Always on Top ------------------------------------------------------
test aot-1.1 {Always on Top toggles the window's -topmost attribute} -setup {ui_reset} -body {
    set off [wm attributes . -topmost]
    set ::els::always_on_top 1 ; els::set_always_on_top 0
    set on [wm attributes . -topmost]
    set ::els::always_on_top 0 ; els::set_always_on_top 0
    list $off $on [wm attributes . -topmost]
} -result {0 1 0}

test aot-1.2 {View menu exposes an Always on Top checkbutton bound to the setting} -setup {ui_reset} -body {
    set found 0
    for {set i 0} {$i <= [.menu.view index end]} {incr i} {
        if {[.menu.view type $i] eq "checkbutton" && \
            [.menu.view entrycget $i -label] eq "Always on Top"} {
            set found [expr {[.menu.view entrycget $i -variable] eq "::els::always_on_top"}]
        }
    }
    set found
} -result 1

test aot-1.3 {Always on Top survives a config save / load round-trip and re-applies} -setup {ui_reset} -body {
    set ::els::always_on_top 1
    els::set_always_on_top            ;# persists to the config
    set ::els::always_on_top 0 ; catch {wm attributes . -topmost 0}
    els::load_geometry
    list $::els::always_on_top [wm attributes . -topmost]
} -result {1 1}

test cfg-0.1 {word wrap survives a config save / load round-trip} -setup {ui_reset} -body {
    set ::els::word_wrap 1
    els::set_wrap
    set ::els::word_wrap 0
    [els::T] configure -wrap none
    els::load_geometry
    list $::els::word_wrap [[els::T] cget -wrap]
} -result {1 word}

test cfg-0.1a {show whitespace survives a config save / load round-trip} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "a b   "
    set ::els::show_ws 1
    els::set_show_ws
    set persisted [dict get [raw_read $::els::config_path] show_whitespace]
    set ::els::show_ws 0
    $w tag remove wsSpace 1.0 end
    $w tag remove wsTrail 1.0 end
    els::load_geometry
    list $persisted $::els::show_ws \
        [expr {[llength [$w tag ranges wsSpace]] > 0 || [llength [$w tag ranges wsTrail]] > 0}]
} -result {1 1 1}

test cfg-0.1b {zoom level (font size) is persisted and restored, and applied to elsMono} -setup {ui_reset} -body {
    els::set_font_size 18                                  ;# zoom -> persists
    set persisted [dict get [raw_read $::els::config_path] font_size]
    els::set_font_size 11 0                                ;# change in memory only
    els::load_geometry                                    ;# restores 18 from config
    list $persisted $::els::font_size [font configure elsMono -size]
} -result {18 18 18}

test cfg-0.2 {restore previous session defaults on and is exposed as a setting} -setup {ui_reset} -body {
    set labels {}
    for {set i 0} {$i <= [.menu.file index end]} {incr i} {
        if {[.menu.file type $i] ne "separator"} {
            lappend labels [.menu.file entrycget $i -label]
        }
    }
    list $::els::restore_session [expr {"Restore Previous Session" in $labels}]
} -result {1 1}

test cfg-0.3 {session files and active file survive a config save / load round-trip} -setup {ui_reset} -body {
    set p1 [els_tmpfile session_one.txt "one\n"]
    set p2 [els_tmpfile session_two.txt "two\n"]
    set id1 [els::open $p1]
    set id2 [els::open $p2]
    els::switch_to $id1
    els::save_geometry
    set ::els::session_files {}
    set ::els::session_active ""
    set ::els::restore_session 0
    els::load_geometry
    list $::els::restore_session \
         [lmap p $::els::session_files {file tail $p}] \
         [file tail $::els::session_active] \
         [expr {$id2 ne ""}]
} -result {1 {session_one.txt session_two.txt} session_one.txt 1}

test cfg-0.4 {session restore reopens existing files and restores the active tab} -setup {ui_reset} -body {
    set p1 [els_tmpfile restore_one.txt "one\n"]
    set p2 [els_tmpfile restore_two.txt "two\n"]
    set miss [file join $::ELS_TMP restore_missing.txt]
    catch {file delete -force $miss}
    set ::els::session_files [list $p1 $miss $p2]
    set ::els::session_active [file normalize $p2]
    set restored [els::session_restore]
    set tails [lmap id $::els::docs {file tail $::els::docPath($id)}]
    list $restored $tails [file tail $::els::docPath($::els::active)]
} -result {2 {restore_one.txt restore_two.txt} restore_two.txt}

test cfg-0.5 {turning restore previous session off persists the setting} -setup {ui_reset} -body {
    .menu.file invoke "Restore Previous Session"
    set conf [raw_read $::els::config_path]
    list $::els::restore_session [dict get $conf restore_session]
} -result {0 0}

# ---- update check -------------------------------------------------------
test update-1.1 {version_gt compares dotted versions; junk is never greater} -setup {els_reset} -body {
    list [els::version_gt 0.18 0.17] [els::version_gt 0.15 0.15] \
         [els::version_gt 0.14 0.15] [els::version_gt 1.0 0.9] \
         [els::version_gt junk 0.15]
} -result {1 0 0 1 0}

test update-1.2 {a newer tag lights the red indicator; same/older/garbage do not} \
        -setup {els_reset ; set ::__v $::els::version} -cleanup {set ::els::version $::__v} -body {
    set ::els::version 0.17
    .sb.update configure -text ""
    els::update_parse {"x":1,"tag_name":"v0.18","y":2}
    set newer [.sb.update cget -text]
    .sb.update configure -text ""
    els::update_parse {"tag_name":"v0.17"}
    set same [.sb.update cget -text]
    els::update_parse {no tag at all}
    list $newer $same [.sb.update cget -text]
} -result {0.18 {} {}}

# ---- config location ----------------------------------------------------
test cfg-1.1 {config_candidates yields a portable path and a LOCALAPPDATA path} -setup {els_reset} -body {
    lassign [els::config_candidates] near appdata
    list [file tail $near] [file tail $appdata] \
         [string match "*els*" $appdata] [expr {$near ne $appdata}]
} -result {els.conf els.conf 1 1}

test cfg-1.2 {resolve_existing finds the LOCALAPPDATA config when present} -setup {els_reset} -body {
    lassign [els::config_candidates] near appdata
    if {[file exists $near]} { return {1 1} }   ;# a portable config is present: branch not testable here
    catch {file delete -force [file dirname $appdata]}
    file mkdir [file dirname $appdata]
    set fh [open $appdata w] ; puts $fh [dict create geometry 800x600] ; close $fh
    set ::els::config_path ""
    set found  [els::config_resolve_existing]
    set picked [string equal $::els::config_path $appdata]
    catch {els::lock_release}   ;# set_config_path acquired a real lock: release
                                ;# it or the delete below silently fails
    catch {file delete -force [file dirname $appdata]}
    set ::els::config_path [file join $::ELS_TMP els.conf]   ;# restore hermetic default
    list $found $picked
} -result {1 1}

test cfg-1.3 {the first-run dialog applies the chosen location and closes} -setup {els_reset} -body {
    lassign [els::config_candidates] near appdata
    set ::els::config_path ""
    els::config_choice_dialog $near $appdata     ;# non-blocking; no vwait
    .cfgask.f.ok invoke                          ;# default selection -> appdata
    set chosen $::els::config_path
    set gone [expr {![winfo exists .cfgask]}]
    # config_apply_choice scheduled `after idle recover_boot` and acquired a
    # session lock: neutralize both, or the callback fires mid-suite (it could
    # deiconify a REAL recovery dialog) and the delete below silently fails
    foreach a [after info] { catch {after cancel $a} }
    catch {els::lock_release}
    catch {file delete -force [file dirname $appdata]}
    set ::els::config_path [file join $::ELS_TMP els.conf]   ;# restore hermetic default
    list [string equal $chosen $appdata] $gone
} -result {1 1}

test cfg-1.4 {legacy config.tcl is migrated to els.conf} -setup {els_reset} -body {
    lassign [els::config_candidates] near appdata
    lassign [els::config_legacy_candidates] oldNear oldAppdata
    catch {file delete -force $near $appdata $oldNear $oldAppdata [file dirname $appdata]}
    file mkdir [file dirname $oldAppdata]
    set fh [open $oldAppdata w] ; puts $fh [dict create geometry 810x610 word_wrap 1] ; close $fh
    set ::els::config_path ""
    set found [els::config_resolve_existing]
    set migrated [file exists $appdata]
    set picked [string equal $::els::config_path $appdata]
    catch {els::lock_release}   ;# release the lock set_config_path acquired
    catch {file delete -force [file dirname $appdata]}
    set ::els::config_path [file join $::ELS_TMP els.conf]
    list $found $migrated $picked
} -result {1 1 1}

# ---- bug-hunt wave 4: config + session robustness ------------------------

test cfg-2.1 {corrupt config VALUES cannot abort startup (load_geometry tolerates anything)} -setup {ui_reset} -body {
    set f $::els::config_path
    set fh [open $f w]
    puts $fh {geometry 100x100+50 word_wrap maybe recent {a "b} session_files {x "y} always_on_top 7 font_size huge restore_session perhaps show_whitespace blah}
    close $fh
    set rc [catch {els::load_geometry} err]
    catch {file delete -force $f}
    list $rc $::els::word_wrap $::els::show_ws
} -result {0 0 0}

test cfg-2.2 {a config that is not a dict at all is ignored, not fatal} -setup {ui_reset} -body {
    set f $::els::config_path
    set fh [open $f w] ; puts $fh "this is \{unbalanced and not a dict" ; close $fh
    set rc [catch {els::load_geometry}]
    catch {file delete -force $f}
    set rc
} -result 0

# ---- R7: off-screen geometry clamp + zoomed-state persistence ------------
# clamp_geometry is pure (the VIRTUAL desktop rect {vx vy vw vh} is passed in), so
# these are deterministic and exercise real multi-monitor topologies with no screen.

test geo-clamp-2.1 {a huge positive origin (resolution change / corrupt config) is reset, size kept} -body {
    els::clamp_geometry 900x620+99999+99999 0 0 1920 1080
} -result 900x620+60+60

test geo-clamp-2.2 {a far-negative origin (disconnected left/top monitor) is reset} -body {
    els::clamp_geometry 900x620-5000-5000 0 0 1920 1080
} -result 900x620+60+60

test geo-clamp-2.3 {a normal on-screen position is left untouched} -body {
    els::clamp_geometry 900x620+100+80 0 0 1920 1080
} -result 900x620+100+80

test geo-clamp-2.4 {a legitimate negative coord on a connected LEFT monitor is kept} -body {
    # virtual desktop spans [-1920, 1920]: -1900 is a window on the left monitor
    els::clamp_geometry 900x620-1900+100 -1920 0 3840 1080
} -result 900x620-1900+100

test geo-clamp-2.4b {a window on a connected RIGHT/below secondary monitor is kept (the wm-maxsize regression)} -body {
    # virtual desktop spans [0, 3840]: +2000 is on the right monitor.  wm maxsize
    # would report only the primary (1920) and wrongly teleport this to +60+60.
    list [els::clamp_geometry 900x620+2000+100 0 0 3840 1080] \
         [els::clamp_geometry 900x620+400+1300 0 0 1920 2160]
} -result {900x620+2000+100 900x620+400+1300}

test geo-clamp-2.5 {a size-only geometry (no offset) passes through unchanged} -body {
    els::clamp_geometry 900x620 0 0 1920 1080
} -result 900x620

test geo-clamp-2.5b {virtual_screen returns a 4-int rect with a positive width} -setup {ui_reset} -body {
    set r [els::virtual_screen]
    list [llength $r] [expr {[lindex $r 2] > 0 && [lindex $r 3] > 0}] \
         [string is integer -strict [lindex $r 0]]
} -result {4 1 1}

test geo-clamp-2.6 {save_geometry persists a zoomed boolean alongside the geometry} -setup {ui_reset} -body {
    els::save_geometry                                    ;# `.` is normal here
    set data [raw_read $::els::config_path]
    list [dict get $data zoomed] [string is boolean -strict [dict get $data zoomed]] \
         [regexp {^[0-9]+x[0-9]+} [dict get $data geometry]]
} -result {0 1 1}

test geo-clamp-2.7 {load_geometry tolerates a zoomed key (and a bogus one) without aborting} -setup {ui_reset} -body {
    set f $::els::config_path
    set fh [open $f w]
    puts $fh {geometry 800x600+40+40 zoomed 1}
    close $fh
    set rc1 [catch {els::load_geometry}]
    set fh [open $f w] ; puts $fh {geometry 800x600+40+40 zoomed notabool} ; close $fh
    set rc2 [catch {els::load_geometry}]
    catch {file delete -force $f}
    list $rc1 $rc2
} -cleanup {catch {wm state . normal}} -result {0 0}

test geo-clamp-2.8 {load_geometry seeds geom_normal from the applied rect so a zoomed quit keeps the normal window} -setup {ui_reset} -body {
    set f $::els::config_path
    set fh [open $f w] ; puts $fh {geometry 800x600+120+90} ; close $fh   ;# on-screen, not zoomed
    set ::els::geom_normal ""
    els::load_geometry
    catch {file delete -force $f}
    set ::els::geom_normal
} -result {800x600+120+90}

test cfg-2.3 {LOCALAPPDATA-unset fallback resolves a real home dir (no literal ~)} -setup {ui_reset} -body {
    set saved $::env(LOCALAPPDATA)
    unset ::env(LOCALAPPDATA)
    lassign [els::config_roots] near appdata
    set ::env(LOCALAPPDATA) $saved
    list [string match "*~*" $appdata] [string match -nocase "*AppData*" $appdata]
} -result {0 1}

test session-4.1 {an explicit-file-arg launch does not destroy the stored session} -setup {ui_reset} -body {
    set ::els::session_files [list C:/saved/a.txt C:/saved/b.txt]
    set ::els::session_active C:/saved/a.txt
    set ::els::session_owned 0                ;# arg launch: session never adopted
    els::open [els_tmpfile sw4.txt "x\n"]      ;# recent_add -> save_geometry
    set fh [open $::els::config_path r] ; set data [read $fh] ; close $fh
    set ::els::session_owned 1
    dict get $data session_files
} -result {C:/saved/a.txt C:/saved/b.txt}

test cfg-2.5 {the first-run dialog's <Return> routes through the button (no % substitution of paths)} -setup {ui_reset} -body {
    els::config_choice_dialog [file join $::ELS_TMP near.conf] [file join $::ELS_TMP app.conf]
    catch {wm withdraw .cfgask}
    set b [bind .cfgask <Return>]
    set ok [string equal $b [list .cfgask.f.ok invoke]]
    catch {destroy .cfgask}
    set ok
} -result 1

test session-4.2 {a session-owning run persists its open docs as the session} -setup {ui_reset} -body {
    set p [els_tmpfile sw5.txt "y\n"]
    els::open $p                               ;# owned (els_reset default) -> persists
    set fh [open $::els::config_path r] ; set data [read $fh] ; close $fh
    expr {[dict get $data session_files] eq [list [file normalize $p]]}
} -result 1

# ---- user-issues batch A ---------------------------------------------------

test issue-a.1 {cancelling the first-run dialog postpones, never adopts a location} -setup {ui_reset} -body {
    set ::els::config_path ""
    els::config_choice_dialog [file join $::ELS_TMP near.conf] [file join $::ELS_TMP app.conf]
    catch {wm withdraw .cfgask}
    els::config_postpone_choice .cfgask        ;# the WM close / Escape path
    list $::els::config_path [winfo exists .cfgask]
} -cleanup {
    set ::els::config_path [file join $::ELS_TMP els.conf]
} -result {{} 0}

test issue-a.2 {Markdown is not offered in the open/save filetypes} -body {
    string match -nocase "*markdown*" [els::filetypes]
} -result 0

test issue-a.3 {Help menu links to the GitHub repo} -setup {ui_reset} -body {
    set found 0
    for {set i 0} {$i <= [.menu.help index end]} {incr i} {
        if {[.menu.help type $i] eq "command" &&
            [.menu.help entrycget $i -label] eq "els on GitHub"} { set found 1 }
    }
    set found
} -result 1

test issue-a.4 {goto entry rejects non-numeric input at the keyboard} -setup {ui_reset} -body {
    els::goto_line
    catch {wm withdraw .goto}
    .goto.f.e insert 0 abc                     ;# validated: rejected
    set bad [.goto.f.e get]
    .goto.f.e insert 0 42
    set good [.goto.f.e get]
    catch {destroy .goto}
    list $bad $good
} -result {{} 42}

test issue-a.5 {statusbar shows the path length in its normal depiction} -setup {ui_reset} -body {
    els::open [els_tmpfile ia5.txt "x\n"]
    update idletasks
    els::update_namelabel
    set t [.sb.name cget -text]
    set want [string length [els::display_path $::els::docPath($::els::active)]]
    list [string match "*\\\[$want\\\]" $t] [string match "*ia5.txt*" $t]
} -result {1 1}

test issue-a.6 {the update indicator has a hover state} -setup {ui_reset} -body {
    list [expr {[bind .sb.update <Enter>] ne ""}] [expr {[bind .sb.update <Leave>] ne ""}]
} -result {1 1}

# ---- statusbar regressions: redundant tooltip + narrow-window flicker -------

test sbtip-1.1 {no tooltip while the whole path is shown; tip returns once it elides} -setup {ui_reset} -body {
    els::open [els_tmpfile tip1.txt "x\n"]
    update idletasks ; els::update_namelabel
    set fits [els::name_tip]                       ;# short path in a 900px bar: fits
    # force elision: a path far wider than the label
    set ::els::docPath($::els::active) [file join $::ELS_TMP [string repeat verylongsegment/ 20] tip1.txt]
    els::update_namelabel
    set elided [els::name_tip]
    list $fits [expr {$elided eq [els::path_tip $::els::docPath($::els::active)]}] \
        [string match "…*" [.sb.name cget -text]]
} -result {{} 1 1}

test sbflick-1.1 {the name label's geometry request is text-independent (no layout feedback)} -setup {ui_reset} -body {
    els::open [els_tmpfile fl1.txt "x\n"]
    update idletasks ; els::update_namelabel
    set short [winfo reqwidth .sb.name]
    set ::els::docPath($::els::active) [file join $::ELS_TMP [string repeat directory/ 30] fl1.txt]
    els::update_namelabel ; update idletasks
    set long [winfo reqwidth .sb.name]
    expr {$short == $long}
} -result 1

test sbflick-1.2 {a very narrow window reaches a stable elision (fixed point, no oscillation)} -setup {ui_reset} -body {
    els::open [els_tmpfile fl2-with-a-longer-name.txt "x\n"]
    wm geometry . 280x200 ; update
    els::update_namelabel ; update
    set t1 [.sb.name cget -text]
    els::update_namelabel ; update                ;# recompute at the same width:
    set t2 [.sb.name cget -text]                  ;# must be the identical text
    els::update_namelabel ; update
    set t3 [.sb.name cget -text]
    list [string equal $t1 $t2] [string equal $t2 $t3] [llength $::els_test_bgerrors]
} -cleanup {
    wm geometry . 900x620+100+100 ; update
} -result {1 1 0}

test issue-a.7 {find/replace entries grow a clear button while non-empty} -setup {ui_reset} -body {
    els::find_show find ; update idletasks
    set ::els::find_q "needle" ; update idletasks
    set shown [winfo ismapped .find.fr.q.clearx]
    event generate .find.fr.q.clearx <Button-1> ; update
    list $shown $::els::find_q [winfo ismapped .find.fr.q.clearx]
} -result {1 {} 0}
test recentvs-b.1 {the Maintain List scrollbar appears only when the list overflows} -setup {ui_reset} -body {
    # the dialog is withdrawn for test hygiene, so a child's `winfo ismapped` is
    # always 0 — assert on grid membership (manager "grid" vs removed "") instead
    set ::els::recent [list [els_tmpfile rvs1.txt "x\n"]]
    els::recent_manage ; catch {wm withdraw .recent}
    update idletasks ; els::recent_vs_apply
    set few [winfo manager .recent.f.vs]
    set many {}
    for {set i 0} {$i < 30} {incr i} { lappend many [file join $::ELS_TMP "rvs_$i.txt"] }
    set ::els::recent $many
    els::recent_manage_refresh
    update idletasks ; els::recent_vs_apply
    set lots [winfo manager .recent.f.vs]
    catch {destroy .recent}
    list $few $lots
} -result {{} grid}

test reg-1.1 {Reopen-with-Encoding keeps edits saved since open (docRaw refreshed on save)} -setup {ui_reset} -body {
    set p [els_tmpfile reg11.txt "original line\n"]
    els::open $p
    set w [els::T]
    $w insert end "EDITED ADDITION\n"
    els::save
    els::reopen_with utf-8 0
    string match *EDITED* [$w get 1.0 "end - 1 char"]
} -result 1

test reg-1.2 {Reopen-with-Encoding on a Save-As'd new document keeps its content} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "BRAND NEW CONTENT\n"
    set ::els_test_savefile [file join $::ELS_TMP reg12.txt]
    els::saveas
    els::reopen_with utf-8 0
    expr {[$w get 1.0 "end - 1 char"] ne ""}
} -result 1

test reg-2.1 {Replace uses the floating findOne tag, not a stale index, after a manual edit} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "cat cat cat"
    set ::els::find_q cat ; set ::els::find_mode find
    els::find_update
    $w insert 1.0 "XYZ- "
    set ::els::find_r dog
    els::find_replace_one
    set t [$w get 1.0 "end - 1 char"]
    list [string match *XYZ-* $t] [regexp -all dog $t]
} -result {1 1}

test reg-3.1 {zero-width regex yields no matches and Replace All does not corrupt} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "abc"
    set ::els::find_regex 1 ; set ::els::find_q {x*} ; set ::els::find_mode find
    els::find_update
    set m [llength $::els::find_matches]
    set ::els::find_r Q
    els::find_replace_all
    list $m [$w get 1.0 "end - 1 char"]
} -result {0 abc}

test reg-4.1 {Ctrl+H in the find field switches to replace without eating a character} -setup {ui_reset} -body {
    els::find_show find
    set e .find.fr.q
    focus -force $e
    $e delete 0 end ; $e insert 0 foobar ; $e icursor end ; update
    event generate $e <Control-h> ; update
    list [$e get] $::els::find_mode
} -result {foobar replace}

test reg-5.1 {an ASCII file with a stray NUL is read as text, not misdetected as UTF-16} -setup {ui_reset} -body {
    set p [raw_write reg51.txt "field1\x00field2 the quick brown fox jumps over the lazy dog\n"]
    set id [els::open $p]
    list $::els::docEnc($id) [string match *field2* [[els::T] get 1.0 "end - 1 char"]]
} -result {utf-8 1}

test reg-5.2 {a genuine BOM-less UTF-16LE ASCII file is still detected as wide} -constraints detect -setup {ui_reset} -body {
    set p [raw_write reg52.txt [encoding convertto utf-16le "The quick brown fox jumps over the lazy dog.\n"]]
    set id [els::open $p]
    list $::els::docEnc($id) [string match *quick* [[els::T] get 1.0 "end - 1 char"]]
} -result {utf-16le 1}

test reg-6.1 {Save As onto a path already open in another tab is refused (no lost update)} -setup {ui_reset} -body {
    set shared [file join $::ELS_TMP reg61.txt]
    set fh [open $shared w] ; puts $fh "ORIGINAL" ; close $fh
    set id1 [els::open $shared]
    set id2 [els::new_doc]
    [els::T] insert end "FROM TAB 2"
    set ::els_test_savefile $shared
    els::saveas
    set fh [open $shared r] ; set disk [string trim [read $fh]] ; close $fh
    list $::els::docPath($id2) $disk
} -result {{} ORIGINAL}

test reg-6.2 {config save is atomic: a mid-build throw leaves the old config intact} -setup {ui_reset} -cleanup {
    catch {rename els::session_current_files {}}
    catch {rename _els_scf els::session_current_files}
} -body {
    set f [els::config_file]
    els::save_geometry
    set fh [open $f r] ; set good [read $fh] ; close $fh
    rename els::session_current_files _els_scf
    proc els::session_current_files {} { error boom }
    els::save_geometry
    set fh [open $f r] ; set after [read $fh] ; close $fh
    list [expr {$after eq $good && [string length $good] > 0}] [file exists $f.tmp]
} -result {1 0}

# ---- atomic document save (robustness P0) -------------------------------
# The old els::save did `open $path w` (truncate-then-write): a crash / disk-full
# / I/O error mid-write left the user's file 0 bytes.  els::write_atomic writes a
# same-dir temp then renames it over the target, so the original is never touched
# until a complete new copy exists.  save-atomic-1.1 is RED on the old code.
test save-atomic-1.1 {a mid-write failure leaves the original file intact (no truncation)} -setup {ui_reset} -cleanup {
    catch {rename els::_save_emit {}}
    catch {rename _els_save_emit els::_save_emit}
} -body {
    set p [raw_write savefault.txt "ORIGINAL CONTENT\n"]
    els::open $p
    [els::W $::els::active] insert end "EDIT THAT MUST NOT REACH DISK"
    rename els::_save_emit _els_save_emit                 ;# force a mid-write crash
    proc els::_save_emit {chan bytes} { error "simulated mid-write failure" }
    set rc [els::save]
    set ondisk [raw_read $p]
    set residue [glob -nocomplain -directory $::ELS_TMP .els-save-*.tmp]
    list $rc [expr {$ondisk eq "ORIGINAL CONTENT\n"}] \
         [[els::W $::els::active] edit modified] [llength $residue]
} -result {0 1 1 0}

test save-atomic-1.2 {a clean save writes the new content and leaves no temp residue} -setup {ui_reset} -body {
    set p [raw_write saveok.txt "old\n"]
    els::open $p
    set w [els::W $::els::active]
    $w delete 1.0 end ; $w insert end "brand new content"
    set rc [els::save]
    set ondisk [raw_read $p]
    set residue [glob -nocomplain -directory $::ELS_TMP .els-save-*.tmp]
    list $rc [expr {$ondisk eq "brand new content"}] \
         [[els::W $::els::active] edit modified] [llength $residue]
} -result {1 1 0 0}

test save-atomic-1.3 {a read-only target is refused and left intact (matches old behavior)} -setup {ui_reset} -body {
    set p [raw_write savero.txt "keep me\n"]
    els::open $p
    [els::W $::els::active] insert end "should not be written"
    file attributes $p -readonly 1
    set rc [els::save]
    set ondisk [raw_read $p]
    file attributes $p -readonly 0
    list $rc [expr {$ondisk eq "keep me\n"}] [[els::W $::els::active] edit modified]
} -result {0 1 1}

test reg-7.1 {Whole Word + Regex alternation does not match inside larger words} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "foo bar foobar"
    set ::els::find_regex 1 ; set ::els::find_word 1 ; set ::els::find_q {foo|bar}
    set ::els::find_mode find
    els::find_update
    llength $::els::find_matches
} -result 2

# ---- UX polish ----------------------------------------------------------
test ui-3.4 {Ctrl+K / Ctrl+D / Ctrl+T do nothing (Tk's emacs Text defaults neutralized)} -setup {ui_reset} -body {
    set w [els::T] ; $w insert end "hello world"
    $w mark set insert 1.0
    event generate $w <Control-k> ; event generate $w <Control-d> ; event generate $w <Control-t>
    update
    els_text
} -result {hello world}

test ui-4.14 {find highlights are cleared from a tab when you switch away} -setup {ui_reset} -body {
    set a $::els::active
    [els::W $a] insert end "match match match"
    set ::els::find_q match ; set ::els::find_mode find ; els::find_update
    set hadA [expr {[llength [[els::W $a] tag ranges findAll]] > 0}]
    els::new_doc                ;# switch to a new tab
    set orphanA [expr {[llength [[els::W $a] tag ranges findAll]] > 0}]
    list $hadA $orphanA
} -result {1 0}

test ui-4.15 {F3 / Shift+F3 step to the next / previous match} -setup {ui_reset} -body {
    set w [els::T] ; $w insert end "x x x x"
    set ::els::find_q x ; set ::els::find_mode find ; els::find_update
    set c0 $::els::find_current
    event generate $w <Key-F3>       ; update ; set c1 $::els::find_current
    event generate $w <Shift-Key-F3> ; update ; set c2 $::els::find_current
    list $c0 $c1 $c2
} -result {0 1 0}

test update-1.3 {clicking the update notice dismisses its tooltip} -setup {
    ui_reset
    rename ::els::open_url ::els_test_real_open_url
    set ::els_test_url ""
    proc ::els::open_url {u} { set ::els_test_url $u }
} -body {
    els::tip_pop .sb.update "els 9.9 is available"
    set shown [winfo exists .tip]
    event generate .sb.update <Button-1> -x 2 -y 2
    update
    list $shown [winfo exists .tip] [expr {$::els_test_url ne ""}]
} -cleanup {
    rename ::els::open_url {} ; rename ::els_test_real_open_url ::els::open_url
} -result {1 0 1}

# A long document shows the scrollbar AND it has a real (non-collapsed) width —
# the custom arrow-less style once collapsed it to 1px (invisible) on big files.
test ui-7.2 {the vertical scrollbar is shown with a real (chunky) width} -setup {ui_reset} -body {
    set w [els::T]
    for {set i 0} {$i < 2000} {incr i} { $w insert end "line $i\n" }
    els::refresh_view ; update
    # mapped and not collapsed — guards the 1px regression.  Width is a points
    # value scaled per-DPI, so use a low, DPI-agnostic floor rather than a px count
    list [winfo ismapped .vs] [expr {[winfo reqwidth .vs] >= 8}]
} -result {1 1}

# The horizontal bar appears only when wrap is OFF and a line runs past the edge:
# short lines -> hidden; one very long line -> shown.
test ui-7.3 {the horizontal scrollbar shows only when wrap is off and a line overflows} -setup {ui_reset} -body {
    set ::els::word_wrap 0 ; els::set_wrap 0
    set w [els::T]
    $w insert end "short\nlines\nonly\n"
    els::refresh_view ; ui_settle ; els::update_hscroll
    set short $::els::hs_shown
    $w insert end [string repeat "the quick brown fox " 80]
    els::refresh_view ; ui_settle ; els::update_hscroll
    list $short $::els::hs_shown
} -result {0 1}

# Word wrap removes the need to scroll sideways: turning it on hides the
# horizontal bar, turning it off again brings it back for the same long line.
test ui-7.4 {word wrap hides the horizontal bar; turning it off restores it} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end [string repeat "the quick brown fox " 80]
    set ::els::word_wrap 0 ; els::set_wrap 0
    els::refresh_view ; ui_settle ; els::update_hscroll
    set off1 $::els::hs_shown
    set ::els::word_wrap 1 ; els::set_wrap 0
    ui_settle ; els::update_hscroll
    set on $::els::hs_shown
    set ::els::word_wrap 0 ; els::set_wrap 0
    ui_settle ; els::update_hscroll
    list $off1 $on $::els::hs_shown
} -result {1 0 1}

# The horizontal bar is a real (chunky) bar, and its thickness matches the
# vertical one exactly (both styled with the same 12p arrows) so they read as one.
test ui-7.5 {the horizontal scrollbar is chunky and matches the vertical thickness} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end [string repeat "the quick brown fox " 80]
    els::refresh_view ; ui_settle ; els::update_hscroll
    list [winfo ismapped .hs] [expr {[winfo reqheight .hs] >= 8}] \
         [expr {[winfo reqheight .hs] == [winfo reqwidth .vs]}]
} -result {1 1 1}

# The find count area must fit a large "N of M" without clipping (the label was
# 11 chars; a 20k-match file produced "15912 of 20631" and got truncated).
test ui-4.16 {the find count label fits a large match count without clipping} -setup {ui_reset} -body {
    els::find_show find
    set ::els::find_count "15912 of 20631"
    update idletasks
    expr {[winfo reqwidth .find.fr.n] >= [font measure elsUI "15912 of 20631"]}
} -result 1

# ---- bug-hunt wave 5: recent dialog, tooltips, menu undo -------------------

test recent-5.1 {Maintain List stays path-correct after recent_add reorders it} -setup {ui_reset} -body {
    set pa [file normalize [els_tmpfile r5a.txt "A\n"]]
    set pb [file normalize [els_tmpfile r5b.txt "B\n"]]
    set ::els::recent [list $pa $pb]
    els::recent_manage ; catch {wm withdraw .recent}
    .recent.f.list selection clear 0 end
    .recent.f.list selection set 1             ;# select pb
    els::recent_manage_select                   ;# selection now tracked by path
    els::recent_add [file normalize [els_tmpfile r5c.txt "C\n"]]   ;# reorders
    set agree [string equal [els::recent_manage_path] $pb]
    set rows [.recent.f.list size]
    catch {destroy .recent}
    list $agree [expr {$rows == [llength $::els::recent]}]
} -result {1 1}

test recent-5.2 {a failed Open keeps the Maintain List dialog up} -setup {ui_reset} -body {
    set dir [file join $::ELS_TMP r5dir] ; file mkdir $dir
    set ::els::recent [list $dir]               ;# exists, but cannot be opened
    els::recent_manage ; catch {wm withdraw .recent}
    .recent.f.list selection set 0
    els::recent_manage_open
    set alive [winfo exists .recent]
    catch {destroy .recent}
    list $alive [llength $::els::docs]
} -result {1 1}

test recent-5.3 {hovering the empty area below the rows schedules no tip} -setup {ui_reset} -body {
    set long [file join $::ELS_TMP [string repeat verylongdirname 8] r5long.txt]
    set ::els::recent [list $long]              ;# elided row -> tip applies
    els::recent_manage ; catch {wm withdraw .recent}
    update idletasks
    els::tip_cancel ; set ::els::recent_row_tip -1
    els::recent_row_motion 5 5 100 100          ;# inside row 0
    set inRow [info exists ::els::tip_after]
    els::tip_cancel ; set ::els::recent_row_tip -1
    set below [expr {[winfo reqheight .recent.f.list] - 5}]
    els::recent_row_motion 5 $below 100 100     ;# empty area below the row
    set inGap [info exists ::els::tip_after]
    catch {destroy .recent}
    list $inRow $inGap
} -result {1 0}

test recent-5.4 {destroying the Maintain List dialog cancels a pending row tip} -setup {ui_reset} -body {
    set long [file join $::ELS_TMP [string repeat verylongdirname 8] r5d.txt]
    set ::els::recent [list $long]
    els::recent_manage ; catch {wm withdraw .recent}
    update idletasks
    els::tip_cancel ; set ::els::recent_row_tip -1
    els::recent_row_motion 5 5 100 100          ;# schedules the after-550 tip
    set pend [info exists ::els::tip_after]
    destroy .recent                              ;# dialog dies before it fires
    after 700 {set ::__tipwait 1} ; vwait ::__tipwait
    list $pend [winfo exists .tip]
} -result {1 0}

test tip-5.1 {destroying a tooltip's anchor removes a visible tip} -setup {ui_reset} -body {
    button .tmpb -text x
    els::tooltip .tmpb "tip text"
    els::tip_pop .tmpb "tip text"
    set vis [winfo exists .tip]
    destroy .tmpb                                ;# <Destroy> hook fires
    list $vis [winfo exists .tip]
} -result {1 0}

test tip-5.2 {clicking a tab dismisses its visible tooltip and still switches} -setup {ui_reset} -body {
    set a $::els::active
    els::new_doc ; update
    set tf [els::tabW $a]
    els::tip_pop $tf "path tip"
    set vis [winfo exists .tip]
    event generate $tf <ButtonPress-1> ; update
    list $vis [winfo exists .tip] [expr {$::els::active eq $a}]
} -result {1 0 1}

test undo-5.1 {menu Undo refreshes Ln/Col and the current-line wash} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "one\n" ; $w edit separator ; $w insert end "two\n"
    $w mark set insert 2.3 ; els::refresh_view
    els::menu_undo ; ui_settle
    lassign [split [$w index insert] .] L C
    set fresh [string equal [.sb.pos cget -text] "Ln $L Col [expr {$C + 1}]"]
    list $fresh [expr {[llength [$w tag ranges currentLine]] > 0}]
} -result {1 1}

# ---- R6: production bgerror + rotating els.log + failure visibility -------

test log-6.1 {els::log appends a timestamped, levelled line to els.log next to els.conf} -setup {ui_reset} -body {
    set lf [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $lf}
    els::log info "hello from the log"
    set txt [raw_read $lf]
    catch {file delete -force $lf}
    list [string match {*\[info\] hello from the log*} $txt] \
         [regexp {^[0-9]{4}-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] } $txt]
} -result {1 1}

test log-6.2 {els.log rotates to els.log.1 past the ~256 KB cap, then starts fresh} -setup {ui_reset} -body {
    set lf [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $lf} ; catch {file delete -force $lf.1}
    set fh [open $lf w] ; puts -nonewline $fh [string repeat x 300000] ; close $fh
    els::log info "after rotation"
    set rotated [file exists $lf.1]
    set fresh [raw_read $lf]
    catch {file delete -force $lf} ; catch {file delete -force $lf.1}
    list $rotated [string match {*after rotation*} $fresh] [string match {*xxxxx*} $fresh]
} -result {1 1 0}

test log-6.3 {the reentry latch stops els::log recursing (a logging failure cannot loop)} -setup {ui_reset} -cleanup {set ::els::log_active 0} -body {
    set lf [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $lf}
    set ::els::log_active 1                 ;# simulate "already inside els::log"
    els::log info "should not appear"
    set ::els::log_active 0
    set existed [file exists $lf]
    catch {file delete -force $lf}
    set existed
} -result 0

test bgerror-6.4 {els::bgerror logs the trace and posts one non-modal note, never raises} -setup {ui_reset} -body {
    set lf [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $lf}
    set rc [catch {els::bgerror "boom" [dict create -errorinfo "boom\n  while executing \"X\""]}]
    set txt [raw_read $lf]
    catch {file delete -force $lf}
    list $rc [string match {*while executing*} $txt] \
         [string match {*internal error*} [.sb.name cget -text]]
} -result {0 1 1}

test swap-fail-6.5 {persistent swap-write failure surfaces a note after ~3 straight failures} -setup {ui_reset} -body {
    set p [raw_write swf.txt "content\n"]
    els::open $p ; set id $::els::active
    set ::els::swap_enabled 1
    [els::W $id] insert end "dirty edit" ; els::swap_touch
    rename els::write_atomic _els_wa_real
    proc els::write_atomic {args} { return "forced failure" }
    els::swap_flush_doc $id ; set s1 $::els::swap_fail_streak($id)
    els::swap_flush_doc $id ; set s2 $::els::swap_fail_streak($id)
    els::swap_flush_doc $id ; set s3 $::els::swap_fail_streak($id)
    set noted [string match {*crash protection is failing*} [.sb.name cget -text]]
    list $s1 $s2 $s3 $noted
} -cleanup {
    if {[llength [info commands _els_wa_real]]} {
        catch {rename els::write_atomic {}}
        rename _els_wa_real els::write_atomic
    }
    set ::els::swap_enabled 0
} -result {1 2 3 1}

test swap-fail-6.6 {a healthy swap write resets that doc's failure streak} -setup {ui_reset} -body {
    set p [raw_write swf2.txt "content\n"]
    els::open $p ; set id $::els::active
    set ::els::swap_enabled 1
    [els::W $id] insert end "dirty" ; els::swap_touch
    set ::els::swap_fail_streak($id) 2            ;# pretend two prior failures
    els::swap_flush_doc $id                        ;# a real, successful swap write
    set streak $::els::swap_fail_streak($id)
    els::swap_clear $id
    set ::els::swap_enabled 0
    set streak
} -result 0

test swap-fail-6.7 {a doc failing on a flaky mount still warns even while another doc keeps succeeding} -setup {ui_reset} -body {
    set pa [raw_write swfA.txt "aaa\n"] ; set pb [raw_write swfB.txt "bbb\n"]
    els::open $pa ; set a $::els::active
    els::open $pb ; set b $::els::active
    set ::els::swap_enabled 1
    [els::W $a] insert end "edit a" ; [els::W $b] insert end "edit b"
    # write_atomic fails ONLY for doc A's swap path; B (and everything else) succeeds
    set apath [els::swap_path [els::session_id] $a]
    rename els::write_atomic _els_wa_real
    proc els::write_atomic {path args} {
        if {$path eq $::_els_failpath} { return "forced failure" }
        return [_els_wa_real $path {*}$args]
    }
    set ::_els_failpath $apath
    # three full all-docs flush passes (the real timer path): A fails every time,
    # B succeeds the first pass then no-ops (content unchanged) — either way healthy
    foreach _ {1 2 3} { els::swap_flush_all }
    list $::els::swap_fail_streak($a) $::els::swap_fail_streak($b) \
         [string match {*crash protection is failing*} [.sb.name cget -text]]
} -cleanup {
    if {[llength [info commands _els_wa_real]]} {
        catch {rename els::write_atomic {}}
        rename _els_wa_real els::write_atomic
    }
    unset -nocomplain ::_els_failpath
    set ::els::swap_enabled 0
} -result {3 0 1}

# ---- right-click context menus + Select All -------------------------------

test ctxmenu-1.1 {the Edit menu offers Select All} -setup {ui_reset} -body {
    set found 0
    for {set i 0} {$i <= [.menu.edit index end]} {incr i} {
        if {[.menu.edit type $i] eq "command" \
                && ![catch {.menu.edit entrycget $i -label} lbl] && $lbl eq "Select All"} {
            set found 1
        }
    }
    set found
} -result 1

test ctxmenu-1.2 {right-click text menu: Cut/Copy track the selection} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "hello world"
    els::popup_text_menu $w 10 10               ;# no selection
    set noSel [list [.txtpop entrycget Cut -state] [.txtpop entrycget Copy -state]]
    $w tag add sel 1.0 1.5
    els::popup_text_menu $w 10 10               ;# with selection
    set withSel [list [.txtpop entrycget Cut -state] [.txtpop entrycget Copy -state]]
    list $noSel $withSel
} -result {{disabled disabled} {normal normal}}

test ctxmenu-1.3 {Undo is disabled on a pristine buffer, enabled after an edit} -setup {ui_reset} -body {
    set w [els::T]
    els::popup_text_menu $w 5 5
    set before [.txtpop entrycget Undo -state]
    $w insert end "typed" ; $w edit separator
    els::popup_text_menu $w 5 5
    set after [.txtpop entrycget Undo -state]
    list $before $after
} -result {disabled normal}

test ctxmenu-1.4 {tab menu: path entries disabled for untitled, enabled for a file; Copy Full Path copies it} -setup {ui_reset} -body {
    set id $::els::active
    els::popup_tab_menu $id 5 5
    set untitled [.tabpop entrycget "Copy Full Path" -state]
    set p [raw_write ctx.txt "hi\n"]
    els::open $p ; set fid $::els::active
    els::popup_tab_menu $fid 5 5
    set filed [.tabpop entrycget "Copy Full Path" -state]
    clipboard clear
    els::tab_copy_path $fid
    set clip [clipboard get]
    list $untitled $filed [string match "*ctx.txt" $clip]
} -result {disabled normal 1}

test ctxmenu-1.5 {Open Containing Folder opens the DIR (no /select), correct for spaced paths} -setup {ui_reset} -body {
    set id $::els::active
    set ::els::docPath($id) "C:/Users/John Doe/notes.txt"
    rename ::exec _els_exec_real
    set ::_els_exec_argv ""
    proc ::exec {args} { set ::_els_exec_argv $args ; return "" }
    els::tab_reveal $id
    rename ::exec {} ; rename _els_exec_real ::exec
    list [string match -nocase "*explorer.exe" [lindex $::_els_exec_argv 0]] \
         [lindex $::_els_exec_argv 1] \
         [string match "*/select,*" $::_els_exec_argv]
} -cleanup {
    if {[llength [info commands _els_exec_real]]} { catch {rename ::exec {}} ; rename _els_exec_real ::exec }
    unset -nocomplain ::_els_exec_argv
} -result {1 {C:\Users\John Doe} 0}

test exec-harden-2.1 {File-Association execs (reg.exe / cmd.exe) use absolute System32 paths, never bare names} -setup {ui_reset} -body {
    rename ::exec _els_exec_real
    set ::_els_argv {}
    proc ::exec {args} { lappend ::_els_argv $args ; return "" }
    els::assoc_run [list reg.exe add {HKCU\X} /v Y /t REG_SZ /d "" /f]  ;# substitutes reg.exe[0]
    catch {els::reg_value {HKCU\Software\Classes\.txt} ""}              ;# absolute reg.exe query
    els::open_default_apps                                              ;# absolute cmd.exe (or open_url)
    rename ::exec {} ; rename _els_exec_real ::exec
    set a [lindex $::_els_argv 0] ; set r [lindex $::_els_argv 1] ; set c [lindex $::_els_argv 2]
    list [string match -nocase {*[/\\]system32[/\\]reg.exe} [lindex $a 0]] \
         [string match -nocase {*[/\\]system32[/\\]reg.exe} [lindex $r 0]] \
         [string match -nocase {*[/\\]system32[/\\]cmd.exe} [lindex $c 0]]
} -cleanup {
    if {[llength [info commands _els_exec_real]]} { catch {rename ::exec {}} ; rename _els_exec_real ::exec }
    unset -nocomplain ::_els_argv
} -result {1 1 1}
