test issue-a.1 {first-run config can no longer be postponed into a recovery-disabled session} \
        -setup {ui_reset ; set ::__cfg_self $::els::selftest} -body {
    set ::els::selftest 1 ; set ::els::config_path ""
    els::config_resolve_existing
    list [expr {$::els::config_path ne ""}] \
         [llength [info commands els::config_postpone_choice]] [winfo exists .cfgask]
} -cleanup {
    set ::els::selftest $::__cfg_self
    set ::els::config_path [file join $::ELS_TMP els.conf]
    unset -nocomplain ::__cfg_self
} -result {1 0 0}

test issue-a.2 {Markdown is not offered in the open/save filetypes} -body {
    string match -nocase "*markdown*" [els::filetypes]
} -result 0

test issue-a.3 {Help menu links to the GitHub repo} -setup {ui_reset} -body {
    set found 0
    for {set i 0} {$i <= [.menu.help index end]} {incr i} {
        if {[.menu.help type $i] eq "command" &&
            [.menu.help entrycget $i -label] eq "els on GitHub"} { set found 1 }
    }
    set found
} -result 1

test issue-a.4 {goto entry rejects non-numeric input at the keyboard} -setup {ui_reset} -body {
    els::goto_line
    catch {wm withdraw .goto}
    .goto.f.e insert 0 abc                     ;# validated: rejected
    set bad [.goto.f.e get]
    .goto.f.e insert 0 42
    set good [.goto.f.e get]
    set def [.goto.f.b.ok cget -default]
    catch {destroy .goto}
    list $bad $good $def
} -result {{} 42 active}

test issue-a.5 {a short path's length is tooltip-only — NOT in the name label, and no red badge} -setup {ui_reset} -body {
    els::open [els_tmpfile ia5.txt "x\n"]
    update idletasks
    els::update_namelabel
    set t [.sb.name cget -text]
    set want [string length [els::display_path $::els::docPath($::els::active)]]
    # the filename shows, the "[N]" count does NOT ride in the label, and no length
    # badge is packed (the path is well under PATH_WARN_LEN) — but the count is still
    # preserved in the path tooltip helper.
    list [string match "*ia5.txt*" $t] \
         [expr {![string match "*\\\[$want\\\]*" $t]}] \
         [expr {[lsearch -exact [pack slaves .sb] .sb.plen] < 0}] \
         [string match "*\\\[$want\\\]" [els::path_tip $::els::docPath($::els::active)]]
} -result {1 1 1 1}

test issue-a.6 {the update indicator has a hover state} -setup {ui_reset} -body {
    list [expr {[bind .sb.update <Enter>] ne ""}] [expr {[bind .sb.update <Leave>] ne ""}]
} -result {1 1}

# ---- statusbar regressions: redundant tooltip + narrow-window flicker -------

test sbtip-1.1 {no tooltip while the whole path is shown; tip returns once it elides} -setup {ui_reset} -body {
    els::open [els_tmpfile tip1.txt "x\n"]
    update idletasks ; els::update_namelabel
    set fits [els::name_tip]                       ;# short path in a 900px bar: fits
    # force elision: a path far wider than the label
    set ::els::docPath($::els::active) [file join $::ELS_TMP [string repeat verylongsegment/ 20] tip1.txt]
    els::update_namelabel
    set elided [els::name_tip]
    list $fits [expr {$elided eq [els::path_tip $::els::docPath($::els::active)]}] \
        [string match "…*" [.sb.name cget -text]]
} -result {{} 1 1}

test sbflick-1.1 {the name label's geometry request is text-independent (no layout feedback)} -setup {ui_reset} -body {
    els::open [els_tmpfile fl1.txt "x\n"]
    update idletasks ; els::update_namelabel
    set short [winfo reqwidth .sb.name]
    set ::els::docPath($::els::active) [file join $::ELS_TMP [string repeat directory/ 30] fl1.txt]
    els::update_namelabel ; update idletasks
    set long [winfo reqwidth .sb.name]
    expr {$short == $long}
} -result 1

test sbflick-1.2 {a very narrow window reaches a stable elision (fixed point, no oscillation)} -setup {ui_reset} -body {
    els::open [els_tmpfile fl2-with-a-longer-name.txt "x\n"]
    wm geometry . 280x200 ; update
    els::update_namelabel ; update
    set t1 [.sb.name cget -text]
    els::update_namelabel ; update                ;# recompute at the same width:
    set t2 [.sb.name cget -text]                  ;# must be the identical text
    els::update_namelabel ; update
    set t3 [.sb.name cget -text]
    list [string equal $t1 $t2] [string equal $t2 $t3] [llength $::els_test_bgerrors]
} -cleanup {
    wm geometry . 900x620+100+100 ; update
} -result {1 1 0}

test issue-a.7 {find/replace entries grow a clear button while non-empty} -setup {ui_reset} -body {
    els::find_show find ; update idletasks
    set ::els::find_q "needle" ; update idletasks
    set shown [winfo ismapped .find.fr.q.clearx]
    event generate .find.fr.q.clearx <Button-1> ; update
    list $shown $::els::find_q [winfo ismapped .find.fr.q.clearx]
} -result {1 {} 0}
test recentvs-b.1 {the Manage List scrollbar appears only when the list overflows} -setup {ui_reset} -body {
    # the dialog is withdrawn for test hygiene, so a child's `winfo ismapped` is
    # always 0 — assert on grid membership (manager "grid" vs removed "") instead
    set ::els::recent [list [els_tmpfile rvs1.txt "x\n"]]
    els::recent_manage ; catch {wm withdraw .recent}
    update idletasks ; els::recent_vs_apply
    set few [winfo manager .recent.f.vs]
    set many {}
    for {set i 0} {$i < 30} {incr i} { lappend many [file join $::ELS_TMP "rvs_$i.txt"] }
    set ::els::recent $many
    els::recent_manage_refresh
    update idletasks ; els::recent_vs_apply
    set lots [winfo manager .recent.f.vs]
    catch {destroy .recent}
    list $few $lots
} -result {{} grid}

test reg-1.1 {Reopen-with-Encoding keeps edits saved since open (docRaw refreshed on save)} -setup {ui_reset} -body {
    set p [els_tmpfile reg11.txt "original line\n"]
    els::open $p
    set w [els::T]
    $w insert end "EDITED ADDITION\n"
    els::save
    els::reopen_with utf-8 0
    string match *EDITED* [$w get 1.0 "end - 1 char"]
} -result 1

test reg-1.2 {Reopen-with-Encoding on a Save-As'd new document keeps its content} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "BRAND NEW CONTENT\n"
    set ::els_test_savefile [file join $::ELS_TMP reg12.txt]
    els::saveas
    els::reopen_with utf-8 0
    expr {[$w get 1.0 "end - 1 char"] ne ""}
} -result 1

test reg-2.1 {Replace uses the floating findOne tag, not a stale index, after a manual edit} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "cat cat cat"
    set ::els::find_q cat ; set ::els::find_mode find
    els::find_update
    $w insert 1.0 "XYZ- "
    set ::els::find_r dog
    els::find_replace_one
    set t [$w get 1.0 "end - 1 char"]
    list [string match *XYZ-* $t] [regexp -all dog $t]
} -result {1 1}

test reg-3.1 {zero-width regex counts every boundary and Replace All follows Tcl progress rules} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "abc"
    set ::els::find_regex 1 ; set ::els::find_q {x*} ; set ::els::find_mode find
    els::find_update
    set m [llength $::els::find_matches]
    set ::els::find_r Q
    els::find_replace_all
    list $m [$w get 1.0 "end - 1 char"]
} -result {4 QaQbQcQ}

test reg-4.1 {Ctrl+H in the find field switches to replace without eating a character} -setup {ui_reset} -body {
    els::find_show find
    set e .find.fr.q
    focus -force $e
    $e delete 0 end ; $e insert 0 foobar ; $e icursor end ; update
    event generate $e <Control-h> ; update
    list [$e get] $::els::find_mode
} -result {foobar replace}

test reg-5.1 {an ASCII file with a stray NUL is read as text, not misdetected as UTF-16} -setup {ui_reset} -body {
    set p [raw_write reg51.txt "field1\x00field2 the quick brown fox jumps over the lazy dog\n"]
    set id [els::open $p]
    list $::els::docEnc($id) [string match *field2* [[els::T] get 1.0 "end - 1 char"]]
} -result {utf-8 1}

test reg-5.2 {a genuine BOM-less UTF-16LE ASCII file is still detected as wide} -constraints detect -setup {ui_reset} -body {
    set p [raw_write reg52.txt [encoding convertto utf-16le "The quick brown fox jumps over the lazy dog.\n"]]
    set id [els::open $p]
    list $::els::docEnc($id) [string match *quick* [[els::T] get 1.0 "end - 1 char"]]
} -result {utf-16le 1}

test reg-6.1 {Save As onto a path already open in another tab is refused (no lost update)} -setup {ui_reset} -body {
    set shared [file join $::ELS_TMP reg61.txt]
    set fh [open $shared w] ; puts $fh "ORIGINAL" ; close $fh
    set id1 [els::open $shared]
    set id2 [els::new_doc]
    [els::T] insert end "FROM TAB 2"
    set ::els_test_savefile $shared
    els::saveas
    set fh [open $shared r] ; set disk [string trim [read $fh]] ; close $fh
    list $::els::docPath($id2) $disk
} -result {{} ORIGINAL}

test reg-6.2 {config save is atomic: a mid-build throw leaves the old config intact} -setup {ui_reset} -cleanup {
    catch {rename els::session_current_files {}}
    catch {rename _els_scf els::session_current_files}
} -body {
    set f [els::config_file]
    els::save_geometry
    set fh [open $f r] ; set good [read $fh] ; close $fh
    rename els::session_current_files _els_scf
    proc els::session_current_files {} { error boom }
    els::save_geometry
    set fh [open $f r] ; set after [read $fh] ; close $fh
    list [expr {$after eq $good && [string length $good] > 0}] [file exists $f.tmp]
} -result {1 0}

# ---- atomic document save (robustness P0) -------------------------------
# The old els::save did `open $path w` (truncate-then-write): a crash / disk-full
# / I/O error mid-write left the user's file 0 bytes.  els::write_atomic writes a
# same-dir temp then renames it over the target, so the original is never touched
# until a complete new copy exists.  save-atomic-1.1 is RED on the old code.
test save-atomic-1.1 {a mid-write failure leaves the original file intact (no truncation)} -setup {ui_reset} -cleanup {
    catch {rename els::_save_emit {}}
    catch {rename _els_save_emit els::_save_emit}
} -body {
    set p [raw_write savefault.txt "ORIGINAL CONTENT\n"]
    els::open $p
    [els::W $::els::active] insert end "EDIT THAT MUST NOT REACH DISK"
    rename els::_save_emit _els_save_emit                 ;# force a mid-write crash
    proc els::_save_emit {chan bytes} { error "simulated mid-write failure" }
    set rc [els::save]
    set ondisk [raw_read $p]
    set residue [glob -nocomplain -directory $::ELS_TMP .els-save-*.tmp]
    list $rc [expr {$ondisk eq "ORIGINAL CONTENT\n"}] \
         [[els::W $::els::active] edit modified] [llength $residue]
} -result {0 1 1 0}

test save-atomic-1.2 {a clean save writes the new content and leaves no temp residue} -setup {ui_reset} -body {
    set p [raw_write saveok.txt "old\n"]
    els::open $p
    set w [els::W $::els::active]
    $w delete 1.0 end ; $w insert end "brand new content"
    set rc [els::save]
    set ondisk [raw_read $p]
    set residue [glob -nocomplain -directory $::ELS_TMP .els-save-*.tmp]
    list $rc [expr {$ondisk eq "brand new content"}] \
         [[els::W $::els::active] edit modified] [llength $residue]
} -result {1 1 0 0}

test save-atomic-1.3 {a read-only target is refused and left intact (matches old behavior)} -setup {ui_reset} -body {
    set p [raw_write savero.txt "keep me\n"]
    els::open $p
    [els::W $::els::active] insert end "should not be written"
    file attributes $p -readonly 1
    set rc [els::save]
    set ondisk [raw_read $p]
    file attributes $p -readonly 0
    list $rc [expr {$ondisk eq "keep me\n"}] [[els::W $::els::active] edit modified]
} -result {0 1 1}

test reg-7.1 {Whole Word + Regex alternation does not match inside larger words} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "foo bar foobar"
    set ::els::find_regex 1 ; set ::els::find_word 1 ; set ::els::find_q {foo|bar}
    set ::els::find_mode find
    els::find_update
    llength $::els::find_matches
} -result 2

# ---- UX polish ----------------------------------------------------------
test ui-3.4 {Ctrl+K / Ctrl+T do nothing (Tk's emacs Text defaults neutralized; Ctrl+D is now Duplicate Line)} -setup {ui_reset} -body {
    set w [els::T] ; $w insert end "hello world"
    $w mark set insert 1.0
    event generate $w <Control-k> ; event generate $w <Control-t>
    update
    els_text
} -result {hello world}

test ui-4.14 {find highlights are cleared from a tab when you switch away} -setup {ui_reset} -body {
    set a $::els::active
    [els::W $a] insert end "match match match"
    set ::els::find_q match ; set ::els::find_mode find ; els::find_update
    set hadA [expr {[llength [[els::W $a] tag ranges findAll]] > 0}]
    els::new_doc                ;# switch to a new tab
    set orphanA [expr {[llength [[els::W $a] tag ranges findAll]] > 0}]
    list $hadA $orphanA
} -result {1 0}

test ui-4.15 {F3 / Shift+F3 step to the next / previous match} -setup {ui_reset} -body {
    set w [els::T] ; $w insert end "x x x x"
    set ::els::find_q x ; set ::els::find_mode find ; els::find_update
    set c0 $::els::find_current
    # focus the text widget before synthesizing the keys: a bare `event generate
    # <Key-F3>` occasionally does not reach the binding (an event-delivery race,
    # ~1/120, more visible under Tk 9.0.4 timing), which stranded find_current.
    # Same convention as ui_type_find; the product's real F3 handling is fine.
    focus -force $w ; update
    event generate $w <Key-F3>       ; update ; set c1 $::els::find_current
    event generate $w <Shift-Key-F3> ; update ; set c2 $::els::find_current
    list $c0 $c1 $c2
} -result {0 1 0}

test update-1.3 {clicking the update notice dismisses its tooltip} -setup {
    ui_reset
    rename ::els::open_url ::els_test_real_open_url
    set ::els_test_url ""
    proc ::els::open_url {u} { set ::els_test_url $u }
} -body {
    els::tip_pop .sb.update "els 9.9 is available"
    set shown [winfo exists .tip]
    event generate .sb.update <Button-1> -x 2 -y 2
    update
    list $shown [winfo exists .tip] [expr {$::els_test_url ne ""}]
} -cleanup {
    rename ::els::open_url {} ; rename ::els_test_real_open_url ::els::open_url
} -result {1 0 1}

# A long document shows the scrollbar AND it has a real (non-collapsed) width —
# the custom arrow-less style once collapsed it to 1px (invisible) on big files.
test ui-7.2 {the vertical scrollbar is shown with a real (chunky) width} -setup {ui_reset} -body {
    set w [els::T]
    for {set i 0} {$i < 2000} {incr i} { $w insert end "line $i\n" }
    els::refresh_view ; update
    # mapped and not collapsed — guards the 1px regression.  Width is a points
    # value scaled per-DPI, so use a low, DPI-agnostic floor rather than a px count
    list [winfo ismapped .vs] [expr {[winfo reqwidth .vs] >= 8}]
} -result {1 1}

# The horizontal bar appears only when wrap is OFF and a line runs past the edge:
# short lines -> hidden; one very long line -> shown.
test ui-7.3 {the horizontal scrollbar shows only when wrap is off and a line overflows} -setup {ui_reset} -body {
    set ::els::word_wrap 0 ; els::set_wrap 0
    set w [els::T]
    $w insert end "short\nlines\nonly\n"
    els::refresh_view ; ui_settle ; els::update_hscroll
    set short $::els::hs_shown
    $w insert end [string repeat "the quick brown fox " 80]
    els::refresh_view ; ui_settle ; els::update_hscroll
    list $short $::els::hs_shown
} -result {0 1}

# Word wrap removes the need to scroll sideways: turning it on hides the
# horizontal bar, turning it off again brings it back for the same long line.
test ui-7.4 {word wrap hides the horizontal bar; turning it off restores it} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end [string repeat "the quick brown fox " 80]
    set ::els::word_wrap 0 ; els::set_wrap 0
    els::refresh_view ; ui_settle ; els::update_hscroll
    set off1 $::els::hs_shown
    set ::els::word_wrap 1 ; els::set_wrap 0
    ui_settle ; els::update_hscroll
    set on $::els::hs_shown
    set ::els::word_wrap 0 ; els::set_wrap 0
    ui_settle ; els::update_hscroll
    list $off1 $on $::els::hs_shown
} -result {1 0 1}

# The horizontal bar is a real (chunky) bar, and its thickness matches the
# vertical one exactly (both styled with the same 12p arrows) so they read as one.
test ui-7.5 {the horizontal scrollbar is chunky and matches the vertical thickness} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end [string repeat "the quick brown fox " 80]
    els::refresh_view ; ui_settle ; els::update_hscroll
    list [winfo ismapped .hs] [expr {[winfo reqheight .hs] >= 8}] \
         [expr {[winfo reqheight .hs] == [winfo reqwidth .vs]}]
} -result {1 1 1}

# The caret is a chunky bar sized against the text, so it must scale with zoom.
# Held at a fixed 3p it covered ~90% of a character cell at zoom 6 and ~11% at zoom
# 48; it now scales linearly, capped at 2x the base so extreme zoom stays sane.
test ui-7.7 {the caret width scales with zoom, is capped, and is unchanged at the default} \
        -setup {ui_reset} -cleanup {els::set_font_size 11 0} -body {
    set w [els::T]
    set base [expr {max(1, round([winfo fpixels . 3p]))}]
    els::set_font_size 11 0 ; set at11 [winfo pixels $w [$w cget -insertwidth]]
    els::set_font_size 6  0 ; set at6  [winfo pixels $w [$w cget -insertwidth]]
    els::set_font_size 48 0 ; set at48 [winfo pixels $w [$w cget -insertwidth]]
    list [expr {$at11 == $base}] \
         [expr {$at6 < $at11}] \
         [expr {$at48 > $at11}] \
         [expr {$at48 == 2*$base}] \
         [expr {$at6 >= 1}]
} -result {1 1 1 1 1}

# Anti-flicker: showing the h-bar steals a row of height, which can push a wide line
# below the fold so it "fits" -> hide -> the row returns -> overflow -> show, an
# infinite toggle (worst with line numbers off at the top of a tall file).  A HIDE
# that reflects NO genuine change since the bar was shown (same scroll position,
# width, and edit epoch) must be suppressed; a real change (here, an edit that bumps
# the epoch) releases it.
test ui-7.6 {a horizontal-bar hide with no genuine change since it was shown is suppressed} -setup {ui_reset} -body {
    set ::els::word_wrap 0 ; els::set_wrap 0
    set w [els::T]
    $w insert end "short\nlines\nonly\n"        ;# fits horizontally -> need=0
    els::refresh_view ; ui_settle ; els::update_hscroll
    # pretend the bar is currently shown at THIS exact sig (as a self-induced reflow would leave it)
    grid .hs ; set ::els::hs_shown 1 ; set ::els::hs_gate_sig [els::hscroll_sig $w]
    els::update_hscroll                          ;# need=0, sig unchanged -> MUST hold
    set held [expr {[llength [grid info .hs]] > 0}]
    incr ::els::docEpoch($::els::active)         ;# a real edit changes the sig
    els::update_hscroll                          ;# now the hide is allowed
    set released [expr {[llength [grid info .hs]] > 0}]
    list $held $released
} -result {1 0}

# The find count area must fit a large "N of M" without clipping (the label was
# 11 chars; a 20k-match file produced "15912 of 20631" and got truncated).
test ui-4.16 {the find count label fits a large match count without clipping} -setup {ui_reset} -body {
    els::find_show find
    set ::els::find_count "15912 of 20631"
    update idletasks
    expr {[winfo reqwidth .find.fr.n] >= [font measure elsUI "15912 of 20631"]}
} -result 1

# ---- bug-hunt wave 5: recent dialog, tooltips, menu undo -------------------

test recent-5.1 {Manage List stays path-correct after recent_add reorders it} -setup {ui_reset} -body {
    set pa [file normalize [els_tmpfile r5a.txt "A\n"]]
    set pb [file normalize [els_tmpfile r5b.txt "B\n"]]
    set ::els::recent [list $pa $pb]
    els::recent_manage ; catch {wm withdraw .recent}
    .recent.f.list selection clear 0 end
    .recent.f.list selection set 1             ;# select pb
    els::recent_manage_select                   ;# selection now tracked by path
    els::recent_add [file normalize [els_tmpfile r5c.txt "C\n"]]   ;# reorders
    set agree [string equal [els::recent_manage_path] $pb]
    set rows [.recent.f.list size]
    catch {destroy .recent}
    list $agree [expr {$rows == [llength $::els::recent]}]
} -result {1 1}

test recent-5.2 {a failed Open keeps the Manage List dialog up} -setup {ui_reset} -body {
    set dir [file join $::ELS_TMP r5dir] ; file mkdir $dir
    set ::els::recent [list $dir]               ;# exists, but cannot be opened
    els::recent_manage ; catch {wm withdraw .recent}
    .recent.f.list selection set 0
    els::recent_manage_open
    set alive [winfo exists .recent]
    catch {destroy .recent}
    list $alive [llength $::els::docs]
} -result {1 1}

test recent-5.3 {hovering the empty area below the rows schedules no tip} -setup {ui_reset} -body {
    set long [file join $::ELS_TMP [string repeat verylongdirname 8] r5long.txt]
    set ::els::recent [list $long]              ;# elided row -> tip applies
    # A full `update` (not just update idletasks) realizes the listbox width the
    # elision and bbox depend on -- a headless release-suite child never maps a
    # withdrawn dialog, so update idletasks alone leaves winfo width 1 (avail 100000,
    # no elision, no tip).  Realize, re-elide, then withdraw.
    els::recent_manage ; update ; els::recent_manage_refresh
    catch {wm withdraw .recent}
    update idletasks
    els::tip_cancel ; set ::els::recent_row_tip -1
    els::recent_row_motion 5 5 100 100          ;# inside row 0
    set inRow [info exists ::els::tip_after]
    els::tip_cancel ; set ::els::recent_row_tip -1
    set below [expr {[winfo reqheight .recent.f.list] - 5}]
    els::recent_row_motion 5 $below 100 100     ;# empty area below the row
    set inGap [info exists ::els::tip_after]
    catch {destroy .recent}
    list $inRow $inGap
} -result {1 0}

test recent-5.4 {destroying the Manage List dialog cancels a pending row tip} -setup {ui_reset} -body {
    set long [file join $::ELS_TMP [string repeat verylongdirname 8] r5d.txt]
    set ::els::recent [list $long]
    # realize the listbox width before withdrawing (see recent-5.3): a headless
    # release-suite child leaves a withdrawn dialog's winfo width 1 under
    # update idletasks alone, so the row never elides and no tip is scheduled.
    els::recent_manage ; update ; els::recent_manage_refresh
    catch {wm withdraw .recent}
    update idletasks
    els::tip_cancel ; set ::els::recent_row_tip -1
    els::recent_row_motion 5 5 100 100          ;# schedules the after-550 tip
    set pend [info exists ::els::tip_after]
    destroy .recent                              ;# dialog dies before it fires
    after 700 {set ::__tipwait 1} ; vwait ::__tipwait
    list $pend [winfo exists .tip]
} -result {1 0}

test tip-5.1 {destroying a tooltip's anchor removes a visible tip} -setup {ui_reset} -body {
    button .tmpb -text x
    els::tooltip .tmpb "tip text"
    els::tip_pop .tmpb "tip text"
    set vis [winfo exists .tip]
    destroy .tmpb                                ;# <Destroy> hook fires
    list $vis [winfo exists .tip]
} -result {1 0}

test tip-5.2 {clicking a tab dismisses its visible tooltip and still switches} -setup {ui_reset} -body {
    set a $::els::active
    els::new_doc ; update
    set tf [els::tabW $a]
    els::tip_pop $tf "path tip"
    set vis [winfo exists .tip]
    event generate $tf <ButtonPress-1> ; update
    list $vis [winfo exists .tip] [expr {$::els::active eq $a}]
} -result {1 0 1}

test undo-5.1 {menu Undo refreshes Ln/Col and the current-line wash} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "one\n" ; $w edit separator ; $w insert end "two\n"
    $w mark set insert 2.3 ; els::refresh_view
    els::menu_undo ; ui_settle
    lassign [split [$w index insert] .] L C
    set fresh [string equal [.sb.pos cget -text] "$L:[expr {$C + 1}]"]
    list $fresh [expr {[llength [$w tag ranges currentLine]] > 0}]
} -result {1 1}

# ---- R6: production bgerror + rotating els.log + failure visibility -------

test log-6.1 {els::log appends a timestamped, levelled line to els.log next to els.conf} -setup {ui_reset} -body {
    set lf [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $lf}
    els::log info "hello from the log"
    set txt [raw_read $lf]
    catch {file delete -force $lf}
    list [string match {*\[info\] hello from the log*} $txt] \
         [regexp {^[0-9]{4}-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] } $txt]
} -result {1 1}

test log-6.2 {els.log rotates to els.log.1 past the ~256 KB cap, then starts fresh} -setup {ui_reset} -body {
    set lf [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $lf} ; catch {file delete -force $lf.1}
    set fh [open $lf w] ; puts -nonewline $fh [string repeat x 300000] ; close $fh
    els::log info "after rotation"
    set rotated [file exists $lf.1]
    set fresh [raw_read $lf]
    catch {file delete -force $lf} ; catch {file delete -force $lf.1}
    list $rotated [string match {*after rotation*} $fresh] [string match {*xxxxx*} $fresh]
} -result {1 1 0}

test log-6.3 {the reentry latch stops els::log recursing (a logging failure cannot loop)} -setup {ui_reset} -cleanup {set ::els::log_active 0} -body {
    set lf [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $lf}
    set ::els::log_active 1                 ;# simulate "already inside els::log"
    els::log info "should not appear"
    set ::els::log_active 0
    set existed [file exists $lf]
    catch {file delete -force $lf}
    set existed
} -result 0

test log-6.4 {a message with a lone surrogate is written whole, not cut off mid-line (pa-2)} -setup {ui_reset} -body {
    set lf [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $lf}
    els::log warn "before\uD800after"          ;# strict utf-8 would throw after "before"
    set data [raw_read $lf]
    catch {file delete -force $lf}
    list [string match "*after*" $data] [expr {[string index $data end] eq "\n"}]
} -result {1 1}

test bgerror-6.4 {els::bgerror logs the trace and posts one non-modal note, never raises} -setup {ui_reset} -body {
    set lf [file join [file dirname $::els::config_path] els.log]
    catch {file delete -force $lf}
    set rc [catch {els::bgerror "boom" [dict create -errorinfo "boom\n  while executing \"X\""]}]
    set txt [raw_read $lf]
    catch {file delete -force $lf}
    list $rc [string match {*while executing*} $txt] \
         [string match {*internal error*} [.sb.name cget -text]]
} -result {0 1 1}

# ---- right-click context menus + Select All -------------------------------

test ctxmenu-1.1 {the Edit menu offers Select All} -setup {ui_reset} -body {
    set found 0
    for {set i 0} {$i <= [.menu.edit index end]} {incr i} {
        if {[.menu.edit type $i] eq "command" \
                && ![catch {.menu.edit entrycget $i -label} lbl] && $lbl eq "Select All"} {
            set found 1
        }
    }
    set found
} -result 1

test ctxmenu-1.2 {right-click text menu: Cut/Copy track the selection} -setup {ui_reset} -body {
    set w [els::T]
    $w insert end "hello world"
    els::popup_text_menu $w 10 10               ;# no selection
    set noSel [list [.txtpop entrycget Cut -state] [.txtpop entrycget Copy -state]]
    $w tag add sel 1.0 1.5
    els::popup_text_menu $w 10 10               ;# with selection
    set withSel [list [.txtpop entrycget Cut -state] [.txtpop entrycget Copy -state]]
    list $noSel $withSel
} -result {{disabled disabled} {normal normal}}

test cutpaste-1.1 {Cut removes the selection to the clipboard and Paste restores it (round-trip)} -setup {ui_reset} -body {
    set id [els::new_doc] ; set w [els::W $id]
    $w insert end "ONETWO"
    $w tag add sel 1.0 1.3                       ;# select "ONE"
    els::menu_event <<Cut>> ; update             ;# routes to the active doc's widget
    set afterCut [els_text $id]                  ;# "ONE" removed from the buffer
    $w mark set insert "end - 1 chars"           ;# end of the text, before the final \n
    els::menu_event <<Paste>> ; update           ;# clipboard "ONE" reinserted
    list $afterCut [els_text $id]
} -result {TWO TWOONE}

test ctxmenu-1.3 {Undo is disabled on a pristine buffer, enabled after an edit} -setup {ui_reset} -body {
    set w [els::T]
    els::popup_text_menu $w 5 5
    set before [.txtpop entrycget Undo -state]
    $w insert end "typed" ; $w edit separator
    els::popup_text_menu $w 5 5
    set after [.txtpop entrycget Undo -state]
    list $before $after
} -result {disabled normal}

test ctxmenu-1.4 {tab menu: path entries disabled for untitled, enabled for a file; Copy Full Path copies it} -setup {ui_reset} -body {
    set id $::els::active
    els::popup_tab_menu $id 5 5
    set untitled [.tabpop entrycget "Copy Full Path" -state]
    set p [raw_write ctx.txt "hi\n"]
    els::open $p ; set fid $::els::active
    els::popup_tab_menu $fid 5 5
    set filed [.tabpop entrycget "Copy Full Path" -state]
    clipboard clear
    els::tab_copy_path $fid
    set clip [clipboard get]
    list $untitled $filed [string match "*ctx.txt" $clip]
} -result {disabled normal 1}

test ctxmenu-1.5 {Open Containing Folder sends the literal spaced DIR to the native helper} -setup {
    ui_reset
    set ::_els_ctx_had_native [llength [info commands ::els::win_open_folder]]
    if {$::_els_ctx_had_native} {
        rename ::els::win_open_folder ::els::win_open_folder_ctx_real
    }
    set ::_els_ctx_folder ""
    proc ::els::win_open_folder {dir} { set ::_els_ctx_folder $dir ; return "" }
} -body {
    set id $::els::active
    set ::els::docPath($id) "C:/Users/John Doe/notes.txt"
    els::tab_reveal $id
    list $::_els_ctx_folder [string match "*/select,*" $::_els_ctx_folder]
} -cleanup {
    catch {rename ::els::win_open_folder {}}
    if {$::_els_ctx_had_native && \
            [llength [info commands ::els::win_open_folder_ctx_real]]} {
        rename ::els::win_open_folder_ctx_real ::els::win_open_folder
    }
    unset -nocomplain ::_els_ctx_had_native ::_els_ctx_folder
} -result {{C:\Users\John Doe} 0}

test ctxmenu-1.6 {extended right-click items exist; file items grey out for an untitled doc} -setup {ui_reset} -body {
    set w [els::T]
    els::popup_text_menu $w 5 5                       ;# untitled active doc
    set findState  [.txtpop entrycget "Find..." -state]
    set gotoState  [.txtpop entrycget "Go to Line..." -state]
    set reloadUnt  [.txtpop entrycget "Reload from Disk" -state]
    set copyUnt    [.txtpop entrycget "Copy Full Path" -state]
    set p [raw_write ctxext.txt "hi\n"] ; els::open $p
    els::popup_text_menu [els::T] 5 5                 ;# file-backed active doc
    set reloadFiled [.txtpop entrycget "Reload from Disk" -state]
    set openFiled   [.txtpop entrycget "Open Containing Folder" -state]
    list $findState $gotoState $reloadUnt $copyUnt $reloadFiled $openFiled
} -result {normal normal disabled disabled normal normal}

test exec-harden-2.1 {File-Association execs (reg.exe / cmd.exe) use absolute System32 paths, never bare names} -setup {ui_reset} -body {
    rename ::exec _els_exec_real
    set ::_els_argv {}
    proc ::exec {args} { lappend ::_els_argv $args ; return "" }
    els::assoc_run [list reg.exe add {HKCU\X} /v Y /t REG_SZ /d "" /f]  ;# substitutes reg.exe[0]
    catch {els::reg_value {HKCU\Software\Classes\.txt} ""}              ;# absolute reg.exe query
    els::open_default_apps                                              ;# absolute cmd.exe (or open_url)
    rename ::exec {} ; rename _els_exec_real ::exec
    set a [lindex $::_els_argv 0] ; set r [lindex $::_els_argv 1] ; set c [lindex $::_els_argv 2]
    list [string match -nocase {*[/\\]system32[/\\]reg.exe} [lindex $a 0]] \
         [string match -nocase {*[/\\]system32[/\\]reg.exe} [lindex $r 0]] \
         [string match -nocase {*[/\\]system32[/\\]cmd.exe} [lindex $c 0]]
} -cleanup {
    if {[llength [info commands _els_exec_real]]} { catch {rename ::exec {}} ; rename _els_exec_real ::exec }
    unset -nocomplain ::_els_argv
} -result {1 1 1}

# ---- drag-and-drop (native windrop; Tcl-side behaviour) ----------------------
# The WM_DROPFILES path itself is native (src/windrop.c) and can't fire in-process,
# so these cover the Tcl seam: graceful degradation where the helper is absent, the
# HWND wiring where it's present, and els::drop_open's open/skip/switch/raise logic.

test drop-1.1 {drop_register is a graceful no-op when the native helper is absent} -setup {ui_reset} -body {
    # the in-process harness has no windrop (it's compiled only into els.exe), so
    # registration must simply do nothing — a dev tclsh run still builds a full UI
    list [llength [info commands ::els::win_drop_register]] [els::drop_register [els::T]]
} -result {0 {}}

test drop-1.2 {drop_register hands the window's HWND to the native helper when present} -setup {ui_reset} -body {
    set ::_drop_hwnds {}
    proc ::els::win_drop_register {hwnd} { lappend ::_drop_hwnds $hwnd ; return "" }
    els::drop_register [els::T]
    expr {[lindex $::_drop_hwnds 0] eq [winfo id [els::T]]}
} -cleanup {
    catch {rename ::els::win_drop_register {}}
    unset -nocomplain ::_drop_hwnds
} -result 1

test drop-1.3 {new_doc registers its own text widget as a drop target} -setup {ui_reset} -body {
    set ::_drop_hwnds {}
    proc ::els::win_drop_register {hwnd} { lappend ::_drop_hwnds $hwnd ; return "" }
    set id [els::new_doc]
    expr {[winfo id [els::W $id]] in $::_drop_hwnds}
} -cleanup {
    catch {rename ::els::win_drop_register {}}
    unset -nocomplain ::_drop_hwnds
} -result 1

test drop-1.4 {drop_open opens each dropped file as a tab (first reuses the pristine tab) and raises once} -setup {ui_reset} -body {
    rename ::els::raise_window ::_els_raise_real
    set ::_drop_raised 0
    proc ::els::raise_window {} { incr ::_drop_raised }
    set a [els_tmpfile drop_a.txt "alpha\n"]
    set b [els_tmpfile drop_b.txt "beta\n"]
    els::drop_open [list $a $b]
    rename ::els::raise_window {} ; rename ::_els_raise_real ::els::raise_window
    set names {}
    foreach id $::els::docs { lappend names [file tail $::els::docPath($id)] }
    list [llength $::els::docs] [lsort $names] $::_drop_raised
} -cleanup {
    if {[llength [info commands ::_els_raise_real]]} { catch {rename ::els::raise_window {}} ; rename ::_els_raise_real ::els::raise_window }
    unset -nocomplain ::_drop_raised
} -result {2 {drop_a.txt drop_b.txt} 1}

test drop-1.5 {drop_open skips directories, missing paths, and empty strings} -setup {ui_reset} -body {
    rename ::els::raise_window ::_els_raise_real
    proc ::els::raise_window {} {}
    set real [els_tmpfile drop_real.txt "hi\n"]
    set dir  [file join $::ELS_TMP drop_as_dir] ; file mkdir $dir
    set gone [file join $::ELS_TMP drop_missing_xyz.txt] ; catch {file delete -force $gone}
    els::drop_open [list "" $dir $gone $real]
    rename ::els::raise_window {} ; rename ::_els_raise_real ::els::raise_window
    list [llength $::els::docs] [file tail $::els::docPath($::els::active)]
} -cleanup {
    if {[llength [info commands ::_els_raise_real]]} { catch {rename ::els::raise_window {}} ; rename ::_els_raise_real ::els::raise_window }
} -result {1 drop_real.txt}

test drop-1.6 {an all-invalid drop opens nothing, never raises, and keeps the pristine tab} -setup {ui_reset} -body {
    rename ::els::raise_window ::_els_raise_real
    set ::_drop_raised 0
    proc ::els::raise_window {} { incr ::_drop_raised }
    set dir  [file join $::ELS_TMP drop_only_dir] ; file mkdir $dir
    set gone [file join $::ELS_TMP drop_none_xyz.txt] ; catch {file delete -force $gone}
    set before [llength $::els::docs]
    els::drop_open [list "" $dir $gone]
    rename ::els::raise_window {} ; rename ::_els_raise_real ::els::raise_window
    list $before [llength $::els::docs] $::_drop_raised [els::doc_name $::els::active]
} -cleanup {
    if {[llength [info commands ::_els_raise_real]]} { catch {rename ::els::raise_window {}} ; rename ::_els_raise_real ::els::raise_window }
    unset -nocomplain ::_drop_raised
} -result {1 1 0 untitled}

test drop-1.7 {drop_open on an already-open file switches to it, no duplicate tab} -setup {ui_reset} -body {
    rename ::els::raise_window ::_els_raise_real
    proc ::els::raise_window {} {}
    set p [els_tmpfile drop_dup.txt "x\n"]
    els::open $p ; set fid $::els::active
    els::new_doc                                  ;# move focus onto a fresh tab
    els::drop_open [list $p]
    rename ::els::raise_window {} ; rename ::_els_raise_real ::els::raise_window
    list [llength $::els::docs] [expr {$::els::active eq $fid}]
} -cleanup {
    if {[llength [info commands ::_els_raise_real]]} { catch {rename ::els::raise_window {}} ; rename ::_els_raise_real ::els::raise_window }
} -result {2 1}

test drop-1.8 {a native drop waits until the active modal guard has closed} \
        -setup {ui_reset} -body {
    rename ::els::raise_window ::_els_raise_real
    set ::_drop_raised 0
    proc ::els::raise_window {} { incr ::_drop_raised }
    set p [els_tmpfile drop_modal.txt "deferred\n"]
    set ::els::swap_suspend 1
    els::drop_open [list $p]
    set during [list [els::doc_name $::els::active] [llength $::els::drop_pending] \
        [expr {$::els::drop_after ne ""}] $::_drop_raised]
    catch {after cancel $::els::drop_after}
    set ::els::drop_after ""
    set ::els::swap_suspend 0
    els::drop_resume
    rename ::els::raise_window {} ; rename ::_els_raise_real ::els::raise_window
    list $during [file tail $::els::docPath($::els::active)] \
        [llength $::els::drop_pending] $::els::drop_after $::_drop_raised
} -cleanup {
    catch {after cancel $::els::drop_after}
    set ::els::drop_after ""
    set ::els::drop_pending {}
    set ::els::swap_suspend 0
    if {[llength [info commands ::_els_raise_real]]} { catch {rename ::els::raise_window {}} ; rename ::_els_raise_real ::els::raise_window }
    unset -nocomplain ::_drop_raised
} -result {{untitled 1 1 0} drop_modal.txt 0 {} 1}

# ---- 0.95 hardening regressions (bug-hunt findings) ----------------------
test tabs-1.8 {reordering untitled tabs relabels every tab, not just the dragged one (R17)} -setup {ui_reset} -body {
    set a $::els::active
    set b [els::new_doc]
    els::refresh_tabs
    els::switch_to $b
    set ::els::docs [list $b $a]      ;# simulate a drag that moved b before a
    els::tab_repack
    # before the fix both tabs read the same positional identity ("untitled 1")
    expr {[[els::tabW $a].name cget -text] ne [[els::tabW $b].name cget -text]}
} -result 1

test tabs-1.9 {the overflow menu dismisses the button tooltip before posting (R20)} -setup {ui_reset} -cleanup {
    if {[llength [info commands ::_r20_real_tk_popup]]} { catch {rename ::tk_popup {}} ; rename ::_r20_real_tk_popup ::tk_popup }
    catch {destroy .tip}
} -body {
    toplevel .tip ; label .tip.l -text x ; pack .tip.l    ;# a fake visible tooltip
    rename ::tk_popup ::_r20_real_tk_popup
    proc ::tk_popup {args} {}                              ;# neutralize the blocking menu
    els::tabs_popup
    set gone [expr {![winfo exists .tip]}]
    rename ::tk_popup {} ; rename ::_r20_real_tk_popup ::tk_popup
    set gone
} -result 1

test ui-10.4 {the find-count tooltip carries the full status only when the label clips it (R22)} -setup {ui_reset} -body {
    set ::els::find_count "3 of 12"
    set short [els::find_count_tip]
    set ::els::find_count "Find unavailable (worker control missing)"
    set long [els::find_count_tip]
    list [expr {$short eq ""}] [expr {$long eq "Find unavailable (worker control missing)"}]
} -result {1 1}

test disk-ui-1.5 {the disk-state label west-anchors so a clipped state shows its leading word (R19)} -setup {ui_reset} -body {
    .sb.disk cget -anchor
} -result w
