    ui_reset
    set ::els_test_assoc_exe [raw_write assoc_els.exe ""]
    set ::els_test_assoc_commands {}
    rename ::els::association_exe ::els::association_exe_real
    proc ::els::association_exe {} { return $::els_test_assoc_exe }
    rename ::els::assoc_run ::els::assoc_run_real
    proc ::els::assoc_run {cmd} { lappend ::els_test_assoc_commands $cmd }
} -cleanup {
    rename ::els::association_exe {} ; rename ::els::association_exe_real ::els::association_exe
    rename ::els::assoc_run {} ; rename ::els::assoc_run_real ::els::assoc_run
    catch {destroy .assoc}
} -body {
    els::assoc_unregister                              ;# action proc (re-render is caught harmlessly)
    set blob [join [lmap cmd $::els_test_assoc_commands {join $cmd " "}] "\n"]
    list [expr {[string first {reg.exe delete} $blob] >= 0}] \
         [expr {[string first {\Classes\Applications\assoc_els.exe} $blob] >= 0}] \
         [expr {[string first {\Classes\els.txt} $blob] >= 0}] \
         [expr {[string first {anafalanx\els\Capabilities} $blob] >= 0}] \
