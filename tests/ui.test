# tests/ui.test — comprehensive UI-level tests: drive the REAL widgets the way a
# user does, via `event generate` and menu/button `invoke`. Covers chrome, tabs,
# editing, find/replace (hard), go-to-line, whitespace, scrollbar, menus, and a
# no-hang stress of incremental search on a large buffer.
source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::test

# reg-5.2 gates on the `detect` constraint; define it HERE (not only in
# encoding.test) so running ui.test standalone doesn't silently skip it (F64).
::tcltest::testConstraint detect $::els::have_detect

proc ui_reset {} {
    els_reset
    set ::els::find_q "" ; set ::els::find_r ""
    set ::els::find_case 0 ; set ::els::find_word 0 ; set ::els::find_regex 0
    set ::els::find_adapt 0 ; set ::els::find_history {} ; set ::els::find_hidx -1
    set ::els::find_matches {} ; set ::els::find_current -1
    set ::els::find_mode ""
    set ::els::show_ws 0
    set ::els_test_openfile "" ; set ::els_test_savefile "" ; set ::els_test_mbanswer yes
    set ::els_test_open_args {} ; set ::els_test_save_args {}
    set ::els_test_popup_args {}
}
# run the real event loop for ms (lets debounced/idle `after`s fire)
proc ui_settle {{ms 220}} { set ::__s 0 ; after $ms {set ::__s 1} ; vwait ::__s }
# type into the focused find entry like a user: insert the char, fire KeyRelease
proc ui_type_find {str} {
    focus -force .find.fr.q
    foreach ch [split $str ""] {
        .find.fr.q insert insert $ch
        set ks [expr {[string is alnum -strict $ch] ? $ch : "space"}]
        event generate .find.fr.q <KeyRelease> -keysym $ks
    }
}
proc cur_line {} { lindex [split [[els::T] index insert] .] 0 }
proc raw_write {name bytes} {
    set p [file join $::ELS_TMP $name]
    set f [open $p w] ; fconfigure $f -translation binary
    puts -nonewline $f $bytes ; close $f ; return $p
}
proc raw_read {p} {
    set f [open $p r] ; fconfigure $f -translation binary
    set data [read $f] ; close $f ; return $data
}

# ---- chrome / startup ---------------------------------------------------
test ui-1.1 {core widgets exist after build} -setup {ui_reset} -body {
    list [winfo exists .menu] [winfo exists .tabs] [winfo exists .ln] \
         [winfo exists .vs] [winfo exists .sb] [winfo exists [els::T]]
} -result {1 1 1 1 1 1}

test ui-1.2 {the flat theme and the red accent caret are in effect} -setup {ui_reset} -body {
    list [ttk::style theme use] [[els::T] cget -insertbackground] \
         [[els::T] cget -insertofftime]
} -result [list clam $::els::CARET 0]

test ui-1.3 {status bar tracks the caret position} -setup {ui_reset} -body {
    [els::T] insert end "hello\nworld"
    [els::T] mark set insert 2.3 ; els::refresh_view   ;# char index 3 -> col 4 (1-based)
    .sb.pos cget -text
} -result {2:4}

test ui-1.4 {status-bar pickers have separators and hover affordance} -setup {ui_reset} -body {
    event generate .sb.eol <Enter> ; update
    set hover [list [.sb.eol cget -foreground] [.sb.eol cget -background]]
    event generate .sb.eol <Leave> ; update
    list [winfo exists .sb.sep_eol] [winfo exists .sb.sep_enc] \
         [.sb.eol cget -cursor] [.sb.enc cget -cursor] \
         $hover [.sb.eol cget -foreground]
} -result [list 1 1 hand2 hand2 [list $::els::INK $::els::TABBG] $::els::MUTED]

test disk-ui-1.1 {the disk pill is silent when clean and shows a terse word per exception} -setup {ui_reset} -body {
    set id $::els::active
    set labels {}
    foreach state {untitled normal changed missing remote unavailable readonly} {
        els::disk_state_set $id $state
        lappend labels [.sb.disk cget -text]
    }
    # colour logic: red = at risk (changed/missing); muted = FYI (remote/unreadable/read-only)
    els::disk_state_set $id changed    ; set changedFg [.sb.disk cget -foreground]
    els::disk_state_set $id remote     ; set remoteFg  [.sb.disk cget -foreground]
    # a clean state COLLAPSES the pill (no gap); an exception packs it back
    els::disk_state_set $id normal
    set cleanHidden [expr {[lsearch -exact [pack slaves .sb] .sb.disk] < 0}]
    els::disk_state_set $id changed
    set exceptionShown [expr {[lsearch -exact [pack slaves .sb] .sb.disk] >= 0}]
    set tip [els::disk_tip]                                   ;# state is 'changed'
    list [winfo exists .sb.sep_disk] $labels $changedFg $remoteFg \
         $cleanHidden $exceptionShown [string match "*Save will ask*" $tip]
} -result [list 0 \
    [list {} {} changed missing remote unreadable read-only] \
    $::els::CARET $::els::MUTED 1 1 1]

test disk-ui-1.6 {a path nearing the Windows limit flags its length as a red badge left of the name; a short path shows none} \
        -setup {ui_reset} -cleanup {els::name_len_flag 0} -body {
    set id $::els::active
    set ::els::status_note_after ""
    set ::els::docPath($id) [string repeat a 20]      ;# short: no badge
    els::update_namelabel
    set shortHidden [expr {[lsearch -exact [pack slaves .sb] .sb.plen] < 0}]
    set nameFg [.sb.name cget -foreground]            ;# the NAME itself must stay muted
    set ::els::docPath($id) "C:/[string repeat x 240]/f.txt"   ;# >= PATH_WARN_LEN (200)
    els::update_namelabel
    set plenIdx [lsearch -exact [pack slaves .sb] .sb.plen]
    list $shortHidden [expr {$nameFg eq $::els::MUTED}] \
         [expr {$plenIdx >= 0}] [string match {\[*\]} [.sb.plen cget -text]] \
         [expr {[.sb.plen cget -foreground] eq $::els::CARET}] \
         [expr {[.sb.name cget -foreground] eq $::els::MUTED}] \
         [expr {[lsearch -exact [pack slaves .sb] .sb.name] > $plenIdx}]
} -result {1 1 1 1 1 1 1}

test disk-ui-1.7 {elide_text clips a too-wide message with a trailing ellipsis; a short one is untouched} \
        -setup {ui_reset} -body {
    set long "abcdefghijklmnopqrstuvwxyz0123456789 the quick brown fox"
    set e [els::elide_text $long [font measure elsUI "123456789012"]]
    list [expr {[els::elide_text "abc" 100000] eq "abc"}] \
         [expr {[font measure elsUI $e] <= [font measure elsUI "123456789012"]}] \
         [string match {*…} $e] [expr {[string length $e] < [string length $long]}]
} -result {1 1 1 1}

test disk-ui-1.8 {while a note holds the name slot, its tooltip carries the full un-elided text} \
        -setup {ui_reset} -cleanup {catch {after cancel $::els::status_note_after} ; els::status_note_clear} -body {
    set ::els::status_note_after ""
    set msg "backup failed: a long explanation that would not fit the slot on a narrow window"
    els::status_note $msg
    set tipDuringNote [els::name_tip]
    set fullStored [expr {$::els::status_note_full eq $msg}]
    els::status_note_clear
    set tipAfter [els::name_tip]
    list [expr {$tipDuringNote eq $msg}] $fullStored [expr {$tipAfter ne $msg}]
} -result {1 1 1}

test diskwatch-1.1 {returning to the app (Activate) does an immediate forced catch-up probe} -setup {ui_reset} \
        -cleanup {els::disk_watch_deactivate} -body {
    set p [els_tmpfile dw1.txt "original\n"]
    set id [els::open $p]
    set s0 $::els::docDiskState($id)
    raw_write dw1.txt "changed by another program\n"
    file mtime $p [expr {[file mtime $p] + 5}]
    els::disk_watch_deactivate
    event generate . <Activate> ; update                  ;# came back to els
    list $s0 $::els::docDiskState($id) [.sb.disk cget -text]
} -result {normal changed changed}

test diskwatch-1.2 {the poll keeps running after the window deactivates, catching a background / programmatic external edit} \
        -setup {ui_reset} -cleanup {els::disk_watch_deactivate ; set ::els::DISK_WATCH_MS 5000} -body {
    set ::els::DISK_WATCH_MS 15
    set p [els_tmpfile dw_bg.txt "original\n"]
    set id [els::open $p]
    els::disk_watch_activate                              ;# els::main starts the poll in production
    event generate . <Deactivate> ; update                ;# leave for another app: poll must NOT stop
    set stillRunning $::els::disk_watch_active
    raw_write dw_bg.txt "rewritten by a build tool while els is in the background\n"
    file mtime $p [expr {[file mtime $p] + 5}]
    # let the poll tick until it catches the change (bounded loop, robust on a loaded box)
    for {set i 0} {$i < 40 && $::els::docDiskState($id) ne "changed"} {incr i} {
        set ::disk_wait 0 ; after 15 {set ::disk_wait 1} ; vwait ::disk_wait
    }
    list $stillRunning $::els::docDiskState($id) [.sb.disk cget -text]
} -result {1 changed changed}

test extmodsync-1.1 {a save that detects a conflict and is cancelled leaves the pill showing changed} -setup {ui_reset} -body {
    set p [els_tmpfile dw2.txt "original\n"]
    set id [els::open $p]
    [els::W $id] insert end "my edit"                      ;# dirty so save proceeds
    raw_write dw2.txt "external change\n"
    file mtime $p [expr {[file mtime $p] + 5}]
    set ::els_test_mbanswer cancel
    set r [els::save $id]
    list $r $::els::docDiskState($id) [.sb.disk cget -text]
} -result {0 changed changed}

test extmodsync-1.2 {a cancelled metadata-identical conflict stays 'changed' across poll ticks (docDiskContent pinned)} \
        -setup {ui_reset} -cleanup {els::disk_watch_deactivate ; set ::els::DISK_WATCH_MS 5000} -body {
    set ::els::DISK_WATCH_MS 15
    set p [els_tmpfile dw_meta.txt "aaaa\n"]
    set id [els::open $p]
    set m0 [file mtime $p]
    [els::W $id] insert end "x"                    ;# dirty so save proceeds
    raw_write dw_meta.txt "bbbb\n"                 ;# SAME 5 bytes, different content
    file mtime $p $m0                             ;# restore mtime: metadata identical to the baseline
    set ::els_test_mbanswer cancel
    els::save $id                                 ;# a full content hash detects the conflict; cancel
    set afterSave $::els::docDiskState($id)
    els::disk_watch_activate                      ;# run the continuous poll
    # several metadata-only timer ticks must NOT revert the pill (docDiskContent is pinned)
    for {set i 0} {$i < 8} {incr i} { set ::disk_wait 0 ; after 15 {set ::disk_wait 1} ; vwait ::disk_wait }
    list $afterSave $::els::docDiskState($id) [.sb.disk cget -text]
} -result {changed changed changed}

test noas-1.1 {the 'no auto-save' flag shows only while auto-save is on AND the active doc is paused} \
        -setup {ui_reset} -cleanup {set ::els::autosave 0 ; els::noas_render} -body {
    set id $::els::active
    set hidden0 [expr {[lsearch -exact [pack slaves .sb] .sb.noas] < 0}]
    set ::els::docExtModPause($id) "the file changed on disk"   ;# paused, but auto-save OFF
    els::noas_render
    set offHidden [expr {[lsearch -exact [pack slaves .sb] .sb.noas] < 0}]
    set ::els::autosave 1                                       ;# auto-save ON + paused -> shown
    els::noas_render
    set shown [expr {[lsearch -exact [pack slaves .sb] .sb.noas] >= 0}]
    set label [.sb.noas cget -text]
    set tip [els::noas_tip]
    unset ::els::docExtModPause($id)                            ;# a manual save clears the pause
    els::noas_render
    set clearedHidden [expr {[lsearch -exact [pack slaves .sb] .sb.noas] < 0}]
    list $hidden0 $offHidden $shown $label [string match "*changed on disk*" $tip] $clearedHidden
} -result {1 1 1 {no auto-save} 1 1}

test noas-1.2 {a background auto-save blocked by a disk change shows the persistent flag, not a fading note} \
        -setup {ui_reset} -cleanup {set ::els::autosave 0 ; els::noas_render} -body {
    set p [els_tmpfile noas2.txt "original\n"]
    set id [els::open $p]
    set ::els::autosave 1
    [els::W $id] insert end "my edit"            ;# dirty so auto-save attempts a write
    raw_write noas2.txt "external change\n"      ;# the disk copy diverged
    file mtime $p [expr {[file mtime $p] + 5}]
    els::autosave_flush_doc $id                  ;# background auto-save -> paused
    set paused [info exists ::els::docExtModPause($id)]
    set flagShown [expr {[lsearch -exact [pack slaves .sb] .sb.noas] >= 0}]
    # the name slot must NOT carry a verbose "auto-save paused" note (that was the old way)
    list $paused $flagShown [string match "*auto-save*" [.sb.name cget -text]]
} -result {1 1 0}

test disk-ui-1.2 {normal-state tooltip is observational and promises only the authoritative save guard} \
        -setup {ui_reset} -body {
    set id $::els::active
    els::disk_state_set $id normal
    set tip [els::disk_tip]
    list [string match "No external change has been detected*" $tip] \
         [string match "*Save always performs a full conflict check.*" $tip] \
         [string match "*matches*" $tip]
} -result {1 1 0}

test ui-1.5 {empty document does not paint a text current-line band} -setup {ui_reset} -body {
    set w [els::T]
    els::refresh_view
    set emptyRanges [llength [$w tag ranges currentLine]]
    $w insert end "x"
    els::refresh_view
    list $emptyRanges [expr {[llength [$w tag ranges currentLine]] > 0}]
} -result {0 1}

test ui-1.6 {document caret is a non-blinking bar sized from DPI-scaling points; the gutter is a caret-less canvas} -setup {ui_reset} -cleanup {els::set_font_size 11 0} -body {
    # The caret is now derived from 3p AND scaled by zoom (see ui-7.7), so it carries
    # a pixel value rather than the literal "3p" it used to.  The guarantee under
    # test is unchanged: its width comes from DPI-scaling points, never a bare pixel
    # literal.  Pin the default zoom explicitly -- els_reset restores font_size only
    # AFTER building the UI, so the widget would otherwise inherit the previous
    # test's zoom.
    els::set_font_size 11 0
    set w [els::T]
    list [expr {[winfo pixels $w [$w cget -insertwidth]] == max(1, round([winfo fpixels . 3p]))}] \
         [$w cget -insertofftime] [winfo class .ln]
} -result {1 0 Canvas}

# ---- tabs (via generated events) ----------------------------------------
test ui-2.1 {Ctrl+N opens a new tab} -setup {ui_reset} -body {
    set b [llength $::els::docs]
    event generate [els::T] <Control-n> ; update
    expr {[llength $::els::docs] - $b}
} -result 1

test ui-2.2 {Ctrl+W closes the current clean tab} -setup {ui_reset} -body {
    els::new_doc ; update
    set b [llength $::els::docs]
    event generate [els::T] <Control-w> ; update
    expr {$b - [llength $::els::docs]}
} -result 1

test ui-2.3 {Ctrl+Tab cycles to the next document} -setup {ui_reset} -body {
    set a $::els::active
    els::new_doc ; update
    event generate [els::T] <Control-Tab> ; update
    expr {$::els::active eq $a}
} -result 1

test ui-2.4 {clicking a tab switches to it} -setup {ui_reset} -body {
    set first $::els::active
    set second [els::new_doc] ; update
    event generate [els::tabW $first] <Button-1> ; update
    set r [expr {$::els::active eq $first}]
    event generate [els::tabW $second] <Button-1> ; update
    list $r [expr {$::els::active eq $second}]
} -result {1 1}

test ui-2.5 {the tab close button closes that document} -setup {ui_reset} -body {
    set extra [els::new_doc] ; update
    set b [llength $::els::docs]
    event generate [els::tabW $extra].close <Button-1> ; update
    expr {$b - [llength $::els::docs]}
} -result 1

test ui-2.6 {the tab close button is quiet until hovered} -setup {ui_reset} -body {
    set w [els::tabW $::els::active].close
    set normal [$w cget -fg]
    event generate $w <Enter> ; update
    set hover [list [$w cget -fg] [$w cget -bg]]
    event generate $w <Leave> ; update
    list $normal $hover [$w cget -fg]
} -result [list $::els::MUTED [list $::els::INK $::els::TABON] $::els::MUTED]

# ---- editing (generated keystrokes) -------------------------------------
test ui-3.1 {typed keystrokes land in the buffer} -setup {ui_reset} -body {
    set w [els::T] ; focus -force $w
    foreach ch {h e l l o} { event generate $w <KeyPress> -keysym $ch }
    update
    $w get 1.0 "end - 1 char"
} -result hello

test ui-3.2 {undo reverts an edit} -setup {ui_reset} -body {
    set w [els::T] ; $w insert end "abc" ; $w edit separator
    $w insert end "def"
    $w edit undo
    $w get 1.0 "end - 1 char"
} -result abc

test ui-3.3 {arrow keys move the caret and update the status bar} -setup {ui_reset} -body {
    set w [els::T] ; $w insert end "one\ntwo\nthree" ; $w mark set insert 1.0
    focus -force $w
    event generate $w <Down> ; event generate $w <Right> ; update
    els::refresh_view
    .sb.pos cget -text
} -result {2:2}

# ---- find / replace (the hard part) -------------------------------------
test ui-4.1 {Ctrl+F shows the find bar and focuses the field} -setup {ui_reset} -body {
    event generate [els::T] <Control-f> ; update
    list [winfo ismapped .find] [expr {[focus] eq ".find.fr.q"}]
} -result {1 1}

test ui-4.1a {every find action is in focus traversal and Escape closes from a toggle} -setup {ui_reset} -body {
    els::find_show replace ; update
    set controls {.find.fr.case .find.fr.word .find.fr.regex .find.fr.help \
        .find.fr.prev .find.fr.next .find.fr.x .find.rr.adapt .find.rr.rep .find.rr.all}
    set allFocus 1
    foreach w $controls { if {![$w cget -takefocus]} { set allFocus 0 } }
    focus -force .find.fr.case
    event generate .find.fr.case <Escape> ; update
    list $allFocus [winfo ismapped .find] [expr {[focus] eq [els::T]}]
} -result {1 0 1}

test ui-4.2 {typing in the find field highlights matches (debounced)} -setup {ui_reset} -body {
    [els::T] insert end "foo bar foo baz foo"
    event generate [els::T] <Control-f> ; update
    ui_type_find "foo"
    ui_settle
    list [llength $::els::find_matches] $::els::find_count
} -result {3 {1 of 3}}

test ui-4.3 {Enter steps to the next match and wraps} -setup {ui_reset} -body {
    [els::T] insert end "x x x"
    event generate [els::T] <Control-f> ; update
    ui_type_find "x" ; ui_settle
    set seq [list $::els::find_current]
    foreach _ {1 2 3} {
        event generate .find.fr.q <Return> ; update
        lappend seq $::els::find_current
    }
    set seq
} -result {0 1 2 0}

test ui-4.4 {Match Case toggle narrows the matches} -setup {ui_reset} -body {
    [els::T] insert end "Foo foo FOO foo"
    event generate [els::T] <Control-f> ; update
    ui_type_find "foo" ; ui_settle
    set before [llength $::els::find_matches]
    .find.fr.case invoke ; ui_settle      ;# turn Match Case on
    list $before [llength $::els::find_matches]
} -result {4 2}

test ui-4.5 {Regex toggle enables a pattern search; help button stays available} -setup {ui_reset} -body {
    [els::T] insert end "a1 b2 cc d3"
    event generate [els::T] <Control-f> ; update
    .find.fr.regex invoke
    ui_type_find {[a-z][0-9]} ; ui_settle
    list [llength $::els::find_matches] [.find.fr.help cget -state]
} -result {3 normal}

test ui-4.6 {Ctrl+H reveals replace; Replace All replaces every match} -setup {ui_reset} -body {
    [els::T] insert end "cat cat cat"
    event generate [els::T] <Control-h> ; update
    set rowShown [winfo ismapped .find.rr]
    ui_type_find "cat" ; ui_settle
    set ::els::find_r "dog"
    .find.rr.all invoke ; update
    list $rowShown [[els::T] get 1.0 "end - 1 char"] \
        $::els::find_replace_all_busy [.find.rr.all cget -text]
} -result {1 {dog dog dog} 0 All}

test ui-4.7 {Adapt-case toggle drives case-aware replacement} -setup {ui_reset} -body {
    [els::T] insert end "cat CAT Cat"
    event generate [els::T] <Control-h> ; update
    ui_type_find "cat" ; ui_settle
    set ::els::find_r "dog"
    .find.rr.adapt invoke
    .find.rr.all invoke ; update
    [els::T] get 1.0 "end - 1 char"
} -result {dog DOG Dog}

test ui-4.8 {the regex reference opens without enabling regex} -setup {ui_reset} -body {
    event generate [els::T] <Control-f> ; update
    .find.fr.help state disabled
    els::find_show find ; update
    set enabled [expr {![.find.fr.help instate disabled]}]
    set x [expr {[winfo width .find.fr.help] / 2}]
    set y [expr {[winfo height .find.fr.help] / 2}]
    event generate .find.fr.help <Enter> -x $x -y $y
    event generate .find.fr.help <ButtonPress-1> -x $x -y $y
    event generate .find.fr.help <ButtonRelease-1> -x $x -y $y
    update
    set opened [winfo exists .rehelp]
    set title [wm title .rehelp]
    set fixed [wm resizable .rehelp]
    set locked [expr {[wm minsize .rehelp] eq [wm maxsize .rehelp] && \
        [wm minsize .rehelp] eq [list [winfo reqwidth .rehelp] [winfo reqheight .rehelp]]}]
    set tokenSize [font actual [.rehelp.f.t2 cget -font] -size]
    set texts {}
    set stack [list .rehelp]
    while {[llength $stack]} {
        set w [lindex $stack 0]
        set stack [lrange $stack 1 end]
        if {![catch {$w cget -text} t]} { lappend texts $t }
        foreach c [winfo children $w] { lappend stack $c }
    }
    set blob [join $texts \n]
    event generate .rehelp <Escape> ; update
    list $::els::find_regex $enabled $opened [winfo exists .rehelp] $title $fixed $locked $tokenSize \
        [expr {[string first "Regex is on" $blob] >= 0}] \
        [expr {[string first "Regular Expressions Quickref" $blob] >= 0}] \
        [expr {[string first "Tcl" "$title\n$blob"] < 0}] \
        [expr {[string first "\\m" $blob] >= 0}] \
        [expr {[string first "\\1" $blob] >= 0}]
} -result {0 1 1 0 {Regular Expressions Quickref} {0 0} 1 10 1 1 1 1 1}

test ui-4.9 {search history records on Enter and recalls with Up} -setup {ui_reset} -body {
    [els::T] insert end "alpha beta gamma"
    event generate [els::T] <Control-f> ; update
    ui_type_find "beta" ; ui_settle
    event generate .find.fr.q <Return> ; update     ;# records "beta"
    set ::els::find_q "" ; els::find_update
    event generate .find.fr.q <Up> ; update          ;# recall "beta"
    set ::els::find_q
} -result beta

test ui-4.10 {Escape hides the find bar} -setup {ui_reset} -body {
    event generate [els::T] <Control-f> ; update
    set shown [winfo ismapped .find]
    event generate .find.fr.q <Escape> ; update
    list $shown [winfo ismapped .find]
} -result {1 0}

test ui-4.11 {no-match reports calmly, never throws} -setup {ui_reset} -body {
    [els::T] insert end "nothing here"
    event generate [els::T] <Control-f> ; update
    ui_type_find "zzzzz" ; ui_settle
    list [llength $::els::find_matches] $::els::find_count
} -result {0 {No results}}

test ui-4.12 {STRESS: rapid incremental search keeps the event loop responsive} \
        -constraints {} -setup {
    ui_reset
    set ::els::find_test_sync 0
    set ::ui_rapid_beat 0
    proc ::ui_rapid_tick {} {
        incr ::ui_rapid_beat
        set ::ui_rapid_after [after 10 ::ui_rapid_tick]
    }
    ::ui_rapid_tick
} -body {
    # ~55 KB buffer; debounced search must keep the UI responsive
    set big "" ; for {set i 0} {$i < 1000} {incr i} {
        append big "the quick brown fox jumps over the lazy dog $i\n"
    }
    [els::T] insert end $big
    event generate [els::T] <Control-f> ; update
    set t0 [clock milliseconds]
    foreach q {t th the q qu o ov ove over} {     ;# rapid keystrokes
        set ::els::find_q $q
        event generate .find.fr.q <KeyRelease> -keysym [string index $q end]
    }
    .find.fr.regex invoke
    foreach q {a a* .* {\w*}} {                    ;# empty-matching regexes
        set ::els::find_q $q
        event generate .find.fr.q <KeyRelease> -keysym space
    }
    ui_settle 400                                  ;# debounce may start work, never block Tk
    set responsiveMs [expr {[clock milliseconds] - $t0}]
    set responsive [expr {$responsiveMs < 1500 && $::ui_rapid_beat > 10}]

    # Completion may legitimately take several seconds for an exact global
    # index of an empty-matching regex; drain it separately from responsiveness.
    set done 0
    set until [expr {[clock milliseconds] + 15000}]
    while {[clock milliseconds] < $until} {
        update
        if {$::els::find_after eq "" && $::els::find_pending eq "" \
                && $::els::find_job eq "" && $::els::find_snapshot_build eq "" \
                && $::els::find_validation eq "" && $::els::find_highlight_state eq "" \
                && $::els::find_count ni {"" "Searching..."}} {
            set done 1
            break
        }
        after 5
    }
    list $responsive $done [expr {[llength $::els::find_matches] > 0}]
} -cleanup {
    catch {after cancel $::ui_rapid_after}
    catch {rename ::ui_rapid_tick {}}
    unset -nocomplain ::ui_rapid_after ::ui_rapid_beat
    set ::els::find_test_sync 1
    catch {els::find_cancel cleanup}
} -result {1 1 1}

test ui-4.13 {find and replace rows align on the right} -setup {ui_reset} -body {
    els::find_show replace
    update
    set findRight [expr {[winfo rootx .find.fr.x] + [winfo width .find.fr.x]}]
    set replRight [expr {[winfo rootx .find.rr.all] + [winfo width .find.rr.all]}]
    set findEntryRight [expr {[winfo rootx .find.fr.q] + [winfo width .find.fr.q]}]
    set replEntryRight [expr {[winfo rootx .find.rr.r] + [winfo width .find.rr.r]}]
    set controlsVisible [expr {[winfo height .find.fr.x] > 12 && [winfo height .find.rr.all] > 12}]
    list [expr {abs($findRight - $replRight) <= 2}] \
         [expr {abs($findEntryRight - $replEntryRight) <= 2}] \
         $controlsVisible \
         [.find.rr.rep cget -style] [.find.rr.all cget -style] \
         [ttk::style configure Find.Toolbutton -font] \
         [ttk::style configure Find.TButton -font] \
         [ttk::style configure FindAction.Toolbutton -font] \
         [ttk::style configure FindAction.TButton -font]
} -result {1 1 1 FindAction.TButton FindAction.TButton elsUI elsUI elsUI elsUI}

test ui-replacebusy-1.1 {Replace All becomes cancellable as soon as snapshot construction starts} \
        -setup {
    ui_reset
    set ::ui_busy_old_sync $::els::find_test_sync
    set ::ui_busy_old_slice $::els::FIND_SLICE_CHARS
    set ::els::find_test_sync 0
    set ::els::FIND_SLICE_CHARS 1
} -body {
    els::find_show replace
    set w [els::T]
    $w insert end "alpha alpha"
    set ::els::find_q alpha
    set ::els::find_r beta
    els::find_request replace-all
    set during [list [expr {$::els::find_pending ne ""}] \
        [expr {$::els::find_snapshot_build ne ""}] $::els::find_replace_all_busy \
        [.find.rr.all cget -text]]
    .find.rr.all invoke
    list $during [expr {$::els::find_pending eq ""}] $::els::find_replace_all_busy \
        [.find.rr.all cget -text] $::els::find_count [$w get 1.0 "end - 1 char"]
} -cleanup {
    catch {after cancel $::els::find_after}; set ::els::find_after ""
    catch {els::find_cancel cleanup}
    catch {els::find_snapshot_drop}
    set ::els::find_test_sync $::ui_busy_old_sync
    set ::els::FIND_SLICE_CHARS $::ui_busy_old_slice
    unset -nocomplain ::ui_busy_old_sync ::ui_busy_old_slice
} -result {{1 1 1 Cancel} 1 0 All Cancelled {alpha alpha}}

test ui-replacebusy-1.2 {Replace All stays cancellable while its match index is validated} \
        -setup {
    ui_reset
    set ::ui_busy_old_sync $::els::find_test_sync
} -body {
    els::find_show replace
    set w [els::T]
    $w insert end "alpha alpha"
    set ::els::find_q alpha
    set ::els::find_r beta
    els::find_update
    set cached [expr {$::els::find_snapshot ne ""}]

    set ::els::find_test_sync 0
    els::find_request replace-all
    set started [expr {$::els::find_job ne ""}]
    set until [expr {[clock milliseconds] + 7000}]
    while {$::els::find_job ne "" && [clock milliseconds] < $until} {
        if {$::els::find_poll_after ne ""} {
            after cancel $::els::find_poll_after
            set ::els::find_poll_after ""
        }
        els::find_poll
        if {$::els::find_job ne ""} { after 5 }
    }
    if {$::els::find_job ne ""} { error "replace-all worker did not finish" }
    set during [list [expr {$::els::find_validation ne ""}] \
        $::els::find_replace_all_busy [.find.rr.all cget -text]]
    .find.rr.all invoke
    list $cached $started $during [expr {$::els::find_validation eq ""}] \
        $::els::find_replace_all_busy [.find.rr.all cget -text] \
        $::els::find_count [$w get 1.0 "end - 1 char"]
} -cleanup {
    catch {after cancel $::els::find_poll_after}; set ::els::find_poll_after ""
    catch {after cancel $::els::find_after}; set ::els::find_after ""
    catch {els::find_cancel cleanup}
    catch {els::find_snapshot_drop}
    set ::els::find_test_sync $::ui_busy_old_sync
    unset -nocomplain ::ui_busy_old_sync
} -result {1 1 {1 1 Cancel} 1 0 All Cancelled {alpha alpha}}

