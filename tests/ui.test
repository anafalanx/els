    proc ::els::association_exe {} { return [file join $::ELS_TMP els_unregistered_zzq.exe] }
} -cleanup {
    rename ::els::association_exe {} ; rename ::els::association_exe_real ::els::association_exe
} -body {
    els::assoc_registered
} -result 0

