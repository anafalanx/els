# tests/encoding.test — encoding + EOL detection and preservation.
source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::test

# ICU charset detection is optional (system icu.dll); gate those tests on it.
::tcltest::testConstraint detect $::els::have_detect

proc write_raw {name bytes} {
    set p [file join $::ELS_TMP $name]
    set fh [open $p w] ; fconfigure $fh -translation binary
    puts -nonewline $fh $bytes ; close $fh
    return $p
}
proc read_raw {p} {
    set fh [open $p r] ; fconfigure $fh -translation binary
    set d [read $fh] ; close $fh ; return $d
}
proc edoc {k} {
    set a $::els::active
    switch $k {
        Enc { return $::els::docEnc($a) }
        Bom { return $::els::docBom($a) }
        Eol { return $::els::docEol($a) }
    }
}

test enc-1.1 {utf-8, no BOM, LF} -setup {els_reset} -body {
    els::open [write_raw a.txt "hello\nworld\n"]
    list [edoc Enc] [edoc Bom] [edoc Eol]
} -result {utf-8 0 lf}

test enc-1.2 {CRLF detected; buffer is LF-internal} -setup {els_reset} -body {
    els::open [write_raw b.txt "a\r\nb\r\n"]
    list [edoc Eol] [string first \r [[els::T] get 1.0 end]]
} -result {crlf -1}

test enc-1.3 {utf-8 with BOM} -setup {els_reset} -body {
    els::open [write_raw c.txt "\xEF\xBB\xBFhi\n"]
    list [edoc Enc] [edoc Bom] [[els::T] get 1.0 1.end]
} -result {utf-8 1 hi}

test enc-1.4 {utf-16le with BOM} -setup {els_reset} -body {
    els::open [write_raw d.txt "\xFF\xFE[encoding convertto utf-16le "Hi\n"]"]
    list [edoc Enc] [edoc Bom] [[els::T] get 1.0 1.end]
} -result {utf-16le 1 Hi}

test enc-1.5 {utf-32le with BOM (sniffed before utf-16le)} -setup {els_reset} -body {
    els::open [write_raw g.txt "\xFF\xFE\x00\x00[encoding convertto utf-32le "Hi\n"]"]
    list [edoc Enc] [edoc Bom] [[els::T] get 1.0 1.end]
} -result {utf-32le 1 Hi}

test enc-1.6 {utf-32be with BOM} -setup {els_reset} -body {
    els::open [write_raw h.txt "\x00\x00\xFE\xFF[encoding convertto utf-32be "Hi\n"]"]
    list [edoc Enc] [edoc Bom] [[els::T] get 1.0 1.end]
} -result {utf-32be 1 Hi}

test enc-2.1 {CRLF round-trips byte-for-byte on save} -setup {els_reset} -body {
    set p [write_raw rt.txt "x\r\ny\r\n"]
    els::open $p
    [els::T] insert end "z"
    els::save
    read_raw $p
} -result "x\r\ny\r\nz"

test enc-2.2 {utf-8 BOM is preserved on save} -setup {els_reset} -body {
    set orig "\xEF\xBB\xBF[encoding convertto utf-8 "café\n"]"
    set p [write_raw e.txt $orig]
    els::open $p
    els::save
    expr {[read_raw $p] eq $orig}
} -result 1

test enc-2.3 {utf-16le BOM round-trips} -setup {els_reset} -body {
    set orig "\xFF\xFE[encoding convertto utf-16le "ab\n"]"
    set p [write_raw f.txt $orig]
    els::open $p
    els::save
    expr {[read_raw $p] eq $orig}
} -result 1

test enc-2.4 {utf-32be BOM round-trips byte-for-byte} -setup {els_reset} -body {
    set orig "\x00\x00\xFE\xFF[encoding convertto utf-32be "ab\n"]"
    set p [write_raw rt32.txt $orig]
    els::open $p
    els::save
    expr {[read_raw $p] eq $orig}
} -result 1

# ---- charset auto-detection (ICU) ---------------------------------------
test enc-3.1 {ICU detects BOM-less UTF-16 LE} -constraints detect -setup {els_reset} -body {
    set p [write_raw d16.txt [encoding convertto utf-16le \
        "The quick brown fox jumps over the lazy dog.\n"]]
    els::open $p
    list [edoc Enc] [edoc Bom] [string range [[els::T] get 1.0 1.end] 0 2]
} -result {utf-16le 0 The}

test enc-3.2 {ICU detects legacy Cyrillic as cp1251 (no mojibake)} -constraints detect -setup {els_reset} -body {
    set ru "Это пример текста на русском языке для проверки кодировки."
    set p [write_raw cyr.txt "[encoding convertto cp1251 $ru]\n"]
    els::open $p
    list [edoc Enc] [[els::T] get 1.0 1.end]
} -result [list cp1251 "Это пример текста на русском языке для проверки кодировки."]

# ---- manual override (reopen with / save with) --------------------------
test enc-3.3 {reopen re-decodes the same raw bytes under a new encoding} -setup {els_reset} -body {
    set p [write_raw r3.txt "\xFF\n"]
    els::open $p
    els::reopen_with iso8859-5 0   ;# 0xFF -> U+045F
    set a [[els::T] get 1.0 1.end]
    els::reopen_with iso8859-1 0   ;# 0xFF -> U+00FF
    set b [[els::T] get 1.0 1.end]
    list [edoc Enc] $a $b
} -result "iso8859-1 џ ÿ"

test enc-3.4 {set save encoding marks dirty but does not save pending edits immediately} -setup {els_reset} -body {
    set p [write_raw s4.txt "x\n"]
    els::open $p
    [els::T] delete 1.0 end
    [els::T] insert end "ÿ"    ;# ÿ
    els::save_with iso8859-1 0
    set beforeSave [read_raw $p]
    set dirty [els::doc_dirty $::els::active]
    els::save
    list $beforeSave $dirty [read_raw $p]
} -result [list "x\n" 1 "\xFF"]

test enc-3.4a {ASCII-only files are ambiguous and default to UTF-8} -setup {els_reset} -body {
    set p [write_raw sticky_ascii.txt "plain ascii\n"]
    els::open $p
    list [edoc Enc] [edoc Bom]
} -result {utf-8 0}

test enc-3.4b {chosen save encoding is not stored in config} \
        -setup {
            els_reset
            set ::els_test_selftest $::els::selftest
            set ::els::selftest 0
        } -body {
    set p [write_raw enc_not_persisted.txt "plain ascii\n"]
    els::open $p
    els::save_with iso8859-1 0
    els::save_geometry
    set conf [read_raw $::els::config_path]
    # the chosen per-document save encoding must NOT leak into the shared config;
    # assert the literal encoding name is absent (the old check only looked for a
    # key els never writes, so it passed no matter what)
    expr {[string first iso8859-1 $conf] < 0 && [string first file_encodings $conf] < 0}
} -cleanup {
    set ::els::selftest $::els_test_selftest
    unset -nocomplain ::els_test_selftest
} -result 1

test enc-3.5 {EOL override marks the doc saveable and rewrites line endings} -setup {els_reset} -body {
    set p [write_raw e5.txt "a\nb\n"]
    els::open $p
    els::set_eol crlf
    els::save
    read_raw $p
} -result "a\r\nb\r\n"

test enc-3.6 {set_eol changes the EOL and marks the doc dirty} -setup {els_reset} -body {
    set p [write_raw eol6.txt "a\nb\n"]
    els::open $p
    set clean [els::doc_dirty $::els::active]
    els::set_eol cr
    list $clean $::els::docEol($::els::active) [els::doc_dirty $::els::active]
} -result {0 cr 1}

test enc-3.7 {set_eol to the current EOL is a no-op and does not dirty the doc} -setup {els_reset} -body {
    set p [write_raw eol7.txt "a\nb\n"]
    els::open $p
    els::set_eol $::els::docEol($::els::active)   ;# same value -> early return
    els::doc_dirty $::els::active
} -result 0

test enc-3.8 {set_eol cr rewrites the line endings to lone CR on save} -setup {els_reset} -body {
    set p [write_raw eol8.txt "a\nb\nc\n"]
    els::open $p
    els::set_eol cr
    els::save
    read_raw $p
} -result "a\rb\rc\r"

test enc-3.9 {apply_enc dispatches reopen->reopen_with and save->save_with} -setup {els_reset} -body {
    set p [write_raw applyenc.txt "x\n"]
    els::open $p
    els::apply_enc reopen utf-16be 0
    set afterReopen $::els::docEnc($::els::active)
    els::apply_enc save cp1252 0
    list $afterReopen $::els::docEnc($::els::active) [els::doc_dirty $::els::active]
} -result {utf-16be cp1252 1}

test enc-3.10 {ICU detect returns empty for empty input (no crash on a 0-length buffer)} -constraints detect -body {
    list [expr {[::elsdet::detect ""] eq ""}] \
         [expr {[::elsdet::detect "the quick brown fox jumps over the lazy dog"] ne ""}]
} -result {1 1}

test enc-3.11 {ICU extension package name matches the generated pkgIndex} -constraints detect -body {
    package require icudet
    list [package provide icudet] [package provide elsdet] \
         [expr {[::elsdet::detect "the quick brown fox jumps over the lazy dog"] ne ""}]
} -result {0.1 0.1 1}

# ---- picker menus -------------------------------------------------------
test enc-4.1 {encoding & EOL picker menus build, "Other" lists every encoding} -setup {els_reset} -body {
    els::build_enc_popup
    els::build_eol_popup
    list [winfo exists .encpop.re.other] [winfo exists .encpop.sv.other] \
         [winfo exists .eolpop] \
         [expr {[.encpop.re.other index end] + 1 == [llength [encoding names]]}] \
         [.encpop entrycget 0 -label] [.encpop entrycget 1 -label]
} -result {1 1 1 1 {Reopen with Encoding} {Set Save Encoding}}

test enc-4.2 {UI-driven: click the encoding indicator, reopen-with then save-with} -setup {els_reset} -body {
    set p [write_raw uidrv.txt [encoding convertto cp1251 "Текст для проверки\n"]]
    # open through the File menu (dialog stubbed)
    set ::els_test_openfile $p
    .menu.file invoke "Open..."
    update
    # real <Button-1> on the status-bar encoding indicator builds the picker;
    # choose a (wrong) encoding from the "Other (all)" submenu, as a user would
    event generate .sb.enc <ButtonPress-1> -x 5 -y 5
    catch {.encpop unpost}
    .encpop.re.other invoke [.encpop.re.other index utf-16be]
    update
    set afterReopen $::els::docEnc($::els::active)
    # Save As (to a temp path) then Set Save Encoding via the picker
    set ::els_test_savefile [file join $::ELS_TMP uidrv_out.txt]
    .menu.file invoke "Save As..."
    event generate .sb.enc <ButtonPress-1> -x 5 -y 5
    catch {.encpop unpost}
    .encpop.sv.other invoke [.encpop.sv.other index cp1252]
    update
    list $afterReopen $::els::docEnc($::els::active) \
         [file exists [file join $::ELS_TMP uidrv_out.txt]]
} -result {utf-16be cp1252 1}

# ---- save-with-encoding -> close -> reopen, 100 combinations -------------
# For 25 encodings x 4 text variants, write the text with els's own save path,
# reopen it fresh (detection runs), and check the text comes back intact.  The
# encoding need not be detected by the same NAME — recovering the text is what
# matters — so we also report exact-name hits.  Detection is heuristic, so the
# bar is "most cases", not all.
proc rt_bom {enc} {
    return [dict get {utf-8 "\xEF\xBB\xBF" utf-16le "\xFF\xFE" utf-16be "\xFE\xFF" \
                      utf-32le "\xFF\xFE\x00\x00" utf-32be "\x00\x00\xFE\xFF"} $enc]
}
test enc-roundtrip-100 {save-with-encoding then reopen recovers the text for all 100 combos} \
        -constraints detect -setup {els_reset} -body {
    array set S {
        uni      "Café — naïve Ωμέγα 日本語 한국어 €100"
        west     "Café déjà vu, naïve façade — prix 100 euros."
        west1    "Café déjà vu, naïve façade; ¿señor? ¡Hola!"
        central  "Příliš žluťoučký kůň úpěl ďábelské ódy."
        russian  "Съешь же ещё этих мягких французских булок."
        greek    "Ξεσκεπάζω την ψυχοφθόρα βδελυγμία· γειά."
        turkish  "Pijamalı hasta yağız şoföre çabucak güvendi."
        japanese "いろはにほへと、日本語のエンコーディング試験。"
        schinese "快速的棕色狐狸跳过懒狗。简体中文编码测试。"
        tchinese "快速的棕色狐狸跳過懶狗。繁體中文編碼測試。"
        korean   "다람쥐 헌 쳇바퀴에 타고파. 한국어 인코딩 시험."
    }
    set combos {
        utf-8 0 uni        utf-8 1 uni        utf-16le 1 uni     utf-16be 1 uni
        utf-16le 0 uni     utf-16be 0 uni     utf-32le 1 uni     utf-32be 1 uni
        cp1252 0 west      iso8859-1 0 west1  iso8859-15 0 west
        cp1250 0 central   iso8859-2 0 central
        cp1251 0 russian   koi8-r 0 russian   iso8859-5 0 russian
        cp1253 0 greek     iso8859-7 0 greek  cp1254 0 turkish
        cp932 0 japanese   shiftjis 0 japanese euc-jp 0 japanese
        cp936 0 schinese   big5 0 tchinese    euc-kr 0 korean
    }
    set path [file join $::ELS_TMP rt.txt]
    set total 0 ; set recovered 0 ; set exact 0 ; set misses {}
    puts "\n=== encoding round-trip: save-with-encoding -> reopen -> detect (100 combos) ==="
    foreach {enc bom skey} $combos {
        set rc 0 ; set xc 0
        for {set v 0} {$v < 4} {incr v} {
            switch $v {
                0 { set text $S($skey) }
                1 { set text "$S($skey) $S($skey)" }
                2 { set text "$S($skey) 0123456789 line $v." }
                3 { set text "$S($skey)\n$S($skey)\n$S($skey)" }
            }
            incr total
            # --- save the buffer with this encoding (els's save path) ---
            els_reset
            [els::T] insert end $text
            set ::els::docEnc($::els::active) $enc
            set ::els::docBom($::els::active) $bom
            set ::els::docEol($::els::active) lf
            set ::els::docPath($::els::active) $path
            els::save
            # --- reopen it fresh: detection runs again ---
            els::open $path
            set got [[els::T] get 1.0 "end - 1 char"]
            set det $::els::docEnc($::els::active)
            if {$got eq $text} { incr recovered ; incr rc }
            if {$det eq $enc}  { incr exact ; incr xc }
            if {$got ne $text} { lappend misses [format "%s v%d -> %s" $enc $v $det] }
        }
        puts [format "  %-10s %-9s  text %d/4   exact-enc %d/4" $enc $skey $rc $xc]
    }
    puts [format "  --> text recovered: %d/%d   exact encoding: %d/%d" \
        $recovered $total $exact $total]
    if {[llength $misses]} { puts "  not recovered: [join $misses {, }]" }
    puts "  (UTF*/CJK/Western recover fully; short single-byte Cyrillic /\
Central-European are the heuristic's hard cases)"
    # Strict: every one of the 100 combos must recover its text exactly.  The
    # bar used to be a vague ">= 70"; the save/reopen path actually round-trips
    # all of them (each text is paired with an encoding that can represent it),
    # so assert the full count and catch any regression in save/detect/decode.
    expr {$total == 100 && $recovered == 100}
} -result 1

# ---- distilled from encoding_stress.tcl (headless, deterministic) --------
# Reopen-with always re-decodes the PRESERVED original bytes (docRaw), never the
# current mojibake buffer: so reopening under several wrong encodings and then
# the right one fully restores the text.  This guards the docRaw-based reopen
# design that the reg-1.x data-loss fixes depend on.
test enc-5.1 {reopen under wrong encodings then back to the right one restores the text} -setup {els_reset} -body {
    set text "Съешь же ещё этих мягких французских булок.\n"
    set p [write_raw cyr_reopen.txt [encoding convertto cp1251 $text]]
    els::open $p
    els::reopen_with cp1252 0
    set garbled [[els::T] get 1.0 "end - 1 char"]
    foreach wrong {utf-16le big5 cp932 utf-8} { els::reopen_with $wrong 0 }
    els::reopen_with cp1251 0
    set restored [[els::T] get 1.0 "end - 1 char"]
    list [expr {$garbled ne $text}] [expr {$restored eq $text}]
} -result {1 1}

# BOM-less UTF-16 BE (only LE was covered by enc-3.1 / reg-5.2).
test enc-5.2 {a BOM-less UTF-16BE ASCII file is detected as wide (big-endian)} \
        -constraints detect -setup {els_reset} -body {
    set p [write_raw be_nobom.txt [encoding convertto utf-16be "Hello, wide world from big-endian UTF-16.\n"]]
    els::open $p
    list $::els::docEnc($::els::active) $::els::docBom($::els::active)
} -result {utf-16be 0}

# ---- bug-hunt wave 2: BOM and fallback hardening ---------------------------

test enc-6.1 {a UTF-8 BOM glued onto legacy bytes does not destroy them (lossless round-trip)} -setup {els_reset} -body {
    set bytes "\xEF\xBB\xBF[encoding convertto cp1252 "café olé\n"]"
    set p [write_raw bom_legacy.txt $bytes]
    els::open $p
    els::save
    list [string equal [raw_read $p] $bytes] $::els::docBom($::els::active)
} -result {1 0}

test enc-6.2 {a real UTF-8 BOM on valid payload is still detected as utf-8+BOM} -setup {els_reset} -body {
    els::detect_encoding "\xEF\xBB\xBF[encoding convertto utf-8 "héllo wörld"]"
} -result {utf-8 1}

test enc-6.3 {decode strips a BOM only when its bytes are actually present} -body {
    list [els::decode "Hello" utf-8 1] \
         [els::decode "\xEF\xBB\xBFHello" utf-8 1] \
         [els::decode "H\x00i\x00" utf-16le 1] \
         [els::decode "\xFF\xFEH\x00i\x00" utf-16le 1]
} -result {Hello Hello Hi Hi}

test enc-6.4 {Reopen as "UTF-8 with BOM" on a BOM-less file keeps the content and adds the BOM on save} -setup {els_reset} -body {
    set p [write_raw nobom.txt "Hello, world\n"]
    els::open $p
    els::reopen_with utf-8 1
    set buf [els_text]
    els::save
    list $buf [string equal [raw_read $p] "\xEF\xBB\xBFHello, world\n"]
} -result [list "Hello, world\n" 1]

test enc-6.5 {bytes cp1252 cannot round-trip demote the fallback to Latin-1 (lossless)} -setup {els_reset} -body {
    set saved $::els::have_detect ; set ::els::have_detect 0
    set a [els::detect_encoding "abc\x81\xE9"]
    set b [els::detect_encoding "abc\xE9"]
    set ::els::have_detect $saved
    list $a $b
} -result {{iso8859-1 0} {cp1252 0}}

test enc-6.6 {a 0x81-bearing file round-trips byte-exact through open + save} -setup {els_reset} -body {
    set saved $::els::have_detect ; set ::els::have_detect 0
    set bytes "price \x80 100 \x81 caf\xE9\n"
    set p [write_raw c1bytes.txt $bytes]
    els::open $p
    els::save
    set ::els::have_detect $saved
    string equal [raw_read $p] $bytes
} -result 1

# ---- lossy-save guard (roadmap #4): never silently drop characters ---------

# Scaffold: a saved ascii-encoded file whose buffer then gains a char ascii
# cannot hold.  Returns the doc id (the file path is in docPath).
proc lossy_doc {} {
    set p [els_tmpfile lossy.txt "plain\n"]
    set id [els::open $p]
    set ::els::docEnc($id) ascii
    [els::T] insert end "café"      ;# é is not ascii
    return $id
}

test lossy-1.1 {cancel writes nothing and keeps the document dirty} -setup {els_reset} -body {
    set id [lossy_doc]
    set ::els_test_lossy_answer cancel
    set ok [els::save]
    list $ok [llength $::els_test_lossy_calls] [els::doc_dirty $id] [raw_read $::els::docPath($id)]
} -result [list 0 1 1 "plain\n"]

test lossy-1.2 {Save as UTF-8 keeps every character and switches the document} -setup {els_reset} -body {
    set id [lossy_doc]
    set ::els_test_lossy_answer utf8
    set ok [els::save]
    list $ok $::els::docEnc($id) [els::doc_dirty $id] \
        [string match "*caf\xC3\xA9*" [raw_read $::els::docPath($id)]] \
        [.sb.enc cget -text]
} -result {1 utf-8 0 1 UTF-8}

test lossy-1.3 {Save anyway replaces, and the consent latches for the session} -setup {els_reset} -body {
    set id [lossy_doc]
    set ::els_test_lossy_answer lossy
    set ok1 [els::save]
    set first [raw_read $::els::docPath($id)]
    [els::T] insert end " ü"        ;# more non-ascii; must NOT re-ask
    set ok2 [els::save]
    list $ok1 $ok2 [string match "*caf?*" $first] [llength $::els_test_lossy_calls] \
        [info exists ::els::docLossyOk($id)]
} -result {1 1 1 1 1}

test lossy-1.4 {clean text saves without any question} -setup {els_reset} -body {
    set p [els_tmpfile lossyclean.txt "plain\n"]
    set id [els::open $p]
    set ::els::docEnc($id) ascii
    [els::T] insert end "more"
    set ok [els::save]
    list $ok [llength $::els_test_lossy_calls] [raw_read $p]
} -result [list 1 0 "plain\nmore"]

test lossy-1.5 {describe pinpoints line, column, codepoint, and count} -body {
    lassign [els::lossy_describe ascii "ab\ncdé xü é"] line col uhex count
    list $line $col $uhex $count
} -result {2 3 00E9 3}

test lossy-1.5b {describe stays correct where -failindex lies (gb2312-raw byte-index quirk)} -body {
    # gb2312-raw encodes CJK but NOT ASCII, and Tcl 9.0.3's convertto
    # -failindex reports a BYTE index into the internal UTF-8 rep for it
    # (contradicting encoding(n)) -- lossy_first must locate the failure
    # itself.  Here: 你(0) 好(1) A(2) 界(3) \n(4) -> first fail is "A" at
    # char 2 = line 1 col 3; "A" and "\n" both fail -> count 2.
    lassign [els::lossy_describe gb2312-raw "你好A界\n"] line col uhex count
    list $line $col $uhex $count
} -result {1 3 0041 2}

test lossy-1.6 {quiet mode (auto-save) pauses instead of asking} -setup {els_reset} -body {
    set id [lossy_doc]
    set ok [els::save $id 1]
    list $ok [llength $::els_test_lossy_calls] [info exists ::els::docLossyPause($id)] \
        [raw_read $::els::docPath($id)]
} -result [list 0 0 1 "plain\n"]

test lossy-1.7 {choosing a new encoding clears the lossy consent latch} -setup {els_reset} -body {
    set id [lossy_doc]
    set ::els_test_lossy_answer lossy
    els::save
    set latched [info exists ::els::docLossyOk($id)]
    els::save_with cp1252 0                  ;# é IS representable here
    set cleared [info exists ::els::docLossyOk($id)]
    els::save
    list $latched $cleared [llength $::els_test_lossy_calls] \
        [string match "*caf\xE9*" [raw_read $::els::docPath($id)]]
} -result {1 0 1 1}

test lossy-1.8 {close-with-save aborts the close when the guard is cancelled} -setup {els_reset} -body {
    set id [lossy_doc]
    set ::els_test_lossy_answer cancel
    set ::els_test_mbanswer yes              ;# "Save changes?" -> yes -> guard -> cancel
    els::close_doc $id
    list [expr {$id in $::els::docs}] [els::doc_dirty $id]
} -result {1 1}

# ---- F13: the REAL lossy dialog (stubbed everywhere else).  Drive the modal by
# auto-clicking each button once it exists so the vwait returns that verdict --
# proving the dialog builds and every button maps to its answer.  A safety timer
# turns a build failure into a test failure instead of a hung suite.
proc lossy_autoclick {btn} {
    if {[winfo exists .lossy.b.$btn]} { .lossy.b.$btn invoke } \
    else { after 5 [list lossy_autoclick $btn] }
}
test lossy-dialog-1.1 {the real lossy dialog builds and each button returns its verdict (F13)} -setup {els_reset} -body {
    set ::els::probe_quiet 1                          ;# keep the modal transparent (no flash)
    set out {}
    foreach btn {utf8 lossy cancel} {
        set safety [after 3000 {set ::els::lossy_answer cancel}]   ;# never hang
        after 0 [list lossy_autoclick $btn]
        lappend out [els_real_lossy_ask d0 cp1252 1 1 00E9 1]
        after cancel $safety
    }
    set out
} -result {utf8 lossy cancel}

# ---- Wave 2: lossy-decode notice (surface silent U+FFFD substitutions) -----

test declossy-1.1 {decode flags a lossy substitution (a byte the encoding can't hold)} -body {
    set lossy 0
    set text [els::decode "abc\xFFdef" utf-8 0 lossy]   ;# 0xFF is invalid as UTF-8
    list [string first � $text] $lossy
} -result {3 1}

test declossy-1.2 {decode does NOT flag a source that genuinely contains U+FFFD} -body {
    set lossy 0
    set text [els::decode "a\xEF\xBF\xBDb" utf-8 0 lossy]   ;# EF BF BD = valid UTF-8 for U+FFFD
    list [string first � $text] $lossy
} -result {1 0}

test declossy-1.3 {reopen-with a mismatched encoding flags the tab; a clean reopen clears it} -setup {els_reset} -body {
    set p [els_tmpfile declossy.txt "hello\n"]
    els::open $p ; set id $::els::active
    set ::els::docRaw($id) "ok\xFFbad"                    ;# 0xFF invalid as UTF-8
    els::reopen_with utf-8 0
    set flagged [info exists ::els::docDecodeLossy($id)]
    set marked  [string match "*(replaced)*" [els::tab_text $id]]
    els::reopen_with iso8859-1 0                          ;# accepts every byte -> not lossy
    set cleared [expr {![info exists ::els::docDecodeLossy($id)]}]
    list $flagged $marked $cleared
} -result {1 1 1}

test declossy-1.4 {saving clears the decode-lossy marker (the chars become real content)} -setup {els_reset} -body {
    set p [els_tmpfile declossy2.txt "hi\n"]
    els::open $p ; set id $::els::active
    set ::els::docDecodeLossy($id) 1                      ;# pretend a lossy decode on open
    set before [string match "*(replaced)*" [els::tab_text $id]]
    [els::W $id] insert end "x" ; els::save
    list $before [info exists ::els::docDecodeLossy($id)]
} -result {1 0}

test declossy-1.5 {reload_from_disk refreshes the decode-lossy marker (no reload false-negative)} -setup {els_reset} -body {
    set p [els_tmpfile declossy3.txt "clean\n"]
    els::open $p ; set id $::els::active                 ;# clean open, no marker
    set before [info exists ::els::docDecodeLossy($id)]
    # externally rewrite with a byte invalid as UTF-8, and force UTF-8 detection so
    # the reload path is deterministic (detect_encoding would otherwise adapt)
    raw_write $p "ok\xFFbad"
    rename els::detect_encoding _els_de_real
    proc els::detect_encoding {raw} { return {utf-8 0} }
    els::reload_from_disk $id
    set flag [info exists ::els::docDecodeLossy($id)]
    set mark [string match "*(replaced)*" [els::tab_text $id]]
    raw_write $p "all clean now" ; els::reload_from_disk $id     ;# clean -> marker clears
    set cleared [expr {![info exists ::els::docDecodeLossy($id)]}]
    list $before $flag $mark $cleared
} -cleanup {
    if {[llength [info commands _els_de_real]]} { catch {rename els::detect_encoding {}} ; rename _els_de_real els::detect_encoding }
} -result {0 1 1 1}

# ---- astral (U+10000+) and combining/IME sequences ------------------------
# The round-trip suites above are entirely BMP.  Tcl 9 / Tk 9 carry characters
# beyond the BMP as single code points (Tcl 8.6 split them into surrogate halves),
# and IME/emoji input routinely produces astral code points, ZWJ sequences and
# un-precomposed combining runs.  These guard that such text survives
# open -> buffer -> save byte-for-byte, re-encodes correctly into the wide
# encodings (astral needs a surrogate pair in UTF-16 / a 4-byte unit in UTF-32),
# and is never silently normalised.  Every special code point is a \u/\U escape so
# the fixtures stay exact -- no fragile literal multibyte bytes in the source.

# emoji, CJK Ext-B, math-bold, a ZWJ family (U+200D joins), emoji + VS16 (U+FE0F),
# and a skin-tone modifier (U+1F3FD):
set ::ASTRAL "grin \U0001F600 extB \U00020000 math \U0001D400 fam \U0001F468\u200D\U0001F469\u200D\U0001F467\u200D\U0001F466 heart \u2764\uFE0F thumb \U0001F44D\U0001F3FD\n"

test astral-1.1 {UTF-8 astral content round-trips byte-for-byte through open + save} -setup {els_reset} -body {
    set bytes [encoding convertto utf-8 $::ASTRAL]
    set p [write_raw astral_u8.txt $bytes]
    els::open $p
    els::save
    string equal [read_raw $p] $bytes
} -result 1

test astral-1.2 {the buffer holds astral characters as single code points (Tcl 9, not surrogate halves)} -setup {els_reset} -body {
    els::open [write_raw astral_len.txt [encoding convertto utf-8 "\U0001F600\U00020000\n"]]
    set line [[els::T] get 1.0 "1.end"]
    # two code points (would be 4 if Tcl split them into surrogate halves) and the
    # exact astral text survives the decode
    list [string length $line] [expr {$line eq "\U0001F600\U00020000"}]
} -result {2 1}

test astral-1.3 {astral content re-encodes into every wide encoding and reopens intact} -setup {els_reset} -body {
    set path [file join $::ELS_TMP astral_wide.txt]
    set bad {}
    # BOM'd wide + UTF-8 (no ICU needed: a BOM self-identifies, and BOM-less astral
    # UTF-8 validates as UTF-8) -- the point is correct surrogate/4-byte re-encoding
    foreach {enc bom} {utf-8 0 utf-8 1 utf-16le 1 utf-16be 1 utf-32le 1 utf-32be 1} {
        els_reset
        [els::T] insert end $::ASTRAL
        # compare against the SAME get metric captured before the save, so the
        # widget's mandatory trailing newline can never skew the result
        set want [[els::T] get 1.0 "end - 1 char"]
        set ::els::docEnc($::els::active) $enc
        set ::els::docBom($::els::active) $bom
        set ::els::docEol($::els::active) lf
        set ::els::docPath($::els::active) $path
        els::save
        els::open $path
        if {[[els::T] get 1.0 "end - 1 char"] ne $want} { lappend bad "$enc/$bom" }
    }
    set bad
} -result {}

test astral-2.1 {a decomposed combining sequence is preserved, never normalised to precomposed} -setup {els_reset} -body {
    # "cafe" + U+0301 (combining acute) must stay 5 code points, NOT fold to the
    # precomposed U+00E9 form.  els must not apply Unicode normalisation.
    set decomposed "cafe\u0301\n"
    set p [write_raw combine.txt [encoding convertto utf-8 $decomposed]]
    els::open $p
    set line [[els::T] get 1.0 "1.end"]
    els::save
    list [string length $line] [expr {$line eq "cafe\u0301"}] [expr {$line eq "caf\u00e9"}] \
         [string equal [read_raw $p] [encoding convertto utf-8 $decomposed]]
} -result {5 1 0 1}

test astral-2.2 {decomposed Hangul jamo stay distinct from the precomposed syllable} -setup {els_reset} -body {
    set jamo "\u1100\u1161\n"    ;# choseong kiyeok + jungseong a -- NOT precomposed U+AC00
    els::open [write_raw jamo.txt [encoding convertto utf-8 $jamo]]
    set line [[els::T] get 1.0 "1.end"]
    list [string length $line] [expr {$line eq "\uac00"}] [expr {$line eq "\u1100\u1161"}]
} -result {2 0 1}

test astral-2.3 {astral content survives the swap serialize/deserialize round-trip (crash-recovery format)} -setup {els_reset} -body {
    [els::T] insert end $::ASTRAL
    set id $::els::active
    set want [[els::T] get 1.0 "end - 1 char"]
    set blob [els::swap_serialize $id [els::session_id]]
    set rec [els::swap_read [write_raw astral_swap.swp $blob]]
    expr {[dict exists $rec text] && [dict get $rec text] eq $want}
} -result 1

# ---- bug-hunt wave 2: ICU verdicts the name map must not drop ---------------
# ICU reports logical-order Hebrew as ISO-8859-8-I — byte-table identical to
# ISO-8859-8 (the -I only flags ordering).  icu_to_tcl returned "" for it, so a
# correctly-detected Hebrew file fell through to the cp1252 fallback (mojibake).

test hebdet-1.1 {ISO-8859-8-I (ICU's logical-order Hebrew verdict) maps onto iso8859-8} -body {
    els::icu_to_tcl ISO-8859-8-I
} -result iso8859-8

test hebdet-1.2 {visual-order ISO-8859-8 still maps} -body {
    els::icu_to_tcl ISO-8859-8
} -result iso8859-8

test hebdet-1.3 {a logical-Hebrew ISO-8859-8 file opens as Hebrew, not cp1252 mojibake} \
        -constraints detect -setup {els_reset} -body {
    set heb [string repeat "בראשית ברא אלהים את השמים ואת הארץ " 3]
    set p [write_raw heb8i.txt [encoding convertto iso8859-8 "$heb\n"]]
    els::open $p
    # ICU may statistically verdict 8859-8(-I) or its cp1255 superset; both
    # decode these bytes to the same Hebrew letters — cp1252/latin1 is the bug.
    list [expr {$::els::docEnc($::els::active) in {iso8859-8 cp1255}}] [[els::T] get 1.0 1.6]
} -result [list 1 "בראשית"]

# ---- bug-hunt wave 2: encoding detection + save polish (F24, F21, F22) ------

test detectwide-6.1 {a tiny file with one stray NUL is read as text, not misdetected as UTF-16 (F24)} -body {
    list [els::detect_encoding "a\x00b\x0A"] [els::detect_encoding "hello\x00world\n"]
} -result {{utf-8 0} {utf-8 0}}

test detectwide-6.2 {a genuine BOM-less UTF-16LE file is still detected as wide (regression guard)} -setup {els_reset} -body {
    set p [write_raw wide6.txt [encoding convertto utf-16le "The quick brown fox jumps over.\n"]]
    els::open $p
    list $::els::docEnc($::els::active) $::els::docBom($::els::active)
} -result {utf-16le 0}

test reopen-empty-6.1 {Reopen with Encoding works on a genuinely empty (0-byte) file, no false "recovered" refusal (F21)} -setup {els_reset} -body {
    set p [write_raw empty6.txt ""]                ;# 0-byte file on disk
    els::open $p
    set id $::els::active
    set before [list $::els::docEnc($id) [els_text $id]]
    set ::els_test_mbcount 0
    els::reopen_with utf-16le 0                     ;# must NOT pop the "recovered content" refusal
    list $before [list $::els::docEnc($id) [els_text $id]] $::els_test_mbcount
} -result {{utf-8 {}} {utf-16le {}} 0}

test reopen-recovered-6.1 {Reopen with Encoding STILL refuses a recovered-but-unsaved tab (uncached bytes)} -setup {els_reset} -body {
    set id $::els::active
    set ::els::docPath($id) [file join $::ELS_TMP recov6.txt]   ;# has a path...
    set ::els::docRaw($id) ""                                   ;# ...but no cached bytes
    set ::els::docRecovered($id) 1                              ;# and it's a recovered tab
    set ::els_test_mbcount 0
    els::reopen_with utf-16le 0
    list $::els::docEnc($id) $::els_test_mbcount                ;# unchanged + one refusal dialog
} -result {utf-8 1}

test lossy-utf8-6.1 {the lossy dialog omits the pointless "Save as UTF-8" action when the target is already utf-8 (F22)} -body {
    list [els::lossy_actions utf-8] [els::lossy_actions cp1252] [els::lossy_actions shiftjis]
} -result {{lossy cancel} {utf8 lossy cancel} {utf8 lossy cancel}}

# ---- bug-hunt wave 2: cp932/euc-jp round-trip loss (F17) -------------------
# Some cp932/euc-jp characters ENCODE cleanly but decode back as a DIFFERENT
# character (U+2212 MINUS -> the bytes for U+FF0D), so a plain encodability
# check saved them silently; the lossy guard now round-trips.

test lossyrt-7.1 {enc_faithful catches a cp932 round-trip loss, passes clean text (F17)} -body {
    list [els::enc_faithful cp932 "abc"] [els::enc_faithful cp932 "あ"] \
         [els::enc_faithful cp932 "−"] [els::enc_faithful utf-8 "−"] \
         [els::enc_faithful cp1252 "café"]
} -result {1 1 0 1 1}

test lossyrt-7.2 {saving a cp932 doc with a non-round-tripping char prompts, not silent (F17)} -setup {els_reset} -body {
    set w [els::T] ; $w insert end "price − 5"       ;# U+2212 encodes but round-trips to U+FF0D
    set id $::els::active
    set ::els::docEnc($id) cp932
    set ::els::docPath($id) [file join $::ELS_TMP rt7a.txt]
    set ::els_test_lossy_calls {} ; set ::els_test_lossy_answer cancel
    set rc [els::save $id]
    catch {file delete -force $::els::docPath($id)}
    list $rc [llength $::els_test_lossy_calls] [lindex $::els_test_lossy_calls 0]
} -result {0 1 {cp932 1 7 2212 1}}

test lossyrt-7.3 {ordinary cp932 text saves with no false lossy prompt (regression)} -setup {els_reset} -body {
    set w [els::T] ; $w insert end "あいう test 123"   ;# clean hiragana + ASCII
    set id $::els::active
    set ::els::docEnc($id) cp932
    set ::els::docPath($id) [file join $::ELS_TMP rt7b.txt]
    set ::els_test_lossy_calls {}
    set rc [els::save $id]
    set exists [file exists $::els::docPath($id)]
    catch {file delete -force $::els::docPath($id)}
    list $rc [llength $::els_test_lossy_calls] $exists
} -result {1 0 1}
