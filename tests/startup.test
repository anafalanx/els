# tests/startup.test -- process-level startup/config/session checks.
source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::test

proc startup_bundle {} {
    # Hosted layout: wish ships in z's shared Tcl/Tk payload (Z_TCLTK, exported by
    # tools/tasks.tcl); the old project-local <repo>/.toolchain was removed in the
    # hosted migration, so probe the payload root instead (F76).
    if {[info exists ::env(Z_TCLTK)] && $::env(Z_TCLTK) ne ""} {
        set tc $::env(Z_TCLTK)
        if {[file exists [file join $tc tcl9 bin wish90.exe]]} { return $tc }
    }
    return ""
}

# Locate a wish to drive the process-level probes.  Prefer one sitting next to
# the interpreter that is actually running the suite (portable to any layout),
# then fall back to z's shared Tcl/Tk payload (Z_TCLTK); return "" if none is found so
# the tests SKIP (constraint below) instead of hard-failing the whole suite on a
# machine without the project-local wish.
proc startup_wish {} {
    set dir [file dirname [info nameofexecutable]]
    set tc [startup_bundle]
    foreach cand [list \
            [file join $dir wish90.exe]  [file join $dir wish90] \
            [file join $dir wish.exe]    [file join $dir wish] \
            [file join $tc tcl9 bin wish90.exe] \
            [file join $tc tcl9 bin wish90]] {
        if {[file executable $cand]} { return $cand }
    }
    return ""
}
# Run the process-level startup tests only when a wish is actually available.
::tcltest::testConstraint startup [expr {[startup_wish] ne ""}]
proc startup_appdir {name} {
    set d [file join $::ELS_TMP startup_$name]
    catch {file delete -force $d}
    file mkdir $d
    file copy -force [file join $::ELS_ROOT els.tcl] [file join $d els.tcl]
    return $d
}
proc startup_write {path bytes} {
    set f [open $path w]
    fconfigure $f -translation binary
    puts -nonewline $f $bytes
    close $f
    return $path
}
proc startup_read {path} {
    set f [open $path r]
    try { return [read $f] } finally { close $f }
}
# Create a large fixture without manufacturing a 40 MiB Tcl string.  The hole is
# never read when startup correctly defers the file.
proc startup_sparse {path size} {
    set f [open $path w]
    fconfigure $f -translation binary
    seek $f [expr {$size - 1}] start
    puts -nonewline $f x
    close $f
    return $path
}
proc startup_wait_report {report pid} {
    set deadline [expr {[clock milliseconds] + 5000}]
    while {[clock milliseconds] < $deadline} {
        if {[file exists $report]} {
            set f [open $report r]
            set data [read $f]
            close $f
            # only accept a fully-written report (parses as a dict)
            if {![catch {dict size $data}]} { return $data }
        }
        after 50
    }
    # recycle-safe: only kill if the PID is still the wish we launched
    catch {exec taskkill /FI "PID eq [lindex $pid 0]" \
                        /FI "IMAGENAME eq [file tail [startup_wish]]" /T /F}
    error "startup probe did not finish"
}
proc startup_probe {appdir args} {
    set report [file join $appdir report.txt]
    catch {file delete -force $report}

    set hadAppData [info exists ::env(APPDATA)]
    set hadLocal   [info exists ::env(LOCALAPPDATA)]
    set hadProbe   [info exists ::env(ELS_STARTUP_PROBE)]
    if {$hadAppData} { set oldAppData $::env(APPDATA) }
    if {$hadLocal}   { set oldLocal   $::env(LOCALAPPDATA) }
    if {$hadProbe}   { set oldProbe   $::env(ELS_STARTUP_PROBE) }
    set ::env(APPDATA) [file join $appdir appdata]
    set ::env(LOCALAPPDATA) [file join $appdir localappdata]
    set ::env(ELS_STARTUP_PROBE) $report
    set pid [exec [startup_wish] [file join $appdir els.tcl] {*}$args &]
    if {$hadAppData} { set ::env(APPDATA) $oldAppData } else { unset ::env(APPDATA) }
    if {$hadLocal}   { set ::env(LOCALAPPDATA) $oldLocal } else { unset ::env(LOCALAPPDATA) }
    if {$hadProbe}   { set ::env(ELS_STARTUP_PROBE) $oldProbe } else { unset ::env(ELS_STARTUP_PROBE) }

    return [startup_wait_report $report $pid]
}

test startup-1.1 {first launch pins adjacent config with no location prompt} -constraints startup -setup {
    set app [startup_appdir first]
} -body {
    set r [startup_probe $app]
    list [dict get $r mapped] [dict get $r cfgask] [dict get $r cfgask_mapped] \
         [expr {[dict get $r config] eq [file join $app els.conf]}] \
         [file exists [file join $app els.conf]] \
         [file exists [file join $app localappdata els els.conf]]
} -cleanup {
    catch {file delete -force $app}
} -result {1 0 0 1 0 0}

test startup-1.2 {existing adjacent config is loaded without any location prompt} -constraints startup -setup {
    set app [startup_appdir configured]
} -body {
    set conf [file join $app els.conf]
    startup_write $conf [dict create geometry 800x600 recent {} word_wrap 0 \
        restore_session 1 session_files {} session_active ""]
    set r [startup_probe $app]
    list [dict get $r mapped] [dict get $r cfgask] \
         [file tail [dict get $r config]] [dict get $r docs]
} -cleanup {
    catch {file delete -force $app}
} -result {1 0 els.conf 1}

test startup-1.3 {startup restore reopens saved files and active tab} -constraints startup -setup {
    set app [startup_appdir restore]
} -body {
    set p1 [startup_write [file join $app one.txt] "one\n"]
    set p2 [startup_write [file join $app two.txt] "two\n"]
    set miss [file join $app missing.txt]
    set conf [file join $app els.conf]
    startup_write $conf [dict create geometry 800x600 recent {} word_wrap 0 \
        restore_session 1 session_files [list $p1 $miss $p2] session_active $p2]
    set r [startup_probe $app]
    list [dict get $r cfgask] [dict get $r docs] \
         [lmap p [dict get $r paths] {file tail $p}] \
         [file tail [dict get $r active_path]]
} -cleanup {
    catch {file delete -force $app}
} -result {0 2 {one.txt two.txt} two.txt}

test startup-1.4 {explicit launch file takes precedence over saved session} -constraints startup -setup {
    set app [startup_appdir explicit]
} -body {
    set p1 [startup_write [file join $app previous.txt] "previous\n"]
    set p2 [startup_write [file join $app explicit.txt] "explicit\n"]
    set conf [file join $app els.conf]
    startup_write $conf [dict create geometry 800x600 recent {} word_wrap 0 \
        restore_session 1 session_files [list $p1] session_active $p1]
    set r [startup_probe $app $p2]
    list [dict get $r cfgask] [dict get $r docs] \
         [lmap p [dict get $r paths] {file tail $p}] \
         [file tail [dict get $r active_path]]
} -cleanup {
    catch {file delete -force $app}
} -result {0 1 explicit.txt explicit.txt}

test startup-1.5 {a large explicit startup file becomes a lazy placeholder tab, never silently loaded} \
        -constraints startup -setup {
    set app [startup_appdir deferred]
} -body {
    set p [startup_sparse [file join $app huge.txt] 41943041]
    set r [startup_probe $app $p]
    # the large file is a real (lazy) tab now: docs=1, its path IS the tab's path,
    # it is listed under the probe's `lazy` key, and no els.deferred file exists.
    list [dict get $r cfgask] [dict get $r docs] \
         [lmap q [dict get $r paths] {file tail $q}] \
         [lmap q [dict get $r lazy] {file tail $q}] \
         [file exists [file join $app els.deferred]]
} -cleanup {
    catch {file delete -force $app}
} -result {0 1 huge.txt huge.txt 0}

test startup-1.6 {failed explicit path is logged and does not suppress a usable saved session} \
        -constraints startup -setup {
    set app [startup_appdir missing_explicit]
} -body {
    set prior [startup_write [file join $app prior.txt] "prior session\n"]
    set missing [file join $app missing-explicit.txt]
    set conf [file join $app els.conf]
    startup_write $conf [dict create geometry 800x600 recent {} word_wrap 0 \
        restore_session 1 session_files [list $prior] session_active $prior]
    set r [startup_probe $app $missing]
    set log [file join $app els.log]
    list [dict get $r docs] [lmap p [dict get $r paths] {file tail $p}] \
         [expr {[file exists $log] && [string match "*quiet open failed*" [startup_read $log]]}]
} -cleanup {
    catch {file delete -force $app}
} -result {1 prior.txt 1}

test startup-1.7 {mixed good and failed explicit paths keep the good launch and log the failure} \
        -constraints startup -setup {
    set app [startup_appdir mixed_explicit]
} -body {
    set prior [startup_write [file join $app previous.txt] "previous\n"]
    set good [startup_write [file join $app good.txt] "good\n"]
    set missing [file join $app absent.txt]
    startup_write [file join $app els.conf] [dict create geometry 800x600 recent {} word_wrap 0 \
        restore_session 1 session_files [list $prior] session_active $prior]
    set r [startup_probe $app $missing $good]
    set log [file join $app els.log]
    list [dict get $r docs] [lmap p [dict get $r paths] {file tail $p}] \
         [expr {[file exists $log] && [string match "*quiet open failed*" [startup_read $log]]}]
} -cleanup {
    catch {file delete -force $app}
} -result {1 good.txt 1}
