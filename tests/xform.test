# tests/xform.test -- the curated text-manipulation commands (els::xform::*).
# Each proc is exercised directly (buffer in -> buffer out) plus edge cases, undo
# atomicity, and a couple of keybinding smoke checks.  els_reset builds a focused
# active document (helpers.tcl), so [els::T] is a live text widget.

source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::test

# fill the active buffer with $s, clear the undo stack, drop the caret at 1.0
proc xf_fill {s} {
    set w [els::T]
    $w delete 1.0 end ; $w insert end $s ; $w edit reset ; $w mark set insert 1.0
    return $w
}
proc xf_body {} { return [[els::T] get 1.0 "end - 1 char"] }
proc xf_sel {a b} { set w [els::T] ; $w tag remove sel 1.0 end ; $w tag add sel $a $b }
proc xf_menu_has {menu label} {
    for {set i 0} {$i <= [$menu index end]} {incr i} {
        if {[$menu type $i] eq "command" && ![catch {$menu entrycget $i -label} l] && $l eq $label} { return 1 }
    }
    return 0
}
proc xf_menubar_has {label} {
    for {set i 0} {$i <= [.menu index end]} {incr i} {
        if {[.menu type $i] eq "cascade" && ![catch {.menu entrycget $i -label} l] && $l eq $label} { return 1 }
    }
    return 0
}

# ---- move line up / down --------------------------------------------------
test xform-move-1.1 {move the current line down} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; $w mark set insert 1.0
    els::xform::move 1 ; xf_body
} -result "b\na\nc"
test xform-move-1.2 {move the current line up} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; $w mark set insert 2.0
    els::xform::move -1 ; xf_body
} -result "b\na\nc"
test xform-move-1.3 {move up at the top is a no-op} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; $w mark set insert 1.0
    els::xform::move -1 ; xf_body
} -result "a\nb\nc"
test xform-move-1.4 {move down at the bottom is a no-op} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; $w mark set insert 3.0
    els::xform::move 1 ; xf_body
} -result "a\nb\nc"
test xform-move-1.5 {move a multi-line selection down as a block} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc\nd"] ; xf_sel 1.0 2.end
    els::xform::move 1 ; xf_body
} -result "c\na\nb\nd"

# ---- duplicate ------------------------------------------------------------
test xform-dup-1.1 {duplicate the current line below it} -setup {els_reset} -body {
    set w [xf_fill "a\nb"] ; $w mark set insert 1.0
    els::xform::duplicate ; xf_body
} -result "a\na\nb"
test xform-dup-1.2 {duplicate a multi-line selection as a block} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; xf_sel 1.0 2.end
    els::xform::duplicate ; xf_body
} -result "a\nb\na\nb\nc"

# ---- delete line ----------------------------------------------------------
test xform-del-1.1 {delete a middle line} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; $w mark set insert 2.0
    els::xform::delete_line ; xf_body
} -result "a\nc"
test xform-del-1.2 {delete the last line (no dangling blank line)} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; $w mark set insert 3.0
    els::xform::delete_line ; xf_body
} -result "a\nb"
test xform-del-1.3 {delete the first line} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; $w mark set insert 1.0
    els::xform::delete_line ; xf_body
} -result "b\nc"
test xform-del-1.4 {delete the only line empties the buffer} -setup {els_reset} -body {
    set w [xf_fill "abc"] ; $w mark set insert 1.0
    els::xform::delete_line ; xf_body
} -result ""
test xform-del-1.5 {delete all lines spanned by a selection} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc\nd"] ; xf_sel 2.0 3.end
    els::xform::delete_line ; xf_body
} -result "a\nd"

# ---- join lines -----------------------------------------------------------
test xform-join-1.1 {join the current line with the next} -setup {els_reset} -body {
    set w [xf_fill "hello\nworld"] ; $w mark set insert 1.0
    els::xform::join_lines ; xf_body
} -result "hello world"
test xform-join-1.2 {join selected lines, trimming leading whitespace} -setup {els_reset} -body {
    set w [xf_fill "a\n  b\n\tc"] ; xf_sel 1.0 3.end
    els::xform::join_lines ; xf_body
} -result "a b c"
test xform-join-1.3 {join on the last line is a no-op} -setup {els_reset} -body {
    set w [xf_fill "a\nb"] ; $w mark set insert 2.0
    els::xform::join_lines ; xf_body
} -result "a\nb"

# (sort / reverse / dedupe / case / trim are no longer built-ins: they ship as
# the seeded default BUFFER SCRIPTS.  Their behavior — including the
# newline-terminated-buffer cases — is covered in tests/scripts.test.)

# ---- indent / dedent ------------------------------------------------------
test xform-indent-1.1 {indent the selected lines with a tab} -setup {els_reset} -body {
    set w [xf_fill "a\nb"] ; xf_sel 1.0 2.end
    els::xform::indent ; xf_body
} -result "\ta\n\tb"
test xform-dedent-1.1 {dedent removes a leading tab} -setup {els_reset} -body {
    set w [xf_fill "\ta\n\tb"] ; xf_sel 1.0 2.end
    els::xform::dedent ; xf_body
} -result "a\nb"
test xform-dedent-1.2 {dedent also eats up to four leading spaces} -setup {els_reset} -body {
    set w [xf_fill "    a\n  b"] ; xf_sel 1.0 2.end
    els::xform::dedent ; xf_body
} -result "a\nb"

# ---- Tab / Shift+Tab key BINDINGS (must never delete a selection) ----------
# Regression: Tk's default Text <Tab> (tk::TextInsert) REPLACES a selection with a
# tab.  els's <Key-Tab> binding must intercept ANY selection (indent it + break) so a
# stray fall-through can never eat the selected text; only a bare caret inserts a tab.
test xform-tab-1.1 {Tab with a multi-line selection indents every line} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; xf_sel 1.0 2.end ; focus -force $w
    event generate $w <Key-Tab> ; update
    xf_body
} -result "\ta\n\tb\nc"
test xform-tab-1.2 {Tab with a selection ending at column 0 indents, never deletes text} -setup {els_reset} -body {
    set w [xf_fill "hello\nworld"] ; xf_sel 1.2 2.0 ; focus -force $w   ;# mid-line-1 -> start-of-line-2
    event generate $w <Key-Tab> ; update
    xf_body
} -result "\thello\nworld"
test xform-tab-1.3 {Tab with a within-line selection indents the line, keeping the text} -setup {els_reset} -body {
    set w [xf_fill "hello world"] ; xf_sel 1.0 1.5 ; focus -force $w
    event generate $w <Key-Tab> ; update
    xf_body
} -result "\thello world"
test xform-tab-1.4 {Tab with no selection inserts a literal tab at the caret} -setup {els_reset} -body {
    set w [xf_fill "ab"] ; $w mark set insert 1.1 ; focus -force $w
    event generate $w <Key-Tab> ; update
    xf_body
} -result "a\tb"
test xform-tab-1.5 {Shift+Tab dedents the selected lines} -setup {els_reset} -body {
    set w [xf_fill "\ta\n\tb"] ; xf_sel 1.0 2.end ; focus -force $w
    event generate $w <Shift-Key-Tab> ; update
    xf_body
} -result "a\nb"

# ---- undo atomicity: one transform == one undo ----------------------------
test xform-undo-1.2 {a duplicate is a single undo step} -setup {els_reset} -body {
    set w [xf_fill "a\nb"] ; $w mark set insert 1.0 ; els::xform::duplicate
    $w edit undo ; xf_body
} -result "a\nb"

# ---- boundary / edge cases ------------------------------------------------
test xform-edge-1.1 {every built-in command is safe (no throw) on an empty buffer} -setup {els_reset} -body {
    set errs {}
    foreach cmd {{move 1} {move -1} duplicate delete_line join_lines indent dedent} {
        xf_fill ""    ;# a fresh empty buffer before each
        if {[catch {els::xform::[lindex $cmd 0] {*}[lrange $cmd 1 end]} e]} { lappend errs "$cmd: $e" }
    }
    set errs
} -result {}
test xform-edge-1.2 {duplicate the LAST line (mandatory-final-newline boundary)} -setup {els_reset} -body {
    set w [xf_fill "a\nb"] ; $w mark set insert 2.0
    els::xform::duplicate ; xf_body
} -result "a\nb\nb"
test xform-edge-1.4 {a selection ending at column 0 does not pull in that trailing line (move down)} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc"] ; xf_sel 1.0 2.0
    els::xform::move 1 ; xf_body
} -result "b\na\nc"
# ---- keybinding smoke: Ctrl+D is wired to Duplicate -----------------------
test xform-key-1.1 {Ctrl+D on elsText invokes Duplicate Line (repurposed from a neutralized default)} -setup {els_reset} -body {
    string match "*xform::duplicate*" [bind elsText <Control-d>]
} -result 1

# ---- the commands live in a top-level Buffer menu, not in Edit -------------
test xform-menu-1.1 {a Buffer menu carries the transforms; Edit no longer does} -setup {els_reset} -body {
    list [xf_menubar_has Buffer] \
         [xf_menu_has .menu.buffer "Duplicate Line"] [xf_menu_has .menu.buffer "Sort Lines"] \
         [xf_menu_has .menu.buffer "UPPERCASE"] \
         [xf_menu_has .menu.edit "Duplicate Line"]
} -result {1 1 1 1 0}

# ---- bug-hunt wave 2: newline-terminated buffers (the phantom final line) ----
# A document whose text ends in \n leaves the widget's mandatory final line
# EMPTY: that pseudo-line represents the trailing newline, not content.  Line
# ops must stop at the last DOCUMENT line (xform::lastdoc).  (The sort/reverse/
# dedupe/case halves of this wave moved to tests/scripts.test with the scripts.)

test xform-nl-2.9 {move down at the last content line of a terminated buffer is a no-op} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc\n"] ; $w mark set insert 3.0
    els::xform::move 1 ; xf_body
} -result "a\nb\nc\n"

test xform-nl-2.10 {join on the last content line of a terminated buffer is a no-op (no stray space)} -setup {els_reset} -body {
    set w [xf_fill "a\nb\n"] ; $w mark set insert 2.0
    els::xform::join_lines ; xf_body
} -result "a\nb\n"

test xform-nl-2.11 {move down still works between content lines of a terminated buffer} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc\n"] ; $w mark set insert 2.0
    els::xform::move 1 ; xf_body
} -result "a\nc\nb\n"

test xform-nl-2.12 {delete_line on the last content line still removes line + separator} -setup {els_reset} -body {
    set w [xf_fill "a\nb\nc\n"] ; $w mark set insert 3.0
    els::xform::delete_line ; xf_body
} -result "a\nb\n"

test xform-nl-2.13 {Select-All indent does not turn the phantom line into a real tab line} -setup {els_reset} -body {
    set w [xf_fill "a\nb\n"] ; xf_sel 1.0 end
    els::xform::indent ; xf_body
} -result "\ta\n\tb\n"

# bug-hunt wave 2 (F69): the Buffer > Indent item dropped its "Tab" accelerator —
# Tab only indents with a selection (no selection inserts a literal tab, by
# design), so the unconditional accelerator over-claimed.  Dedent keeps Shift+Tab
# (it always dedents).
test xform-menu-1.2 {Indent has no over-claimed Tab accelerator; Dedent keeps Shift+Tab (F69)} -setup {els_reset} -body {
    set bm .menu.buffer ; set got {}
    foreach want {Indent Dedent} {
        set acc MISSING
        for {set i 0} {$i <= [$bm index end]} {incr i} {
            if {[$bm type $i] eq "command" && ![catch {$bm entrycget $i -label} l] && $l eq $want} {
                set acc [$bm entrycget $i -accelerator] ; break
            }
        }
        lappend got $acc
    }
    set got
} -result {{} Shift+Tab}
