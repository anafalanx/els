# tests/view.test — go-to-line and Show-Whitespace logic.
source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::test

test goto-1.1 {go to line moves the cursor} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "one\ntwo\nthree\nfour\nfive\n"
    els::goto_line
    .goto.f.e insert 0 "3"
    els::goto_do .goto
    $w index insert
} -result 3.0

test goto-1.2 {go to line clamps past the last line} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "a\nb\nc\n"
    els::goto_line
    .goto.f.e insert 0 "999"
    els::goto_do .goto
    lindex [split [$w index insert] .] 0
} -result 4

test goto-1.3 {non-numeric input is ignored (cursor stays)} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "a\nb\nc\n"
    $w mark set insert 2.0
    els::goto_line
    .goto.f.e insert 0 "xyz"
    els::goto_do .goto
    $w index insert
} -result 2.0

test ws-1.1 {Show Whitespace tags tabs and trailing whitespace} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "a\tb  \n\tc\n"
    set ::els::show_ws 1
    els::ws_refresh
    list [expr {[llength [$w tag ranges wsTab]]/2}] [expr {[llength [$w tag ranges wsTrail]]/2}]
} -result {2 1}

test ws-1.2 {toggling Show Whitespace off clears the tags} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "x\ty   \n"
    set ::els::show_ws 1 ; els::ws_refresh
    set ::els::show_ws 0 ; els::ws_refresh
    list [llength [$w tag ranges wsTab]] [llength [$w tag ranges wsTrail]]
} -result {0 0}
