# tests/view.test — go-to-line and Show-Whitespace logic.
source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::test

test goto-1.1 {go to line moves the cursor} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "one\ntwo\nthree\nfour\nfive\n"
    els::goto_line
    .goto.f.e insert 0 "3"
    els::goto_do .goto
    $w index insert
} -result 3.0

test goto-1.2 {go to line clamps past the last line} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "a\nb\nc\n"
    els::goto_line
    .goto.f.e insert 0 "999"
    els::goto_do .goto
    lindex [split [$w index insert] .] 0
} -result 4

test goto-1.3 {non-numeric input is ignored (cursor stays)} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "a\nb\nc\n"
    $w mark set insert 2.0
    els::goto_line
    # ttk key-prevalidation rejects a programmatic non-digit insert, so force the
    # bad input in with validation OFF -- otherwise goto_do sees an EMPTY entry and
    # its non-numeric guard is never actually exercised (F59).
    .goto.f.e configure -validate none ; .goto.f.e insert 0 "xyz" ; .goto.f.e configure -validate key
    els::goto_do .goto
    $w index insert
} -result 2.0

test ws-1.1 {Show Whitespace tags spaces, tabs and trailing distinctly} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "a b\tc   \nclean\n" ; update
    set ::els::show_ws 1
    els::ws_refresh
    list [expr {[llength [$w tag ranges wsSpace]] > 0}] \
         [expr {[llength [$w tag ranges wsTab]]   > 0}] \
         [expr {[llength [$w tag ranges wsTrail]] > 0}]
} -result {1 1 1}

test ws-1.2 {toggling Show Whitespace off clears every whitespace tag} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "x y\tz   \n" ; update
    set ::els::show_ws 1 ; els::ws_refresh
    set ::els::show_ws 0 ; els::ws_refresh
    list [llength [$w tag ranges wsSpace]] [llength [$w tag ranges wsTab]] \
         [llength [$w tag ranges wsTrail]]
} -result {0 0 0}

test ws-2.1 {Show Whitespace never dirties the document or alters its text} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "alpha\nbeta\ngamma\n" ; update ; $w edit modified 0
    set ::els::show_ws 1 ; els::ws_refresh ; update
    list [$w edit modified] \
         [string equal [$w get 1.0 "end - 1 char"] "alpha\nbeta\ngamma\n"]
} -result {0 1}

test ws-2.2 {Show Whitespace adds no embedded images} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "x y\tz   \n" ; update
    set ::els::show_ws 1 ; els::ws_refresh ; update
    llength [$w image names]
} -result 0

# ---- word wrap ----------------------------------------------------------
test wrap-1.1 {Word Wrap toggles -wrap on the active document} -setup {els_reset} -body {
    set w [els::T]
    set off [$w cget -wrap]
    set ::els::word_wrap 1 ; els::set_wrap ; set on [$w cget -wrap]
    set ::els::word_wrap 0 ; els::set_wrap
    list $off $on [$w cget -wrap]
} -result {none word none}

test wrap-1.2 {new documents inherit the current wrap setting} -setup {els_reset} -body {
    set ::els::word_wrap 1
    set id [els::new_doc]
    [els::W $id] cget -wrap
} -result word

# ---- font zoom ----------------------------------------------------------
test zoom-1.1 {zoom changes the document font size; the gutter numbers share it} -setup {els_reset} -body {
    [els::T] insert end "one\ntwo\n"
    set base [font configure elsMono -size]
    els::zoom 3 ; els::draw_gutter ; update
    set up [font configure elsMono -size]
    # the gutter draws its numbers in the shared elsMono font, so zooming scales
    # them with the document; check a drawn number uses elsMono
    set fonts {}
    foreach id [.ln find all] { if {[.ln type $id] eq "text"} { lappend fonts [.ln itemcget $id -font] } }
    list [expr {$up == $base + 3}] \
         [expr {[lsearch -exact $fonts elsMono] >= 0}] \
         [expr {[lindex [[els::T] configure -spacing1] 4] == $::els::LEAD}]
} -result {1 1 1}

test zoom-1.2 {zoom out, reset, and clamping} -setup {els_reset} -body {
    els::zoom -2 ; set down $::els::font_size
    els::zoom_reset ; set reset $::els::font_size
    els::set_font_size 999 ; set hi $::els::font_size
    els::set_font_size 0   ; set lo $::els::font_size
    list $down $reset $hi $lo
} -result {9 11 48 6}

test wrap-1.3 {under word wrap, gutter numbers follow the wrapped display rows} -setup {els_reset} -body {
    set w [els::T]
    wm geometry . 500x500 ; update      ;# tall enough to show line 1's wrap + lines 2,3
    $w insert end "[string repeat {word } 30]\nsecond\nthird\n"
    set ::els::word_wrap 1 ; els::set_wrap ; update
    els::draw_gutter ; update
    set ny [gutter_numbers]
    set ls [font metrics elsMono -linespace]
    # line 1 wraps to several rows, so number 2 sits more than one row below it
    list [dict exists $ny 1] [dict exists $ny 2] \
         [expr {[dict get $ny 2] - [dict get $ny 1] > $ls}]
} -result {1 1 1}

test wrap-1.4 {gutter numbers align to the text's display rows under wrap (dlineinfo)} -setup {els_reset} -body {
    set w [els::T]
    wm geometry . 500x500 ; update
    $w insert end "[string repeat {word } 30]\nsecond\n"
    set ::els::word_wrap 1 ; els::set_wrap ; update
    els::draw_gutter ; update
    # the canvas number for line 2 sits at line 2's first-display-row baseline
    set di [$w dlineinfo 2.0]
    set wantY [expr {[lindex $di 1] + [lindex $di 4] - [font metrics elsMono -ascent]}]
    expr {abs([dict get [gutter_numbers] 2] - $wantY) <= 1}
} -result 1

# ---- gutter: viewport-rendered Canvas -----------------------------------
test gutter-1.1 {empty buffer draws line 1 and no current-line band} -setup {els_reset} -body {
    els::draw_gutter ; update
    list [dict keys [gutter_numbers]] [gutter_bands]
} -result {1 0}

test gutter-1.2 {a non-empty buffer draws one current-line band at the caret's line} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "one\ntwo\nthree\nfour"
    $w mark set insert 3.0
    els::refresh_view ; update
    set bandY ""
    foreach id [.ln find all] { if {[.ln type $id] eq "rectangle"} { set bandY [lindex [.ln coords $id] 1] } }
    list [gutter_bands] [expr {$bandY == [lindex [$w dlineinfo 3.0] 1]}]
} -result {1 1}

test gutter-1.3 {the gutter renders only the visible numbers and follows scrolling} -setup {els_reset} -body {
    set w [els::T]
    wm geometry . 360x240 ; update
    for {set i 1} {$i <= 400} {incr i} { $w insert end "L$i\n" }
    els::draw_gutter ; update
    set drawn [dict size [gutter_numbers]]
    $w see end ; update ; els::draw_gutter ; update
    set mn [lindex [lsort -integer [dict keys [gutter_numbers]]] 0]
    list [expr {$drawn < 400}] [expr {$mn > 1}]
} -result {1 1}

test gutter-1.4 {the gutter widens as the line count grows by an order of magnitude} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "a\n" ; els::draw_gutter ; update
    set narrow [.ln cget -width]
    for {set i 1} {$i <= 200} {incr i} { $w insert end "x\n" }
    els::draw_gutter ; update
    expr {[.ln cget -width] > $narrow}
} -result 1

# ---- UX polish ----------------------------------------------------------
test goto-1.4 {go to line rejects hex (0x) and signed (+) input} -setup {els_reset} -body {
    set w [els::T] ; $w insert end "L1\nL2\nL3\nL4\nL5\n"
    $w mark set insert 3.0
    # Force the bad input past ttk key-prevalidation (which would reject it and
    # leave an empty entry) so goto_do's ^[0-9]+$ guard is actually exercised, and
    # assert the entry really held it (F59).
    els::goto_line
    .goto.f.e configure -validate none ; .goto.f.e insert 0 "0x2" ; .goto.f.e configure -validate key
    set hexIn [.goto.f.e get]
    els::goto_do .goto
    set afterHex [lindex [split [$w index insert] .] 0]
    els::goto_line
    .goto.f.e configure -validate none ; .goto.f.e insert 0 "+2" ; .goto.f.e configure -validate key
    els::goto_do .goto
    set afterPlus [lindex [split [$w index insert] .] 0]
    list $hexIn $afterHex $afterPlus
} -result {0x2 3 3}

test ws-1.3 {Show Whitespace flags interior 2+ space runs mauve; single spaces stay grey} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "a   b c\n"   ;# 3-space interior run (1.1-1.3), then a single space (1.5)
    set ::els::show_ws 1 ; els::ws_refresh
    list [expr {[lsearch [$w tag names 1.1] wsTrail] >= 0}] \
         [expr {[lsearch [$w tag names 1.5] wsTrail] >= 0}] \
         [expr {[lsearch [$w tag names 1.5] wsSpace] >= 0}]
} -result {1 0 1}

test wrap-1.5 {current-line wash spans a wrapped logical line; gutter band at its first row} -setup {els_reset} -body {
    set w [els::T]
    wm geometry . 400x400 ; update
    $w insert end "[string repeat {word } 40]\nsecond\n"
    set ::els::word_wrap 1 ; els::set_wrap
    $w mark set insert 1.0
    els::refresh_view ; update
    set r [$w tag ranges currentLine]
    set di [$w dlineinfo 1.0]
    set bandY ""
    foreach id [.ln find all] { if {[.ln type $id] eq "rectangle"} { set bandY [lindex [.ln coords $id] 1] } }
    list [expr {[lindex $r 0] eq "1.0" && [$w compare [lindex $r 1] >= "1.end"]}] \
         [gutter_bands] [expr {$bandY == [lindex $di 1]}]
} -result {1 1 1}

# ---- bug-hunt wave 5: gutter band, scrollbar refeed, wheel math -----------

test gutter-5.1 {current-line band covers a wrapped line's FULL extent (all display rows)} -setup {els_reset} -body {
    set ::els::word_wrap 1 ; els::set_wrap 0
    set w [els::T]
    $w insert end "[string repeat {word } 200]\nsecond line"
    $w mark set insert 1.0
    update ; els::draw_gutter
    set band ""
    foreach id [.ln find all] {
        if {[.ln type $id] eq "rectangle"} { set band [.ln coords $id] }
    }
    set ::els::word_wrap 0 ; els::set_wrap 0
    lassign $band x0 y0 x1 y1
    set rowh [font metrics elsMono -linespace]
    list [expr {$band ne ""}] [expr {($y1 - $y0) > 1.5 * $rowh}]
} -result {1 1}

test gutter-5.2 {band still drawn when the wrapped current line's first row is scrolled off} -setup {els_reset} -body {
    set ::els::word_wrap 1 ; els::set_wrap 0
    set w [els::T]
    $w insert end "[string repeat {word } 400]\ntail"
    $w mark set insert 1.0
    update ; catch {$w sync}           ;# line metrics are async in Tk 9: settle them
    # scroll until line 1's FIRST display row is genuinely off the top (own the
    # precondition: update idletasks only, so no stray timer event can snap the
    # view back mid-test)
    foreach frac {0.05 0.1 0.15 0.2 0.3} {
        $w yview moveto $frac
        catch {$w sync} ; update idletasks
        if {[$w dlineinfo 1.0] eq ""} break
    }
    els::draw_gutter
    set n [gutter_bands]
    # capture BEFORE the wrap cleanup below: un-wrapping puts 1.0 back on screen
    set off [expr {[$w dlineinfo 1.0] eq ""}]
    set ::els::word_wrap 0 ; els::set_wrap 0
    list $off [expr {$n >= 1}]
} -result {1 1}

test scroll-5.1 {a tab switch re-feeds the scrollbar thumb from the live view} -setup {els_reset} -body {
    set a $::els::active
    set w [els::W $a]
    $w insert end [string repeat "line\n" 300]
    update
    $w yview moveto 0.5
    els::new_doc ; update                ;# switch away (view at top)
    els::switch_to $a ; els::update_vscroll
    lassign [.vs get] f l
    expr {$f > 0.3}
} -result 1

# ---- user-issues batch B ---------------------------------------------------

test linenos-b.1 {Line Numbers toggle hides/shows the gutter} -setup {els_reset} -body {
    update idletasks
    set on [winfo ismapped .ln]
    set ::els::show_linenos 0 ; els::set_linenos 0 ; update idletasks
    set off [winfo ismapped .ln]
    set ::els::show_linenos 1 ; els::set_linenos 0 ; update idletasks
    list $on $off [winfo ismapped .ln]
} -result {1 0 1}

test linenos-b.2 {the Line Numbers choice persists through the config round-trip} -setup {els_reset} -body {
    set ::els::show_linenos 0
    els::save_geometry
    set ::els::show_linenos 1                  ;# simulate a fresh start
    els::load_geometry
    set v $::els::show_linenos
    set ::els::show_linenos 1 ; els::set_linenos 0
    catch {file delete -force $::els::config_path}
    set v
} -result 0

test linenos-b.3 {hiding the gutter skips its drawing work entirely} -setup {els_reset} -body {
    [els::T] insert end "one\ntwo\nthree"
    set ::els::show_linenos 0 ; els::set_linenos 0
    .ln delete all
    els::draw_gutter
    set items [llength [.ln find all]]
    set ::els::show_linenos 1 ; els::set_linenos 0
    set items
} -result 0

test linenos-b.4 {a persisted line_numbers=0 hides the gutter on a FRESH start} -setup {els_reset} -body {
    # persist "off", then rebuild the way a fresh process starts: load_geometry
    # runs at the TOP of build, BEFORE .ln exists, so set_linenos can't apply
    # there (the bug: the later unconditional grid left an EMPTY gutter band)
    set fh [::open $::els::config_path w]
    puts -nonewline $fh [dict create geometry 900x620+100+100 line_numbers 0]
    close $fh
    catch {. configure -menu {}}
    foreach w [winfo children .] { destroy $w }
    set ::els::docs {} ; set ::els::active "" ; set ::els::seq 0
    set ::els::show_linenos 1            ;# the namespace default of a fresh process
    els::build ; update idletasks
    list [winfo manager .ln] $::els::show_linenos
} -cleanup {
    catch {file delete -force $::els::config_path}
    set ::els::show_linenos 1
    els_reset
} -result {{} 0}

test tabreorder-b.1 {dragging a tab past a neighbour's midpoint reorders docs and the strip} -setup {els_reset} -body {
    set a $::els::active
    set b [els::new_doc]
    set c [els::new_doc]
    update idletasks
    # drag A to the far right (beyond C's midpoint): order becomes B C A
    set beyond [expr {[winfo rootx [els::tabW $c]] + [winfo width [els::tabW $c]] + 20}]
    els::tab_drag $a $beyond
    els::tab_drag $a $beyond                    ;# second motion: past C too
    set order $::els::docs
    set packed [lmap w [pack slaves .tabs] {
        if {$w eq ".tabs.more"} continue
        set w
    }]
    list [expr {$order eq [list $b $c $a]}] \
         [expr {$packed eq [list [els::tabW $b] [els::tabW $c] [els::tabW $a]]}]
} -result {1 1}

test scroll-5.2 {non-multiple-of-120 wheel deltas scroll symmetrically} -setup {els_reset} -body {
    # NOTE: the manual says `yview scroll N units` wants an integer, but Tk
    # 9.0.3's text widget genuinely does smooth fractional unit scrolling
    # (probed: symmetric, returns to the exact start) — which is what makes
    # the float division both legal and symmetric.
    set w [els::T] ; $w insert end [string repeat "line of text\n" 300]
    update
    $w yview moveto 0.5
    set a [lindex [$w yview] 0]
    els::wheel -40                       ;# was floored to 0 units (dead)
    set b [lindex [$w yview] 0]
    els::wheel 40
    set c [lindex [$w yview] 0]
    els::wheel 120                       ;# the standard notch still works
    set d [lindex [$w yview] 0]
    list [expr {$b > $a}] [expr {$c == $a}] [expr {$d < $c}]
} -result {1 1 1}

# ---- Focus mode (dim all but the current line) ----------------------------

test focus-1.1 {Focus mode dims every line except the current one} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "one\ntwo\nthree\nfour\n" ; update
    $w mark set insert 2.1                            ;# caret on line 2
    set ::els::focus_mode 1 ; els::set_focus_mode 0
    # 1 = that line is dimmed; the current line (2) must NOT be
    list [expr {"focusDim" in [$w tag names 1.0]}] \
         [expr {"focusDim" in [$w tag names 2.0]}] \
         [expr {"focusDim" in [$w tag names 3.0]}]
} -result {1 0 1}

test focus-1.2 {moving the caret flips the dim to follow (delta path)} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "one\ntwo\nthree\nfour\n" ; update
    $w mark set insert 2.0 ; set ::els::focus_mode 1 ; els::set_focus_mode 0
    $w mark set insert 4.0 ; els::update_current_line   ;# caret 2 -> 4: delta flip
    # line 2 (old current) now dimmed; line 4 (new current) now un-dimmed
    list [expr {"focusDim" in [$w tag names 2.0]}] \
         [expr {"focusDim" in [$w tag names 4.0]}]
} -result {1 0}

test focus-1.3 {toggling Focus mode off clears the dim} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "a\nb\nc\n"
    set ::els::focus_mode 1 ; els::set_focus_mode 0
    set on [llength [$w tag ranges focusDim]]
    set ::els::focus_mode 0 ; els::set_focus_mode 0
    list [expr {$on > 0}] [llength [$w tag ranges focusDim]]
} -result {1 0}

test focus-1.4 {a line-count change (structural edit) full-retags without stranding a dim} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "one\ntwo\nthree\n" ; update
    $w mark set insert 3.0 ; set ::els::focus_mode 1 ; els::set_focus_mode 0
    # insert a line ABOVE the caret: line numbers shift; a naive delta would strand
    $w insert 1.0 "zero\n" ; $w mark set insert 4.0 ; els::update_current_line
    # current line (now 4 = "three") must be UN-dimmed; line 1 dimmed
    list [expr {"focusDim" in [$w tag names 1.0]}] \
         [expr {"focusDim" in [$w tag names 4.0]}]
} -result {1 0}

test focus-1.5 {Focus mode persists through save/load config} -setup {els_reset} -body {
    set ::els::focus_mode 1 ; els::save_geometry
    set persisted [dict get [raw_read $::els::config_path] focus_mode]
    set ::els::focus_mode 0 ; els::load_geometry
    list $persisted $::els::focus_mode
} -result {1 1}

test focus-1.6 {an equal-line-count multi-line edit re-dims correctly (no stranded line)} -setup {els_reset} -body {
    set w [els::T]
    $w insert end "one\ntwo\nthree\nfour\n" ; update
    $w mark set insert 3.0 ; set ::els::focus_mode 1 ; els::set_focus_mode 0
    # swap lines 1-2 with equal-line-count text: the replace wipes their tags, and
    # the line count + caret line are UNCHANGED -- the old delta stranded lines 1-2
    $w replace 1.0 3.0 "two\none\n" ; els::update_current_line
    list [expr {"focusDim" in [$w tag names 1.0]}] \
         [expr {"focusDim" in [$w tag names 2.0]}] \
         [expr {"focusDim" in [$w tag names 3.0]}]
} -result {1 1 0}

test focus-1.7 {a buffer-replacing reopen keeps Focus mode active (same line count)} -setup {els_reset} -body {
    set p [els_tmpfile focus2.txt "alpha\nbeta\ngamma\n"]
    els::open $p ; set id $::els::active ; set w [els::W $id]
    $w mark set insert 2.0 ; set ::els::focus_mode 1 ; els::set_focus_mode 0
    els::reopen_with iso8859-1 0             ;# re-decodes the SAME bytes -> same line count
    # focus must still dim: non-current line 3 dimmed (the old delta left it un-dimmed)
    list [expr {[llength [$w tag ranges focusDim]] > 0}] \
         [expr {"focusDim" in [$w tag names 3.0]}]
} -result {1 1}

# ---- bug-hunt wave 2: view polish (G-View mat-2, mat-3) --------------------

test ws-3.1 {Show Whitespace OFF clears the tints on background tabs, not just the active one (G-View mat-2)} -setup {els_reset} -body {
    set ::els::show_ws 1
    set idA $::els::active
    [els::W $idA] insert end "x  y\tz" ; update       ;# doc A: double-space + tab
    els::ws_refresh                                    ;# tag A while it is active
    set aTagged [expr {[llength [[els::W $idA] tag ranges wsTab]] > 0}]
    set idB [els::new_doc] ; els::switch_to $idB       ;# B is now the active tab
    set ::els::show_ws 0 ; els::set_show_ws 0          ;# toggle OFF while B is active
    set aAfter [llength [[els::W $idA] tag ranges wsTab]]
    list $aTagged $aAfter
} -result {1 0}

test tipclamp-3.1 {tooltips clamp against the virtual desktop, not the primary monitor (G-View mat-3)} -body {
    # two 1920-wide monitors side by side -> virtual {0 0 3840 1080}.  A tip at
    # x=2500 (on the secondary) width 400 fits and must NOT be pulled back; one
    # overflowing the true right edge IS pulled in.
    lassign [els::tip_clamp 2500 100 400 30 0 0 3840 1080] rx1 ry1
    lassign [els::tip_clamp 3600 100 400 30 0 0 3840 1080] rx2 ry2
    list $rx1 [expr {$rx2 == 3840 - 400 - 4}]
} -result {2500 1}

test gutterscroll-3.1 {a gutter wheel notch scrolls the text by the SAME amount as the text's own binding (G-View mat-5)} -setup {els_reset} -body {
    set w [els::T]
    $w insert end [string repeat "line\n" 500] ; update
    $w yview moveto 0.5 ; update ; set y0 [lindex [$w yview] 0]
    els::wheel -120                                       ;# gutter path, one notch down
    update ; set viaGutter [lindex [$w yview] 0]
    $w yview moveto 0.5 ; update
    tk::MouseWheel $w y [tk::ScaleNum -120] -4.0 pixels    ;# the text's own class-binding path
    update ; set viaText [lindex [$w yview] 0]
    list [expr {$viaGutter != $y0}] [expr {abs($viaGutter - $viaText) < 1e-9}]
} -result {1 1}
